#!/usr/bin/env python3
"""A native emoji / glyph picker for the Caelestia desktop."""

from __future__ import annotations

import json
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk


APP_ID = "io.caelestia.EmojiPro"
STATE_DIR = Path.home() / ".local/state/caelestia-emoji-pro"
STATE_FILE = STATE_DIR / "state.json"
CSS_FILE = Path.home() / ".config/caelestia-emoji-pro/style.css"
MAX_VISIBLE = 360
MAX_RECENTS = 48
CELL = 54

CATEGORIES = [
    ("recents", "󰥔", "Récents"),
