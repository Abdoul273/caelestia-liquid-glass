#!/usr/bin/env python3
"""Dictée façon macOS pour Caelestia / Ano Shell (Super + Maj + D).

    caelestia-dictate                session pilotée par le shell (JSON lignes)
    caelestia-dictate --stdout-only  transcrit et émet done sans taper dans la fenêtre (pour Agent OS)
    caelestia-dictate --file a.wav   test : transcrit un fichier audio

Architecture hybride fiable (2026-11) :
  - Capture PipeWire 16 kHz mono (pw-record) avec détection vocale adaptative.
  - À chaque phrase (pause 0.9 s) et à la fin (Entrée / clic), transcrit le segment audio
    via l'API REST Gemini (gemini-2.5-flash -> gemini-3.5-flash-lite -> gemini-3.1-flash-lite
    -> gemini-flash-latest) : latence ~0.8-1.5 s, ponctuation française propre, zéro blocage
    du websocket Live.
  - À la fin (sauf --stdout-only), refocalise la fenêtre d'origine (compatible Hyprland Lua
    et Hyprland standard) puis tape le texte (wtype, repli wl-copy + Ctrl+V ydotool).
"""

import asyncio
import audioop
import base64
import io
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import wave
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/caelestia-dictate/config.json"
DEFAULTS = {
    "models": [
        "gemini-2.5-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-3.5-flash",
        "gemini-flash-latest",
    ],
    "language": "fr-FR",
    "mode": "SMART",
    "insert": "type",
    "api_key": "",
}
RATE = 16000
CHUNK_MS = 100
CHUNK = RATE * 2 * CHUNK_MS // 1000
END_SILENCE_MS = 950
MAX_TURN_MS = 20_000
PREROLL = 5


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    try:
        user = json.loads(CONFIG.read_text())
        if isinstance(user, dict):
            cfg.update(user)
    except (OSError, ValueError):
        pass
    if not cfg.get("api_key"):
        cfg["api_key"] = os.environ.get("GEMINI_API_KEY", "")
    if not cfg.get("api_key"):
        for p, k in (
            (HOME / ".config/caelestia-write/config.json", "api_key"),
            (HOME / "OUTILS/ANO-GPT/config/api_keys.json", "gemini_api_key"),
            (HOME / "OUTILS/ANO-GPT/config/api_keys.json", "gemini_live_api_key"),
        ):
            if p.is_file():
                try:
                    val = (json.loads(p.read_text()).get(k) or "").strip()
                    if val:
                        cfg["api_key"] = val
                        break
                except (OSError, ValueError):
                    pass
    return cfg


def emit(**msg) -> None:
    sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def active_window() -> str:
    try:
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2, check=False)
        return json.loads(out.stdout or "{}").get("address", "") or ""
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""


def tidy(text: str) -> str:
    text = " ".join(str(text or "").split())
    text = re.sub(r"^\s*\[(?:SILENCE|BRUIT|INAUDIBLE|VIDE)\]\s*$", "", text, flags=re.IGNORECASE)
    text = re.sub(r"\s+([,.])", r"\1", text)
    text = re.sub(r"\s*([?!:;])", "\u202f\\1", text)
    return text.strip()


def pcm_to_wav_bytes(pcm: bytes) -> bytes:
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm)
    return buf.getvalue()


def transcribe_pcm_sync(pcm: bytes, cfg: dict) -> tuple[str, str]:
    """Transcrit un buffer PCM 16kHz mono via Gemini REST multimodal (rapide et fiable)."""
    if not pcm or len(pcm) < RATE // 2:  # < 0.25 s
        return "", ""
    # Vérifier qu'il y a un minimum de signal audio
    if audioop.rms(pcm, 2) < 40:
        return "", ""
    api_key = cfg.get("api_key", "")
    if not api_key:
        return "", "Clé Gemini introuvable"

    wav_b64 = base64.b64encode(pcm_to_wav_bytes(pcm)).decode("ascii")
    lang = cfg.get("language", "fr-FR")
    style = (
        "Ajoute une ponctuation naturelle et corrige légèrement la mise en forme écrite."
        if cfg.get("mode", "SMART").upper() == "SMART"
        else "Transcris les mots exactement tels qu'ils sont prononcés."
    )
    instruction = (
        f"Transcris fidèlement la parole de cet enregistrement audio (langue principale : {lang}). "
        f"{style} "
        "Termes techniques fréquents : Abdoul, Codex, Claude, Copilot, OpenCode, Antigravity, AGY, "
        "Hyprland, Caelestia, Ano Shell, ANO-GPT, Kitty, Flutter, GitHub, Katana. "
        "Réponds UNIQUEMENT par le texte transcrit, sans commentaire, sans guillemets, sans préfixe. "
        "S'il n'y a aucune parole compréhensible (silence, souffle ou bruit seul), réponds uniquement : [SILENCE]."
    )
    payload = {
        "contents": [{
            "parts": [
                {"text": instruction},
                {"inlineData": {"mimeType": "audio/wav", "data": wav_b64}},
            ]
        }],
        "generationConfig": {"temperature": 0.0},
    }
    raw = json.dumps(payload).encode("utf-8")
    models = cfg.get("models") or DEFAULTS["models"]
    last_err = ""
    for m in models:
        m_clean = str(m).removeprefix("models/")
        if "transcribe-live" in m_clean:
            continue
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{m_clean}:generateContent?key={api_key}"
        req = urllib.request.Request(url, data=raw, headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            cands = data.get("candidates") or []
            if not cands:
                continue
            parts = (cands[0].get("content") or {}).get("parts") or []
            txt = "".join(p.get("text") or "" for p in parts if isinstance(p, dict))
            cleaned = tidy(txt)
            return cleaned, ""
        except (urllib.error.URLError, ValueError, KeyError, TimeoutError) as exc:
            last_err = str(exc)[:140]
    return "", last_err or "API Gemini indisponible"


def focus_window(window: str) -> None:
    if not window:
        return
    addr = window if window.startswith("0x") else f"0x{window}"
    # Hyprland Lua (caelestia) ou Hyprland standard
    r = subprocess.run(
        ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
        capture_output=True, text=True, timeout=2, check=False,
    )
    if r.returncode != 0 or "invalid" in (r.stdout + r.stderr).lower():
        subprocess.run(
            ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
            capture_output=True, timeout=2, check=False,
        )


def insert(text: str, window: str, how: str) -> None:
    time.sleep(0.22)  # laisser la goutte rendre le focus clavier
    focus_window(window)
    time.sleep(0.12)
    if (
        how == "type"
        and shutil.which("wtype")
        and subprocess.run(["wtype", "-d", "3", "--", text], capture_output=True, check=False).returncode == 0
    ):
        return
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", "--", text], check=False)
        time.sleep(0.08)
    if shutil.which("ydotool"):
        subprocess.run(["ydotool", "key", "29:1", "47:1", "47:0", "29:0"], capture_output=True, check=False)


class Dictation:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.parts: list[str] = []
        self.pending_tasks: list[asyncio.Task] = []
        self.had_speech = False
        self.last_error = ""

    def full_text(self) -> str:
        return tidy(" ".join(p for p in self.parts if p))

    async def _transcribe_segment(self, pcm: bytes, slot: int) -> None:
        txt, err = await asyncio.to_thread(transcribe_pcm_sync, pcm, self.cfg)
        if err and not txt:
            self.last_error = err
            return
        if txt:
            self.parts[slot] = txt
            emit(stage="text", text=self.full_text())

    def schedule_segment(self, pcm: bytes) -> None:
        if len(pcm) < RATE // 2:
            return
        slot = len(self.parts)
        self.parts.append("")
        task = asyncio.create_task(self._transcribe_segment(pcm, slot))
        self.pending_tasks.append(task)

    async def run(self, chunks, commands) -> str | None:
        if not self.cfg.get("api_key"):
            emit(stage="state", state="erreur", detail="Clé Gemini introuvable")
            return None

        emit(stage="state", state="ecoute")
        audio_q: asyncio.Queue = asyncio.Queue()

        async def pump():
            async for c in chunks:
                await audio_q.put(c)
            await audio_q.put(None)

        pump_task = asyncio.create_task(pump())
        noise = 0.003
        loud_run = 0
        silence = 0
        in_turn = False
        preroll: list[bytes] = []
        turn_buf = bytearray()
        all_buf = bytearray()
        cancelled = False

        try:
            while True:
                if commands.done():
                    break
                get = asyncio.create_task(audio_q.get())
                await asyncio.wait({get, commands}, return_when=asyncio.FIRST_COMPLETED)
                if not get.done():
                    get.cancel()
                    break
                pcm = get.result()
                if pcm is None:
                    break
                if len(all_buf) < RATE * 2 * 45:  # plafond 45 s de sécurité
                    all_buf.extend(pcm)
                rms = audioop.rms(pcm, 2) / 32768.0
                emit(stage="level", v=round(min(1.0, rms * 14.0), 3))
                # Seuil sensible et adaptatif (capte même un micro portable calme)
                loud = rms > max(0.0045, noise * 2.1)
                if not in_turn:
                    if not loud:
                        noise = noise * 0.94 + rms * 0.06
                    preroll = (preroll + [pcm])[-PREROLL:]
                    loud_run = loud_run + 1 if loud else 0
                    if loud_run >= 2:
                        in_turn = True
                        self.had_speech = True
                        turn_buf = bytearray(b"".join(preroll))
                        preroll = []
                        silence = 0
                        emit(stage="state", state="parole")
                    continue

                turn_buf.extend(pcm)
                silence = 0 if loud else silence + CHUNK_MS
                if silence >= END_SILENCE_MS or len(turn_buf) >= RATE * 2 * (MAX_TURN_MS // 1000):
                    self.schedule_segment(bytes(turn_buf))
                    turn_buf = bytearray()
                    in_turn = False
                    loud_run = 0
                    silence = 0
                    emit(stage="state", state="ecoute")

            cmd = commands.result() if commands.done() else "stop"
            cancelled = cmd == "cancel"
            if not cancelled:
                emit(stage="state", state="fin")
                if len(turn_buf) >= RATE // 2:
                    self.schedule_segment(bytes(turn_buf))
                if self.pending_tasks:
                    await asyncio.gather(*self.pending_tasks, return_exceptions=True)
                # Filet de sécurité : si le VAD n'a pas déclenché mais de l'audio a été capté, on transcrit tout
                if not self.full_text() and len(all_buf) >= RATE:
                    txt, err = await asyncio.to_thread(transcribe_pcm_sync, bytes(all_buf), self.cfg)
                    if txt:
                        self.parts = [txt]
                        emit(stage="text", text=self.full_text())
                    elif err:
                        self.last_error = err
                if not self.full_text() and self.last_error:
                    emit(stage="state", state="erreur", detail=self.last_error)
        finally:
            pump_task.cancel()
        return None if cancelled else self.full_text()


async def mic_chunks(proc):
    while True:
        data = await proc.stdout.readexactly(CHUNK) if proc.stdout else b""
        if not data:
            return
        yield data


async def file_chunks(path: str):
    with wave.open(path) as w:
        pcm = w.readframes(w.getnframes())
        if w.getframerate() != RATE or w.getnchannels() != 1:
            pcm, _ = audioop.ratecv(
                audioop.tomono(pcm, 2, 0.5, 0.5) if w.getnchannels() == 2 else pcm,
                2, 1, w.getframerate(), RATE, None,
            )
    pcm += b"\0" * (RATE * 2)
    for i in range(0, len(pcm) - CHUNK + 1, CHUNK):
        yield pcm[i : i + CHUNK]
        await asyncio.sleep(0.01)


async def stdin_commands() -> str:
    loop = asyncio.get_running_loop()
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    while True:
        line = await reader.readline()
        if not line:
            return "stop"
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("cancel"):
            return "cancel"
        if msg.get("stop"):
            return "stop"


async def main() -> int:
    cfg = load_config()
    dict_ = Dictation(cfg)
    args = sys.argv[1:]
    stdout_only = "--stdout-only" in args
    if "--file" in args:
        idx = args.index("--file")
        if idx + 1 >= len(args):
            return 2
        never = asyncio.get_running_loop().create_future()
        text = await dict_.run(file_chunks(args[idx + 1]), never)
        print("RÉSULTAT :", text or "")
        return 0

    window = "" if stdout_only else active_window()
    rec = await asyncio.create_subprocess_exec(
        "pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16",
        "--latency", f"{CHUNK_MS}ms", "--media-role", "Communication", "-",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
    )

    async def chunks():
        try:
            async for c in mic_chunks(rec):
                yield c
        except asyncio.IncompleteReadError:
            return

    commands = asyncio.create_task(stdin_commands())
    try:
        text = await dict_.run(chunks(), commands)
    finally:
        if rec.returncode is None:
            rec.terminate()
    emit(stage="done", text=text or "")
    if text and not stdout_only:
        insert(text, window, cfg["insert"])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(asyncio.run(main()))
    except KeyboardInterrupt:
        sys.exit(130)
