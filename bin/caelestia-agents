            "description": "Déploie plusieurs agents IA en escouade sur un même projet.",
            "parameters": {
                "type": "OBJECT",
                "properties": {
                    "kinds": {"type": "ARRAY", "items": {"type": "STRING"}, "description": "Liste de moteurs (ex. ['claude', 'codex'])"},
                    "cwd": {"type": "STRING"},
                    "prompt": {"type": "STRING"},
                },
                "required": ["kinds"],
            },
        },
        {
            "name": "agent_permission",
            "description": "Autorise ou refuse une demande de permission en attente d'un agent IA.",
            "parameters": {
                "type": "OBJECT",
                "properties": {
                    "perm_id": {"type": "STRING"},
                    "decision": {"type": "STRING", "enum": ["allow", "deny"]},
                },
                "required": ["perm_id", "decision"],
            },
        },
        {
            "name": "agent_detail",
            "description": "Lit l'activité détaillée, les étapes récentes et le statut git d'un agent IA.",
            "parameters": {
                "type": "OBJECT",
                "properties": {"agent_id": {"type": "STRING"}},
                "required": ["agent_id"],
            },
        },
        {
            "name": "memory_save",
            "description": "Enregistre un fait durable dans la mémoire long terme partagée avec ANO-GPT.",
            "parameters": {
                "type": "OBJECT",
                "properties": {
                    "category": {"type": "STRING", "enum": ["identity", "preferences", "projects", "relationships", "wishes", "notes"]},
                    "key": {"type": "STRING"},
                    "value": {"type": "STRING"},
                },
