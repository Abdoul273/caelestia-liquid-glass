_ORDINAL_WS = {
    "un": "1", "premier": "1", "premiere": "1", "1er": "1",
    "deux": "2", "deuxieme": "2", "second": "2", "seconde": "2", "2e": "2", "2eme": "2",
    "trois": "3", "troisieme": "3", "3e": "3", "3eme": "3",
    "quatre": "4", "quatrieme": "4", "4e": "4", "4eme": "4",
    "cinq": "5", "cinquieme": "5", "5e": "5", "5eme": "5",
    "six": "6", "sixieme": "6", "6e": "6", "6eme": "6",
    "sept": "7", "septieme": "7", "huit": "8", "huitieme": "8",
    "neuf": "9", "neuvieme": "9", "dix": "10", "dixieme": "10",
    "suivant": "+1", "droite": "+1", "next": "+1",
    "precedent": "-1", "gauche": "-1", "prev": "-1",
    "dernier": "previous", "retour": "previous", "vide": "empty",
}

_FAIL_PATTERNS = (
    "erreur ", "erreur:", "échec", "echec", "aucune fenêtre ne correspond",
    "aucune fenetre ne correspond", "introuvable", "invalide", "impossible de ",
    "non confirmé", "non confirme", "indisponible", "non supporté", "non supporte",
    "refusé", "refuse", "manquant", "aucune action d'orchestration", "outil ano-gpt inconnu",
    "relais téléphone", "commande bloquée",
)

_DANGEROUS_SHELL_RE = re.compile(
    r"(rm\s+-[a-zA-Z]*r[a-zA-Z]*f?\s+/(\s|$|\*)|mkfs\.|dd\s+if=.*of=/dev/|:\(\)\s*\{|chmod\s+-R\s+777\s+/|>\s*/dev/sd[a-z])"
)


def _fold_text(text):
    import unicodedata

    raw = unicodedata.normalize("NFKD", str(text or "").casefold())
    return "".join(c for c in raw if not unicodedata.combining(c))


def _looks_like_failure(text):
    low = _fold_text(text)
    if not low:
        return False
    if "0 erreur" in low or "sans erreur" in low:
        return False
    return any(_fold_text(p) in low for p in _FAIL_PATTERNS)


def _hypr_env():
    env = dict(os.environ)
    rd = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["XDG_RUNTIME_DIR"] = rd
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        hdir = Path(rd) / "hypr"
        if hdir.is_dir():
            insts = sorted((d for d in hdir.iterdir() if d.is_dir()), key=lambda d: d.stat().st_mtime, reverse=True)
            if insts:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = insts[0].name
    return env


def _hypr_json(cmd):
    try:
        r = subprocess.run(["hyprctl", "-j", *cmd.split()], capture_output=True, text=True, timeout=2, check=False, env=_hypr_env())
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return None


def _hypr_dispatch(lua_cmd="", legacy_cmd=""):
    env = _hypr_env()
    for payload in (lua_cmd, legacy_cmd):
        if not payload:
            continue
        try:
            r = subprocess.run(["hyprctl", "dispatch", payload], capture_output=True, text=True, timeout=2.5, check=False, env=env)
            out = (r.stdout + " " + r.stderr).strip().lower()
            if r.returncode == 0 and "unknown" not in out and "invalid" not in out and "error" not in out:
                return True, (r.stdout.strip() or "ok")
        except (OSError, subprocess.TimeoutExpired):
            continue
    return False, "Échec hyprctl dispatch"


def _norm_ws(ws):
    raw = _fold_text(ws).replace("bureau", "").replace("workspace", "").replace("ws", "").strip()
    if raw in _ORDINAL_WS:
        return _ORDINAL_WS[raw]
    m = re.search(r"([+-]?\d+)", raw)
    if m:
        return m.group(1)
    if raw in ("previous", "empty", "special"):
        return raw
    return raw


def tool_hypr_workspace(action="switch", workspace=""):
    """Navigation et inspection natives des bureaux Hyprland (Lua >= 0.55 + repli legacy + vérification réelle)."""
    act = _fold_text(action or "switch")
    if act in ("list", "status", "info", "current"):
        active = _hypr_json("activeworkspace") or {}
        wss = _hypr_json("workspaces") or []
        lines = [f"Bureau actif : {active.get('id', '?')} ({active.get('windows', 0)} fenêtre(s))"]
        for w in sorted(wss, key=lambda x: x.get("id", 0)):
            lines.append(f"• Bureau {w.get('id')} ({w.get('name', w.get('id'))}) : {w.get('windows', 0)} fenêtre(s)")
        return True, "\n".join(lines)

    ws = _norm_ws(workspace)
    if not ws:
        return False, "Numéro ou nom de bureau manquant."

    if ws == "special" or ws.startswith("special:"):
        name = ws.split(":", 1)[1] if ":" in ws else ""
        lua = f'hl.dsp.toggle_special_workspace({{ name = "{name}" }})' if name else "hl.dsp.toggle_special_workspace()"
        ok, msg = _hypr_dispatch(lua, f"togglespecialworkspace {name}".strip())
        return ok, f"Bureau spécial basculé ({msg})." if ok else f"Échec bureau spécial ({msg})."

    ok, msg = _hypr_dispatch(f'hl.dsp.focus({{ workspace = "{ws}" }})', f"workspace {ws}")
    if not ok:
        return False, f"Impossible de passer au bureau {ws} ({msg})."

    time.sleep(0.08)
    cur = _hypr_json("activeworkspace") or {}
    cur_id = cur.get("id")
    if ws.isdigit() and cur_id is not None and str(cur_id) != ws:
        # Second essai syntaxe legacy directe
        _hypr_dispatch("", f"workspace {ws}")
        time.sleep(0.08)
        cur = _hypr_json("activeworkspace") or {}
        cur_id = cur.get("id")
        if str(cur_id) != ws:
            return False, f"Changement vers le bureau {ws} non confirmé (bureau actif : {cur_id})."
    return True, f"Bureau actif confirmé : {cur_id if cur_id is not None else ws}."


def _find_hypr_window(target):
    clients = _hypr_json("clients") or []
    q = (target or "").strip().lower()
    if not q or q in ("active", "actuelle", "courante", "cette fenetre", "cette fenêtre", "fenetre", "fenêtre"):
        act = _hypr_json("activewindow") or {}
        if act.get("address"):
            return act
        return clients[0] if clients else None
    if q.startswith("0x") or q.startswith("address:"):
        addr = q.replace("address:", "")
        return next((c for c in clients if (c.get("address") or "").lower() == addr), None)
    for c in clients:
        if q in (c.get("class") or "").lower() or q in (c.get("initialClass") or "").lower():
            return c
    for c in clients:
        if q in (c.get("title") or "").lower() or q in (c.get("initialTitle") or "").lower():
            return c
    return None


def tool_hypr_windows(action="list", target="", workspace="", follow=False):
    """Gestion native complète des fenêtres Hyprland (list, focus, move_to_workspace, close, fullscreen, toggle_floating, organize)."""
    act = _fold_text(action or "list")
    if act in ("list", "status"):
        clients = _hypr_json("clients") or []
        if not clients:
            return True, "Aucune fenêtre ouverte sous Hyprland."
        lines = [
            f"• [{c.get('address')}] {c.get('class', '?')} — « {clip(c.get('title') or '', 45)} » (bureau {(c.get('workspace') or {}).get('id', '?')})"
            for c in clients
        ]
        return True, "\n".join(lines[:30])

    if act in ("organize", "reorganize", "range"):
        return call_ano_action("hypr_orchestrator", {"action": "organize"})

    win = _find_hypr_window(target)
    if not win or not win.get("address"):
        return False, f"Aucune fenêtre ne correspond à « {target or 'active'} »."
    addr = win["address"]
    sel = f"address:{addr}"
    label = f"{win.get('class', '?')} ({clip(win.get('title') or '', 32)})"

    if act in ("focus", "switch", "show"):
        ok, _ = _hypr_dispatch(f'hl.dsp.focus({{ window = "{sel}" }})', f"focuswindow {sel}")
        return ok, f"Focus sur {label}." if ok else f"Impossible de mettre le focus sur {label}."

    if act in ("move", "move_to_workspace", "send"):
        ws = _norm_ws(workspace)
        if not ws:
            return False, "Numéro de bureau cible manquant pour déplacer la fenêtre."
        fl = "true" if follow else "false"
        leg = f"movetoworkspace {ws},{sel}" if follow else f"movetoworkspacesilent {ws},{sel}"
        ok, _ = _hypr_dispatch(f'hl.dsp.window.move({{ workspace = "{ws}", window = "{sel}", follow = {fl} }})', leg)
        if not ok:
            return False, f"Échec du déplacement de {label} vers le bureau {ws}."
        time.sleep(0.1)
        fresh = next((c for c in (_hypr_json("clients") or []) if c.get("address") == addr), None)
        new_ws = (fresh or {}).get("workspace", {}).get("id")
        if ws.isdigit() and str(new_ws) != ws:
            return False, f"Déplacement non confirmé ({label} est toujours sur le bureau {new_ws})."
        return True, f"{label} déplacée sur le bureau {new_ws or ws}."

    if act in ("close", "kill"):
        ok, _ = _hypr_dispatch(f'hl.dsp.window.kill({{ window = "{sel}" }})', f"closewindow {sel}")
        return ok, f"Fenêtre {label} fermée." if ok else f"Impossible de fermer {label}."

    if act in ("fullscreen", "maximize"):
        _hypr_dispatch(f'hl.dsp.focus({{ window = "{sel}" }})', f"focuswindow {sel}")
        ok, _ = _hypr_dispatch('hl.dsp.window.fullscreen({ mode = 0 })', "fullscreen 0")
        return ok, f"Plein écran basculé sur {label}." if ok else f"Échec plein écran sur {label}."

    if act in ("float", "floating", "toggle_floating"):
        ok, _ = _hypr_dispatch(f'hl.dsp.window.toggle_floating({{ window = "{sel}" }})', f"togglefloating {sel}")
        return ok, f"Mode flottant basculé sur {label}." if ok else f"Échec mode flottant sur {label}."

    return False, f"Action fenêtre inconnue : {action}"


def tool_shell_control(action="", value="", extra=""):
    """Pilote directement le shell Caelestia / Ano Shell (IPC Quickshell, verre, thème, concentration, minuteur…)."""
    act = _fold_text(action)
    val = str(value or "").strip()
    ext = str(extra or "").strip()

    def _qs(*args):
        try:
            r = subprocess.run(["qs", "-c", SHELL_NAME, "ipc", "call", *args], capture_output=True, text=True, timeout=4, check=False)
            out = (r.stdout + " " + r.stderr).strip()
            return r.returncode == 0, out or "OK"
        except (OSError, subprocess.TimeoutExpired) as exc:
            return False, str(exc)[:140]

    def _global(name):
        return _hypr_dispatch(f'hl.dsp.global("{SHELL_NAME}:{name}")', f"global {SHELL_NAME}:{name}")

    if act == "lock":
        ok, out = _qs("lock", "lock")
        return ok, "Écran verrouillé." if ok else f"Échec verrouillage : {out}"
    if act in ("control_center", "cc"):
        ok, _ = _global("controlCenter")
        return ok, "Centre de contrôle basculé." if ok else "Échec ouverture Centre de contrôle."
    if act in ("settings", "nexus", "parametres"):
        ok, out = _qs("nexus", "open")
        if not ok:
            ok, out = _global("nexus")
        return ok, "Paramètres ouverts." if ok else f"Échec Paramètres : {out}"
    if act in ("mission_control", "missioncontrol"):
        ok, out = _qs("missioncontrol", "toggle")
        return ok, "Mission Control basculé." if ok else f"Échec Mission Control : {out}"
    if act in ("spotlight", "launcher"):
        ok, _ = _global("spotlight")
        return ok, "Spotlight basculé." if ok else "Échec Spotlight."
    if act in ("clock", "horloge"):
        ok, _ = _global("clock")
        return ok, "Horloge basculée." if ok else "Échec Horloge."
    if act in ("earbuds", "ecouteurs"):
        ok, _ = _global("earbuds")
        return ok, "Panneau Écouteurs 3D basculé." if ok else "Échec Écouteurs 3D."
    if act in ("notes", "quicknotes"):
        ok, _ = _global("quicknotes")
        return ok, "Notes rapides basculées." if ok else "Échec Notes rapides."
    if act in ("tasks", "quicktasks", "taches"):
        ok, _ = _global("quicktasks")
        return ok, "Tâches rapides basculées." if ok else "Échec Tâches rapides."
    if act in ("close_agentos", "agentos_close"):
        ok, out = _qs("agentos", "close")
        return ok, "Fenêtre Agent OS fermée." if ok else f"Échec fermeture Agent OS : {out}"
    if act in ("screenshot", "capture"):
        ok, _ = _global("screenshot")
        return ok, "Outil de capture lancé." if ok else "Échec capture."
    if act in ("timer", "minuteur"):
        sub = _fold_text(val)
        if sub in ("stop", "cancel", "arrete", "annule"):
            ok, out = _qs("island", "stopAll")
            return ok, "Minuteur arrêté." if ok else f"Échec arrêt minuteur : {out}"
        if sub in ("pause", "resume", "reprendre"):
            ok, out = _qs("island", "pause")
            return ok, "Minuteur mis en pause/repris." if ok else f"Échec pause minuteur : {out}"
        m = re.search(r"(\d+)", val)
        secs = int(m.group(1)) * (1 if "sec" in sub or sub.endswith("s") else 60) if m else 300
        label = ext or "Minuteur"
        ok, out = _qs("island", "timer", str(secs), label)
        return ok, f"Minuteur « {label} » lancé ({secs} s)." if ok else f"Échec minuteur : {out}"
    if act in ("focus_mode", "focus", "dnd", "concentration"):
        sub = _fold_text(val) or "toggle"
        if sub in ("stop", "off", "desactive"):
            ok, out = _qs("focus", "stop")
        elif sub in ("dnd", "work", "sleep"):
            mins = ext if ext.isdigit() else "60"
            ok, out = _qs("focus", "start", sub, mins)
        else:
            ok, out = _qs("focus", "toggle")
        return ok, f"Mode concentration mis à jour ({out})." if ok else f"Échec mode concentration : {out}"
    if act in ("glass", "liquid_glass", "verre"):
        gfile = SHELL_CFG_DIR / "glass.json"
        try:
            cfg = json.loads(gfile.read_text(encoding="utf-8")) if gfile.is_file() else {}
        except (OSError, ValueError):
            cfg = {}
        key = _fold_text(val)
        if key in ("shell", "style") and ext in ("ios", "classic", "off"):
            cfg["shell"] = ext
        elif key in ("performance", "perf", "profil") and ext in ("ultra", "eco", "auto"):
            cfg["performance"] = ext
        elif key == "gtk" and ext in ("nautilus", "complet", "off"):
            cfg["gtk"] = ext
        elif key in ("density", "densite", "intensite"):
            try:
                cfg["density"] = max(0.0, min(1.0, float(ext.replace(",", "."))))
            except ValueError:
                return False, f"Densité invalide : {ext}"
        elif key in ("ios", "classic", "off"):
            cfg["shell"] = key
        elif key in ("ultra", "eco", "auto"):
            cfg["performance"] = key
        else:
            return False, f"Réglage verre non reconnu ({val} / {ext}). Utilise shell|performance|gtk|density."
        try:
            gfile.parent.mkdir(parents=True, exist_ok=True)
            gfile.write_text(json.dumps(cfg, indent=4, ensure_ascii=False) + "\n", encoding="utf-8")
            return True, f"Liquid Glass mis à jour ({json.dumps(cfg, ensure_ascii=False)})."
        except OSError as exc:
            return False, str(exc)[:140]
    if act in ("theme", "mode"):
        mode = "light" if _fold_text(val) in ("light", "clair", "jour") else "dark"
        cli = "ano-shell" if SHELL_NAME == "ano-shell" else "caelestia"
        try:
            r = subprocess.run([cli, "scheme", "set", "-m", mode], capture_output=True, text=True, timeout=6, check=False)
            return r.returncode == 0, f"Thème {mode} appliqué." if r.returncode == 0 else clip(r.stderr or r.stdout, 140)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return False, str(exc)[:140]
    if act in ("wallpaper", "fond"):
        cli = "ano-shell" if SHELL_NAME == "ano-shell" else "caelestia"
        args = [cli, "wallpaper", "-r"] if not val or _fold_text(val) in ("random", "aleatoire", "suivant") else [cli, "wallpaper", "-f", val]
        try:
            r = subprocess.run(args, capture_output=True, text=True, timeout=8, check=False)
            return r.returncode == 0, "Fond d'écran changé." if r.returncode == 0 else clip(r.stderr or r.stdout, 140)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return False, str(exc)[:140]
    return False, f"Action shell inconnue : {action}"


def tool_run_shell(command, cwd="", timeout=15):
    """Exécute une commande shell sûre sur le PC et retourne la sortie réelle (code de retour + stdout/stderr)."""
    cmd = str(command or "").strip()
    if not cmd:
        return False, "Commande vide."
    if _DANGEROUS_SHELL_RE.search(cmd):
        return False, "Commande bloquée par sécurité (destructive sur le système)."
    work = str(cwd or "") if (cwd and os.path.isdir(str(cwd))) else str(HOME)
    t = max(2, min(30, int(timeout or 15)))
    try:
        r = subprocess.run(["bash", "-lc", cmd], cwd=work, capture_output=True, text=True, timeout=t, check=False, env=_hypr_env())
        out = (r.stdout or "").strip()
        err = (r.stderr or "").strip()
        combined = out if out else err
        if out and err and r.returncode != 0:
            combined = f"{out}\n[stderr] {err}"
        if r.returncode == 0:
            return True, clip(combined or "Commande exécutée (code 0).", 900)
        return False, clip(f"Code {r.returncode}: {combined or 'échec'}", 600)
    except subprocess.TimeoutExpired:
        return False, f"Commande interrompue après {t}s."
    except OSError as exc:
        return False, str(exc)[:180]


def tool_system_control(action="state", value=""):
    """Contrôle système autonome (fonctionne même sans ANO-GPT : volume, luminosité, Wi-Fi, Bluetooth, média, apps, météo, état)."""
    act = _fold_text(action or "state")
    val = str(value or "").strip()

    if act in ("state", "status", "info"):
        parts = []
        try:
            r = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=2, check=False)
            if r.returncode == 0 and r.stdout.strip():
                parts.append(f"Audio: {r.stdout.strip()}")
        except OSError:
            pass
        try:
            r = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True, timeout=2, check=False)
            if r.returncode == 0 and r.stdout.strip():
                cols = r.stdout.strip().splitlines()[0].split(",")
                if len(cols) >= 4:
                    parts.append(f"Luminosité: {cols[3]}")
        except OSError:
            pass
        try:
            r = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show", "--active"], capture_output=True, text=True, timeout=2, check=False)
            if r.returncode == 0 and r.stdout.strip():
                parts.append("Réseau: " + ", ".join(r.stdout.strip().splitlines()[:3]))
        except OSError:
            pass
        try:
            r = subprocess.run(["bluetoothctl", "show"], capture_output=True, text=True, timeout=2, check=False)
            m = re.search(r"Powered:\s*(\w+)", r.stdout or "")
            if m:
                parts.append(f"Bluetooth: {m.group(1)}")
        except OSError:
            pass
        for bat in sorted(Path("/sys/class/power_supply").glob("BAT*")):
            try:
                cap = (bat / "capacity").read_text().strip()
                st = (bat / "status").read_text().strip()
                parts.append(f"Batterie: {cap}% ({st})")
                break
            except OSError:
                pass
        try:
            r = subprocess.run(["playerctl", "metadata", "--format", "{{status}} — {{artist}} - {{title}}"], capture_output=True, text=True, timeout=2, check=False)
            if r.returncode == 0 and r.stdout.strip():
                parts.append(f"Média: {clip(r.stdout.strip(), 80)}")
        except OSError:
            pass
        return True, " | ".join(parts) if parts else "État système indisponible."

    if act == "volume":
        v = _fold_text(val)
        if v in ("mute", "couper", "muet"):
            cmd = ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"]
        elif v in ("unmute", "retablir"):
            cmd = ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"]
        elif v == "toggle":
            cmd = ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]
        else:
            m = re.match(r"^([+-])?(\d+)\s*%?$", v)
            if not m:
                return False, f"Valeur de volume invalide : {val}"
            sign, num = m.group(1), m.group(2)
            arg = f"{num}%{sign}" if sign else f"{num}%"
            cmd = ["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", arg]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=2, check=False)
            cur = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=2, check=False)
            return r.returncode == 0, f"Volume réglé ({cur.stdout.strip()})." if r.returncode == 0 else clip(r.stderr, 140)
        except OSError as exc:
            return False, str(exc)[:140]

    if act in ("brightness", "luminosite"):
        v = _fold_text(val)
        m = re.match(r"^([+-])?(\d+)\s*%?$", v)
        if not m:
            return False, f"Valeur de luminosité invalide : {val}"
        sign, num = m.group(1), m.group(2)
        arg = f"{num}%{sign}" if sign else f"{num}%"
        try:
            r = subprocess.run(["brightnessctl", "set", arg], capture_output=True, text=True, timeout=2, check=False)
            return r.returncode == 0, f"Luminosité réglée ({arg})." if r.returncode == 0 else clip(r.stderr, 140)
        except OSError as exc:
            return False, str(exc)[:140]

    if act == "wifi":
        v = _fold_text(val)
        if v in ("on", "off"):
            r = subprocess.run(["nmcli", "radio", "wifi", v], capture_output=True, text=True, timeout=4, check=False)
            return r.returncode == 0, f"Wi-Fi {'activé' if v == 'on' else 'désactivé'}." if r.returncode == 0 else clip(r.stderr, 140)
        r = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True, timeout=2, check=False)
        return r.returncode == 0, f"Wi-Fi : {r.stdout.strip()}"

    if act == "bluetooth":
        v = _fold_text(val)
        if v in ("on", "off"):
            r = subprocess.run(["bluetoothctl", "power", v], capture_output=True, text=True, timeout=4, check=False)
            return r.returncode == 0, f"Bluetooth {'activé' if v == 'on' else 'désactivé'}." if r.returncode == 0 else clip(r.stderr, 140)
        r = subprocess.run(["bluetoothctl", "show"], capture_output=True, text=True, timeout=2, check=False)
        m = re.search(r"Powered:\s*(\w+)", r.stdout or "")
        return True, f"Bluetooth : {m.group(1) if m else 'inconnu'}"

    if act == "media":
        sub = _fold_text(val) or "play-pause"
        mapping = {"play": "play", "pause": "pause", "play-pause": "play-pause", "toggle": "play-pause", "next": "next", "suivant": "next", "previous": "previous", "prev": "previous", "precedent": "previous", "stop": "stop"}
        cmd_arg = mapping.get(sub)
        if not cmd_arg:
            r = subprocess.run(["playerctl", "metadata", "--format", "{{status}} — {{artist}} - {{title}}"], capture_output=True, text=True, timeout=2, check=False)
            return r.returncode == 0, r.stdout.strip() or "Aucun lecteur actif."
        r = subprocess.run(["playerctl", cmd_arg], capture_output=True, text=True, timeout=2, check=False)
        return r.returncode == 0, f"Média : {cmd_arg}." if r.returncode == 0 else "Aucun lecteur média actif."

    if act == "open_app":
        if not val:
            return False, "Nom d'application ou URL manquant."
        try:
            if val.startswith(("http://", "https://")):
                subprocess.Popen(["setsid", "-f", "xdg-open", val], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=_hypr_env())
                return True, f"Ouverture de {val}."
            binary = shutil.which(val) or shutil.which(val.lower())
            if binary:
                subprocess.Popen(["setsid", "-f", binary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=_hypr_env())
                return True, f"Application {val} lancée."
            subprocess.Popen(["setsid", "-f", "gtk-launch", val], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=_hypr_env())
            return True, f"Lancement desktop {val} demandé."
        except OSError as exc:
            return False, str(exc)[:140]

    if act == "close_app":
        return tool_hypr_windows("close", target=val)

    if act == "weather":
        city = urllib.parse.quote(val) if val else ""
        try:
            req = urllib.request.Request(f"https://wttr.in/{city}?format=3&lang=fr", headers={"User-Agent": "curl/8.0"})
            with urllib.request.urlopen(req, timeout=4) as resp:
                return True, clip(resp.read().decode("utf-8", errors="ignore").strip(), 180)
        except Exception as exc:  # noqa: BLE001
            return False, f"Météo indisponible : {str(exc)[:100]}"

    if act == "notify":
        try:
            subprocess.Popen(["notify-send", "-a", "Katana AI", "Katana AI", val or "Notification"])
            return True, "Notification envoyée."
        except OSError as exc:
            return False, str(exc)[:120]

    return False, f"Action système inconnue : {action}"


def _memory_file():
    """Mémoire partagée ANO-GPT si présente, sinon mémoire autonome du shell."""
    lt = ANO_DIR / "memory/long_term.json"
    if lt.parent.is_dir():
        return lt
    return CHAT_HISTORY.parent / "agentos-memory.json"


def load_ano_long_term_summary():
    """Lit la mémoire long terme partagée d'ANO-GPT (ou locale autonome, ~1 ms)."""
    lt = _memory_file()
    if not lt.is_file():
        return ""
    try:
        data = json.loads(lt.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    lines = []
    for cat in ("identity", "preferences", "projects", "relationships", "wishes", "notes"):
        sec = data.get(cat)
        if not isinstance(sec, dict) or not sec:
            continue
        items = []
        for k, v in list(sec.items())[:12]:
            val = v.get("value") if isinstance(v, dict) else v
            if val:
                items.append(f"{k}: {clip(val, 140)}")
        if items:
            lines.append(f"[{cat}] " + " ; ".join(items))
    return "\n".join(lines)[:2400]


def ano_memory_save(key, value, category="notes"):
    """Écrit atomiquement dans la mémoire long terme partagée (ANO-GPT ou locale autonome)."""
    lt = _memory_file()
    try:
        lt.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        return False, str(exc)[:120]
    valid_cats = {"identity", "preferences", "projects", "relationships", "wishes", "notes"}
    cat = category if category in valid_cats else "notes"
    try:
        data = json.loads(lt.read_text(encoding="utf-8")) if lt.is_file() else {}
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    data.setdefault(cat, {})
    if not isinstance(data[cat], dict):
        data[cat] = {}
    data[cat][str(key).strip()[:80]] = {
        "value": str(value).strip()[:380],
        "updated": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
    }
    try:
        if lt.is_file():
            shutil.copy2(lt, lt.with_suffix(".json.bak"))
        tmp = lt.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        tmp.replace(lt)
        return True, f"Mémorisé [{cat}] {key}"
    except OSError as exc:
        return False, str(exc)[:120]


def ano_memory_search(query):
    """Recherche dans la mémoire long terme (ANO-GPT ou autonome) et memory.db (FTS5) si présente."""
    q = (query or "").strip()
    if not q:
        return load_ano_long_term_summary() or "Mémoire vide."
    hits = []
    lt = _memory_file()
    if lt.is_file():
        try:
            data = json.loads(lt.read_text(encoding="utf-8"))
            ql = q.lower()
            for cat, sec in data.items():
                if not isinstance(sec, dict):
                    continue
                for k, v in sec.items():
                    val = str(v.get("value") if isinstance(v, dict) else v)
                    if ql in k.lower() or ql in val.lower():
                        hits.append(f"[{cat}] {k}: {clip(val, 160)}")
        except (OSError, ValueError):
            pass
    mdb = ANO_DIR / "memory/memory.db"
    if mdb.is_file():
        try:
            con = sqlite3.connect(f"file:{mdb}?mode=ro", uri=True, timeout=0.5)
            cols = [c[0] for c in con.execute("SELECT * FROM memories LIMIT 0").description]
            text_col = next((c for c in ("content", "text", "summary", "value", "fact") if c in cols), None)
            if text_col:
                for (txt,) in con.execute(
                    f"SELECT {text_col} FROM memories WHERE {text_col} LIKE ? ORDER BY rowid DESC LIMIT 6",
                    (f"%{q}%",),
                ):
                    if txt:
                        hits.append(clip(txt, 180))
            con.close()
        except sqlite3.Error:
            pass
    return "\n".join(hits[:10]) if hits else f"Aucun souvenir trouvé pour « {q} »."


def _normalize_ano_params(tool_name, params):
    clean = {k: v for k, v in (params or {}).items() if not str(k).startswith("_") and v is not None}
    aliases = ANO_PARAM_ALIASES.get(tool_name)
    if aliases:
        for old_k, new_k in aliases.items():
            if old_k in clean and new_k not in clean:
                clean[new_k] = clean.pop(old_k)
    return clean


def call_ano_action(tool_name, params):
    """Exécute n'importe quelle action d'ANO-GPT (~/OUTILS/ANO-GPT/actions/*) en chargement paresseux."""
    import contextlib
    import importlib
    import inspect
    import io
    import warnings

    if not ANO_DIR.is_dir():
        return False, "Dépôt ANO-GPT introuvable"

    if str(ANO_DIR) not in sys.path:
        sys.path.insert(0, str(ANO_DIR))

    clean_params = _normalize_ano_params(tool_name, params)

    # Relais téléphone (ANO-Remote) si ANO-GPT tourne
    if tool_name in ANO_RELAYED:
        try:
            from core.tool_bridge import call_app

            res = call_app(tool_name, clean_params, timeout=45)
            txt = clip(str(res or ""), 500)
            return (not _looks_like_failure(txt)), (txt or "Commande téléphone envoyée.")
        except Exception as exc:  # noqa: BLE001
            return False, clip(f"Relais téléphone indisponible (ANO-GPT éteint ?) : {exc}", 220)

    if tool_name not in ANO_TOOLS:
        return False, f"Outil ANO-GPT inconnu : {tool_name}"

    mod_name, fn_name = ANO_TOOLS[tool_name]
    prev_cwd = os.getcwd()

    class _NoopUI:
        current_file = None

        def __call__(self, *a, **k):
            return None

        def __bool__(self):
            return False

        def __getattr__(self, _):
            return _NoopUI()

    buf = io.StringIO()
    try:
        os.chdir(ANO_DIR)
        warnings.filterwarnings("ignore")
        with contextlib.redirect_stdout(buf):
            mod = importlib.import_module(mod_name)
            fn = getattr(mod, fn_name)
            if tool_name == "system_status":
                res = fn()
            elif tool_name == "system_state":
                res = fn(str(clean_params.get("topic") or "all"))
            else:
                ui = _NoopUI()
                offer = {
                    "parameters": clean_params,
                    "player": ui,
                    "ui": ui,
                    "response": None,
                    "session_memory": {},
                    "speak": lambda *_: None,
                }
                sig = inspect.signature(fn)
                takes_all = any(p.kind == inspect.Parameter.VAR_KEYWORD for p in sig.parameters.values())
                if "parameters" in sig.parameters or takes_all:
                    kwargs = {k: v for k, v in offer.items() if takes_all or k in sig.parameters}
                else:
                    kwargs = {k: v for k, v in clean_params.items() if k in sig.parameters}
                res = fn(**kwargs)
        txt = str(res) if res not in (None, "") else (buf.getvalue().strip() or "Action exécutée.")
        txt = clip(txt, 750)
        return (not _looks_like_failure(txt)), txt
    except Exception as exc:  # noqa: BLE001 — ne jamais planter Agent OS
        return False, clip(f"Erreur {tool_name}: {exc}", 240)
    finally:
        try:
            os.chdir(prev_cwd)
        except OSError:
            pass


def _sanitize_schema(node, depth=0):
    """Nettoie un schéma JSON ANO-GPT pour l'API REST Gemini Function Calling (zéro HTTP 400)."""
    if not isinstance(node, dict) or depth > 5:
        return {"type": "STRING"}
    t = str(node.get("type") or "STRING").upper()
    if t not in ("OBJECT", "STRING", "INTEGER", "NUMBER", "BOOLEAN", "ARRAY"):
        t = "STRING"
    out = {"type": t}
    if node.get("description"):
        out["description"] = clip(node["description"], 180)
    if isinstance(node.get("enum"), list) and node["enum"] and t == "STRING":
        out["enum"] = [str(x) for x in node["enum"][:24]]
    if t == "ARRAY":
        out["items"] = _sanitize_schema(node.get("items") or {"type": "STRING"}, depth + 1)
    elif t == "OBJECT":
        props = node.get("properties")
        if isinstance(props, dict) and props:
            clean_props = {str(k): _sanitize_schema(v, depth + 1) for k, v in list(props.items())[:20]}
            out["properties"] = clean_props
            req = [str(r) for r in (node.get("required") or []) if str(r) in clean_props]
            if req:
                out["required"] = req
        else:
            # Gemini REST refuse un OBJECT sans properties
            out["type"] = "STRING"
    return out


def _load_ano_declarations_cache():
    """Charge les vrais schémas ANO-GPT depuis un cache JSON (~1 ms), reconstruit si tool_declarations.py change."""
    src = ANO_DIR / "core/tool_declarations.py"
    if not src.is_file():
        return {}
    mtime = int(src.stat().st_mtime)
    if SCHEMA_CACHE.is_file():
        try:
            cached = json.loads(SCHEMA_CACHE.read_text(encoding="utf-8"))
            if isinstance(cached, dict) and cached.get("mtime") == mtime and isinstance(cached.get("decls"), dict):
                return cached["decls"]
        except (OSError, ValueError):
            pass

    if str(ANO_DIR) not in sys.path:
        sys.path.insert(0, str(ANO_DIR))
    try:
        from core.tool_declarations import TOOL_DECLARATIONS
    except Exception:  # noqa: BLE001
        return {}

    decls = {}
    supported = set(ANO_TOOLS) | set(ANO_RELAYED)
    for d in TOOL_DECLARATIONS:
        name = str(d.get("name") or "")
        if name not in supported:
            continue
        entry = {
            "name": name,
            "description": clip(d.get("description") or name, 320),
        }
        raw_params = d.get("parameters")
        if isinstance(raw_params, dict) and isinstance(raw_params.get("properties"), dict) and raw_params["properties"]:
            clean_p = _sanitize_schema(raw_params)
            if clean_p.get("type") == "OBJECT" and clean_p.get("properties"):
                entry["parameters"] = clean_p
        decls[name] = entry

    try:
        SCHEMA_CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = SCHEMA_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"mtime": mtime, "decls": decls}, ensure_ascii=False), encoding="utf-8")
        tmp.replace(SCHEMA_CACHE)
    except OSError:
        pass
    return decls


