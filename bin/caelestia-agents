    "capture_control": ("actions.capture", "capture_control"),
    "find_nearby": ("actions.find_nearby", "find_nearby"),
    "email_control": ("actions.email", "email_control"),
    "calendar_control": ("actions.calendar", "calendar_control"),
    "contacts_control": ("actions.contacts", "contacts_control"),
    "github_control": ("actions.github", "github_control"),
    "cloud_integrations_control": ("actions.cloud_integrations", "cloud_integrations_control"),
    "send_message": ("actions.send_message", "send_message"),
    "prayer_control": ("actions.prayer", "prayer_control"),
}


def load_ano_long_term_summary():
    """Lit la mémoire long terme partagée d'ANO-GPT (~1 ms, sans importer de gros modules)."""
    lt = ANO_DIR / "memory/long_term.json"
    if not lt.is_file():
        return ""
    try:
        data = json.loads(lt.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    lines = []
    for cat in ("identity", "preferences", "projects", "relationships", "wishes", "notes"):
        sec = data.get(cat)
        if not isinstance(sec, dict) or not sec:
            continue
        items = []
        for k, v in list(sec.items())[:12]:
            val = v.get("value") if isinstance(v, dict) else v
            if val:
                items.append(f"{k}: {clip(val, 140)}")
        if items:
            lines.append(f"[{cat}] " + " ; ".join(items))
    return "\n".join(lines)[:2400]


def ano_memory_save(key, value, category="notes"):
    """Écrit atomiquement dans la mémoire long terme d'ANO-GPT (memory/long_term.json)."""
    lt = ANO_DIR / "memory/long_term.json"
    if not lt.parent.is_dir():
        return False, "Dossier mémoire ANO-GPT introuvable"
    valid_cats = {"identity", "preferences", "projects", "relationships", "wishes", "notes"}
    cat = category if category in valid_cats else "notes"
    try:
        data = json.loads(lt.read_text(encoding="utf-8")) if lt.is_file() else {}
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    data.setdefault(cat, {})
    if not isinstance(data[cat], dict):
        data[cat] = {}
    data[cat][str(key).strip()[:80]] = {
        "value": str(value).strip()[:380],
        "updated": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
    }
    try:
        if lt.is_file():
            shutil.copy2(lt, lt.with_suffix(".json.bak"))
        tmp = lt.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        tmp.replace(lt)
        return True, f"Mémorisé dans ANO-GPT [{cat}] {key}"
    except OSError as exc:
        return False, str(exc)[:120]


def ano_memory_search(query):
    """Recherche dans la mémoire long terme et memory.db (FTS5) d'ANO-GPT."""
    q = (query or "").strip()
    if not q:
        return load_ano_long_term_summary() or "Mémoire vide."
    hits = []
    lt = ANO_DIR / "memory/long_term.json"
    if lt.is_file():
        try:
            data = json.loads(lt.read_text(encoding="utf-8"))
            ql = q.lower()
            for cat, sec in data.items():
                if not isinstance(sec, dict):
                    continue
                for k, v in sec.items():
                    val = str(v.get("value") if isinstance(v, dict) else v)
                    if ql in k.lower() or ql in val.lower():
                        hits.append(f"[{cat}] {k}: {clip(val, 160)}")
        except (OSError, ValueError):
            pass
    mdb = ANO_DIR / "memory/memory.db"
    if mdb.is_file():
        try:
            con = sqlite3.connect(f"file:{mdb}?mode=ro", uri=True, timeout=0.5)
            # Lecture robuste quelle que soit la colonne texte de memories
            cols = [c[0] for c in con.execute("SELECT * FROM memories LIMIT 0").description]
            text_col = next((c for c in ("content", "text", "summary", "value", "fact") if c in cols), None)
            if text_col:
                for (txt,) in con.execute(
                    f"SELECT {text_col} FROM memories WHERE {text_col} LIKE ? ORDER BY rowid DESC LIMIT 6",
                    (f"%{q}%",),
                ):
                    if txt:
                        hits.append(clip(txt, 180))
            con.close()
        except sqlite3.Error:
            pass
    return "\n".join(hits[:10]) if hits else f"Aucun souvenir trouvé pour « {q} »."


def call_ano_action(tool_name, params):
    """Exécute n'importe quelle action d'ANO-GPT (~/OUTILS/ANO-GPT/actions/*) en chargement paresseux."""
    import contextlib
    import importlib
    import inspect
    import io
    import warnings

    if tool_name not in ANO_TOOLS:
        return False, f"Outil ANO-GPT inconnu : {tool_name}"
    if not ANO_DIR.is_dir():
        return False, "Dépôt ANO-GPT introuvable"

    mod_name, fn_name = ANO_TOOLS[tool_name]
    prev_cwd = os.getcwd()
    if str(ANO_DIR) not in sys.path:
        sys.path.insert(0, str(ANO_DIR))

    class _NoopUI:
        current_file = None

        def __call__(self, *a, **k):
            return None

        def __bool__(self):
            return False

        def __getattr__(self, _):
            return _NoopUI()

    buf = io.StringIO()
    try:
        os.chdir(ANO_DIR)
        warnings.filterwarnings("ignore")
        with contextlib.redirect_stdout(buf):
            mod = importlib.import_module(mod_name)
            fn = getattr(mod, fn_name)
            clean_params = {k: v for k, v in (params or {}).items() if not str(k).startswith("_")}
            if tool_name == "system_status":
                res = fn()
            elif tool_name == "system_state":
                res = fn(str(clean_params.get("topic") or "all"))
            else:
                ui = _NoopUI()
                offer = {
                    "parameters": clean_params,
                    "player": ui,
                    "ui": ui,
                    "response": None,
                    "session_memory": {},
                    "speak": lambda *_: None,
                }
                sig = inspect.signature(fn)
                takes_all = any(p.kind == inspect.Parameter.VAR_KEYWORD for p in sig.parameters.values())
                kwargs = {k: v for k, v in offer.items() if takes_all or k in sig.parameters}
                if "parameters" not in sig.parameters and not takes_all:
                    kwargs = {}
                res = fn(**kwargs)
        txt = str(res) if res not in (None, "") else (buf.getvalue().strip() or "Action exécutée.")
        return True, clip(txt, 500)
    except Exception as exc:  # noqa: BLE001 — ne jamais planter Agent OS
        return False, clip(f"Erreur {tool_name}: {exc}", 240)
    finally:
        try:
            os.chdir(prev_cwd)
        except OSError:
            pass


def load_chat_history():
    try:
        arr = json.loads(CHAT_HISTORY.read_text(encoding="utf-8"))
        return arr if isinstance(arr, list) else []
    except (OSError, ValueError):
        return []


def save_chat_history(hist):
    try:
        CHAT_HISTORY.parent.mkdir(parents=True, exist_ok=True)
        tmp = CHAT_HISTORY.with_suffix(".tmp")
        tmp.write_text(json.dumps(hist[-24:], ensure_ascii=False, indent=2), encoding="utf-8")
        tmp.replace(CHAT_HISTORY)
    except OSError:
        pass


def clear_chat_history():
    CHAT_HISTORY.unlink(missing_ok=True)


def call_gemini_json(api_key, system_prompt, contents):
    models = ("gemini-2.5-flash", "gemini-3.5-flash-lite", "gemini-3.1-flash-lite", "gemini-flash-latest")
    payload = {
        "systemInstruction": {"parts": [{"text": system_prompt}]},
        "contents": contents,
        "generationConfig": {
            "temperature": 0.15,
            "responseMimeType": "application/json",
        },
    }
    raw_body = json.dumps(payload).encode("utf-8")
    last_err = "Gemini indisponible"
    for model in models:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        req = urllib.request.Request(url, data=raw_body, headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            txt = data["candidates"][0]["content"]["parts"][0]["text"]
            return json.loads(txt), None
        except (urllib.error.URLError, KeyError, IndexError, ValueError, TimeoutError) as exc:
            last_err = str(exc)[:180]
    return None, last_err


def commander(prompt, default_cwd=""):
    """Commandant IA (Katana AI) : mémoire partagée ANO-GPT, mémoire de conversation, pilotage agents + actions PC ANO-GPT."""
    prompt = (prompt or "").strip()
    if not prompt:
        return {"ok": False, "reply": "Écris une instruction pour le Commandant IA.", "executed": []}

    api_key = load_gemini_key()
    if not api_key:
        return {
            "ok": False,
            "reply": "Clé Gemini introuvable (configure GEMINI_API_KEY ou ~/.config/caelestia-write/config.json).",
            "executed": [],
        }

    snap = snapshot({})
    projs = list_projects()
    hist = load_chat_history()
    ano_mem = load_ano_long_term_summary()

    ctx = {
        "default_cwd": default_cwd,
        "agents": [
            {
                "id": a["id"], "pid": a["pid"], "kind": a["kind"], "status": a["status"],
                "project": a["project"], "cwd": a["cwd"], "title": a["title"],
                "tool": a["tool"], "model": a["model"], "files": a["files"], "window": a["window"],
            }
            for a in snap["agents"]
        ],
        "perms": [{"id": p.get("id"), "project": p.get("project"), "label": p.get("label"), "detail": p.get("detail")} for p in snap["perms"]],
        "projects": [{"name": p["name"], "cwd": p["cwd"], "branch": p["branch"]} for p in projs[:14]],
    }

    system = (
        "Tu es Katana AI, le Commandant IA d'Agent OS connecté à la MÊME mémoire et aux MÊMES actions système qu'ANO-GPT sur Arch Linux / Hyprland.\n"
        "Tu pilotes DEUX domaines :\n"
        "1) Les agents IA (agy = Antigravity CLI, antigravity = Antigravity App, claude = Claude Code, codex = OpenAI Codex, copilot = GitHub Copilot CLI, opencode = OpenCode, gemini = Gemini CLI, aider = Aider).\n"
        "2) Tout le PC de l'utilisateur via les actions ANO-GPT.\n\n"
        f"MÉMOIRE LONG TERME ANO-GPT :\n{ano_mem or '(aucune entrée)'}\n\n"
        "Réponds UNIQUEMENT en JSON valide :\n"
        '{"reply": "réponse courte, naturelle et factuelle en français", "actions": [...]}\n\n'
        "Actions autorisées :\n"
        '- {"type": "dispatch", "kind": "agy|claude|codex|copilot|opencode|antigravity|gemini|aider", "cwd": "<chemin>", "prompt": ""}\n'
        '  RÈGLE ABSOLUE : si l\'utilisateur dit simplement « lance codex » / « ouvre claude » / « démarre copilot » SANS tâche précise, mets OBLIGATOIREMENT "prompt": "" (CHAÎNE VIDE). N\'invente JAMAIS un prompt comme « Démarrer l\'agent Codex » !\n'
        '- {"type": "send", "agent_id": "<id exact>", "message": "<consigne exacte à envoyer dans la session de l\'agent>"}\n'
        '- {"type": "close_agent", "agent_id": "<id exact>"}  (ferme l\'agent ET son terminal quand l\'utilisateur dit « ferme-le », « ferme codex », « quitte agy »)\n'
        '- {"type": "stop", "agent_id": "<id exact>"}  (interrompt la tâche en cours avec Ctrl+C sans fermer le terminal)\n'
        '- {"type": "kill", "agent_id": "<id exact>"}  (tue le processus agent)\n'
        '- {"type": "focus", "agent_id": "<id exact>"}  (met la fenêtre de l\'agent au premier plan)\n'
        '- {"type": "swarm", "kinds": ["claude","codex"], "cwd": "<chemin>", "prompt": "<mission>"}\n'
        '- {"type": "approve_perm", "perm_id": "<id>"} / {"type": "deny_perm", "perm_id": "<id>"}\n'
        '- {"type": "memory_save", "category": "identity|preferences|projects|relationships|wishes|notes", "key": "<clé>", "value": "<fait>"}\n'
        '- {"type": "memory_search", "query": "<mots-clés>"}\n'
        '- {"type": "ano", "tool": "<outil ANO-GPT>", "params": {...}}\n'
        "  Outils ANO-GPT disponibles : open_app (app_name), close_app (app_name), computer_settings (action, value — volume/luminosité/wifi/bluetooth/nuit/batterie/capture), "
        "system_state (topic: all|bluetooth|wifi|audio|brightness|power|media|hyprland|resources), system_status (), "
        "hypr_orchestrator (action, target), music_control (action, query), youtube_video (query), browser_control (action, url, query), "
        "web_search (query), weather_report (city), file_controller (action, path), reminder (action, text, time), "
        "email_control (action), calendar_control (action), github_control (action), shell_exec (command), capture_control (action), prayer_control (action).\n\n"
        "RÈGLES DE MÉMOIRE & PRÉCISION :\n"
        "- Utilise l'historique de conversation pour résoudre les pronoms (« ferme-le », « envoie-lui… », « codex » juste après « ferme le » = fermer Codex !).\n"
        "- Avant de répondre sur l'état réel du PC (volume, batterie, Wi-Fi, Bluetooth, RAM, musique), appelle `ano` avec `system_state`.\n"
        "- Ne prétends jamais avoir fait une action si elle n'est pas dans `actions`."
    )

    # Construire l'historique multi-tours pour Gemini
    contents = []
    for turn in hist[-12:]:
        role = "user" if turn.get("role") == "user" else "model"
        txt = turn.get("text") or ""
        if role == "model" and turn.get("executed"):
            acts_txt = "; ".join(f"{'OK' if e.get('ok') else 'ERR'}: {e.get('label')}" for e in turn["executed"])
            txt = f"{txt}\n[Actions exécutées : {acts_txt}]"
        if txt:
            contents.append({"role": role, "parts": [{"text": txt}]})

    user_turn_txt = f"État en direct :\n{json.dumps(ctx, ensure_ascii=False)}\n\nMessage de l'utilisateur :\n{prompt}"
    contents.append({"role": "user", "parts": [{"text": user_turn_txt}]})

    parsed, err = call_gemini_json(api_key, system, contents)
    if not parsed:
        return {"ok": False, "reply": f"Erreur Commandant IA : {err}", "executed": []}

    reply = str(parsed.get("reply") or "Ordres transmis.")
    actions = parsed.get("actions") if isinstance(parsed.get("actions"), list) else []
    executed = []
    tool_outputs = []
    agents_by_id = {a["id"]: a for a in snap["agents"]}
    need_followup = False
    info_tools = {"system_state", "system_status", "weather_report", "web_search", "memory_search", "email_control", "calendar_control", "github_control"}

    for act in actions[:8]:
        if not isinstance(act, dict):
            continue
        atype = act.get("type")
        try:
            if atype == "send":
                aid = str(act.get("agent_id") or "")
                msg = str(act.get("message") or "")
                res = send_to_agent(aid, msg)
                executed.append({"type": "send", "ok": bool(res.get("ok")), "label": f"Message → {aid} ({res.get('detail', '')})"})
            elif atype == "dispatch":
                k = str(act.get("kind") or "claude").lower()
                c = str(act.get("cwd") or default_cwd or str(HOME))
                pr = clean_launch_prompt(str(act.get("prompt") or ""))
                dispatch_agent(k, c, pr)
                lbl = f"Lancé {k.upper()} · {norm_project(c)}" + (f" ({clip(pr, 36)})" if pr else "")
                executed.append({"type": "dispatch", "ok": True, "label": lbl})
            elif atype == "swarm":
                kinds = act.get("kinds") if isinstance(act.get("kinds"), list) else []
                c = str(act.get("cwd") or default_cwd or str(HOME))
                pr = clean_launch_prompt(str(act.get("prompt") or ""))
                for k in kinds[:6]:
                    dispatch_agent(str(k).lower(), c, pr)
                executed.append({"type": "swarm", "ok": bool(kinds), "label": f"Escouade ({', '.join(kinds)}) · {norm_project(c)}"})
            elif atype == "close_agent":
                aid = str(act.get("agent_id") or "")
                ag = agents_by_id.get(aid)
                if ag:
                    ok = close_agent_window(ag)
                    executed.append({"type": "close_agent", "ok": ok, "label": f"Fermé · {ag['kind']} ({ag['project']})"})
                else:
                    executed.append({"type": "close_agent", "ok": False, "label": f"Agent introuvable ({aid})"})
            elif atype in ("stop", "kill"):
                aid = str(act.get("agent_id") or "")
                ag = agents_by_id.get(aid)
                if ag and ag.get("pid"):
                    stop_agent(str(ag["pid"]), force=(atype == "kill"))
                    executed.append({"type": atype, "ok": True, "label": f"{'Tué' if atype == 'kill' else 'Stoppé'} · {ag['kind']} ({ag['project']})"})
                else:
                    executed.append({"type": atype, "ok": False, "label": f"Agent sans PID arrêtable ({aid})"})
            elif atype == "focus":
                aid = str(act.get("agent_id") or "")
                ag = agents_by_id.get(aid)
                if ag and ag.get("window"):
                    addr = ag["window"] if ag["window"].startswith("0x") else f"0x{ag['window']}"
                    r = subprocess.run(
                        ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                        capture_output=True, text=True, timeout=2, check=False,
                    )
                    if r.returncode != 0 or "invalid" in (r.stdout + r.stderr).lower():
                        subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], capture_output=True, timeout=2, check=False)
                    executed.append({"type": "focus", "ok": True, "label": f"Focus · {ag['kind']} ({ag['project']})"})
            elif atype in ("approve_perm", "deny_perm"):
                pid_perm = str(act.get("perm_id") or "")
                dec = "allow" if atype == "approve_perm" else "deny"
                answer(pid_perm, dec)
                executed.append({"type": atype, "ok": True, "label": f"Permission {'autorisée' if dec == 'allow' else 'refusée'}"})
            elif atype == "memory_save":
                ok, detail = ano_memory_save(act.get("key") or "note", act.get("value") or "", act.get("category") or "notes")
                executed.append({"type": "memory_save", "ok": ok, "label": detail})
            elif atype == "memory_search":
                res_txt = ano_memory_search(act.get("query") or "")
                executed.append({"type": "memory_search", "ok": True, "label": f"Mémoire ANO-GPT · {clip(act.get('query') or '', 30)}"})
                tool_outputs.append({"tool": "memory_search", "output": res_txt})
                need_followup = True
            elif atype == "ano":
                tname = str(act.get("tool") or "")
                tparams = act.get("params") if isinstance(act.get("params"), dict) else {}
                ok, detail = call_ano_action(tname, tparams)
                executed.append({"type": f"ano:{tname}", "ok": ok, "label": f"ANO · {tname} ({clip(detail, 55)})"})
                tool_outputs.append({"tool": tname, "ok": ok, "output": detail})
                if tname in info_tools:
                    need_followup = True
        except SystemExit:
            executed.append({"type": str(atype), "ok": False, "label": f"Échec {atype}"})

    # Si un outil d'information a renvoyé des données réelles (batterie, météo, recherche, mémoire…), synthétiser la vraie réponse
    if need_followup and tool_outputs:
        followup_contents = contents + [
            {"role": "model", "parts": [{"text": json.dumps(parsed, ensure_ascii=False)}]},
            {"role": "user", "parts": [{"text": f"Résultats réels des outils exécutés :\n{json.dumps(tool_outputs, ensure_ascii=False)}\nFormule la réponse finale exacte en français dans {{\"reply\": \"...\", \"actions\": []}} sans ré-exécuter d'action."}]},
        ]
        parsed2, _ = call_gemini_json(api_key, system, followup_contents)
        if parsed2 and parsed2.get("reply"):
            reply = str(parsed2["reply"])

    # Sauvegarder l'échange dans la mémoire conversationnelle persistante
    hist.append({"role": "user", "text": prompt, "executed": [], "ts": int(time.time() * 1000)})
    hist.append({"role": "ai", "text": reply, "executed": executed, "ts": int(time.time() * 1000)})
    save_chat_history(hist)

    return {"ok": True, "reply": reply, "executed": executed}


def launch_agent(kind):
    dispatch_agent(kind, "", "")


def list_projects():
    """Découvre automatiquement les projets récents (agents actifs, bases de sessions et dossiers git)."""
    seen = {}

    def add(path, source, active=False):
        if not path:
            return
        p = str(path).rstrip("/")
        if not p or p == str(HOME) or not os.path.isdir(p):
            return
        cur = seen.get(p)
        if cur:
            cur["active"] = cur["active"] or active
            return
        seen[p] = {
            "cwd": p,
            "name": os.path.basename(p) or p,
            "branch": git_branch(p),
            "source": source,
            "active": active,
        }

    # 1. Agents actifs / récents
    snap = snapshot({})
    for a in snap["agents"]:
        add(a.get("cwd"), a.get("kind") or "agent", active=a.get("status") != "idle")

    # 2. Projets OpenCode
    ocdb = HOME / ".local/share/opencode/opencode.db"
    if ocdb.is_file():
        try:
            con = sqlite3.connect(f"file:{ocdb}?mode=ro", uri=True, timeout=0.3)
            for (d,) in con.execute("SELECT DISTINCT directory FROM session_v2 WHERE directory IS NOT NULL ORDER BY time_updated DESC LIMIT 10"):
                add(d, "opencode")
            con.close()
        except sqlite3.Error:
            pass

    # 3. Projets Antigravity
    agdb = HOME / ".gemini/antigravity/conversation_summaries.db"
    if agdb.is_file():
        try:
            con = sqlite3.connect(f"file:{agdb}?mode=ro", uri=True, timeout=0.3)
            for (u,) in con.execute("SELECT workspace_uris FROM conversation_summaries WHERE workspace_uris != '' ORDER BY last_modified_time DESC LIMIT 15"):
                add(ag_decode_workspace(u), "antigravity")
            con.close()
        except sqlite3.Error:
            pass

    # 4. Projets Copilot
    copdb = HOME / ".copilot/session-store.db"
    if copdb.is_file():
        try:
            con = sqlite3.connect(f"file:{copdb}?mode=ro", uri=True, timeout=0.3)
            for (d,) in con.execute("SELECT DISTINCT cwd FROM sessions WHERE cwd IS NOT NULL ORDER BY updated_at DESC LIMIT 10"):
                add(d, "copilot")
            con.close()
        except sqlite3.Error:
            pass

    # 5. Dossiers de développement courants
    for base in (HOME / "development", HOME / "OUTILS", HOME / "Documents/MES_PROJETS", HOME / "Documents/MES_PROJETS/FLUTTER PROJETS", HOME / "Documents/MES_PROJETS/MES_APPLIS"):
        if not base.is_dir():
            continue
        try:
            entries = sorted(base.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:10]
            for e in entries:
                if e.is_dir() and not e.name.startswith(".") and ((e / ".git").exists() or (e / "package.json").exists() or (e / "pubspec.yaml").exists() or (e / "pyproject.toml").exists()):
                    add(str(e), "disk")
        except OSError:
            pass

    res = sorted(seen.values(), key=lambda x: (not x["active"], x["source"] == "disk", x["name"].lower()))
    return res[:18]


def git_short_status(cwd):
    if not cwd or not os.path.isdir(cwd):
        return []
    try:
        res = subprocess.run(
            ["git", "-C", cwd, "status", "--short", "--untracked-files=normal"],
            capture_output=True, text=True, timeout=1.2, check=False,
        )
        if res.returncode != 0:
            return []
        lines = [ln for ln in res.stdout.splitlines() if ln.strip()][:12]
        return lines
    except (OSError, subprocess.TimeoutExpired):
        return []


def agent_detail(agent_id):
    """Retourne la timeline détaillée, les étapes et le statut git d'un agent pour l'inspecteur Agent OS."""
    snap = snapshot({})
    target = next((a for a in snap["agents"] if a["id"] == agent_id), None)
    events = []
    steps = []
    cwd = target["cwd"] if target else ""
    kind = target["kind"] if target else ""

    if target and kind in ("antigravity", "agy"):
        prefix = agent_id.split(":", 1)[-1]
        brain = HOME / ".gemini/antigravity/brain"
        if brain.is_dir():
            for d in brain.iterdir():
                if d.is_dir() and d.name.startswith(prefix):
                    tr = d / ".system_generated/logs/transcript.jsonl"
                    for line in tail_lines(tr, size=160 * 1024):
                        ltype = line.get("type")
                        if ltype == "USER_INPUT":
                            txt = line.get("content") or ""
                            m = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", txt, re.DOTALL)
                            if m:
                                txt = m.group(1)
                            events.append({"kind": "user", "text": clip(txt, 140)})
                        elif ltype == "PLANNER_RESPONSE":
                            for tc in line.get("tool_calls") or []:
                                if not isinstance(tc, dict):
                                    continue
                                tn = tc.get("name") or ""
                                args = tc.get("args") if isinstance(tc.get("args"), dict) else {}
                                if tn == "update_steps":
                                    rs = args.get("steps")
                                    if isinstance(rs, str):
                                        try:
                                            rs = json.loads(rs)
                                        except ValueError:
                                            rs = None
                                    if isinstance(rs, list):
                                        steps = [{"title": clip(x.get("title", ""), 60), "status": x.get("status", "pending")} for x in rs if isinstance(x, dict)]
                                elif tn == "update_focus":
                                    fv = str(args.get("focus") or "").strip().strip('"')
                                    if fv:
                                        events.append({"kind": "focus", "text": clip(fv, 110)})
                                else:
                                    events.append({"kind": "tool", "text": tool_label(tn, args)})
                            if (line.get("content") or "").strip():
                                events.append({"kind": "reply", "text": clip(line["content"], 160)})
                    break
    elif target and kind == "codex":
        for f, _ in sorted(codex_files(), key=lambda x: x[1], reverse=True):
            m = (first_line(f) or {}).get("payload") or {}
            if m.get("cwd") == cwd:
                for line in tail_lines(f, size=140 * 1024):
                    p = line.get("payload") or {}
                    lt = line.get("type")
                    if lt == "response_item" and p.get("type") == "function_call":
                        try:
                            args = json.loads(p.get("arguments") or "{}")
                        except ValueError:
                            args = {}
                        events.append({"kind": "tool", "text": tool_label(p.get("name") or "Outil", args)})
                    elif lt == "event_msg" and p.get("type") == "item_completed":
                        item = p.get("item") or {}
                        it = item.get("type")
                        if it == "AgentMessage":
                            txts = [c.get("text") for c in item.get("content") or [] if isinstance(c, dict) and c.get("text")]
                            if txts:
                                events.append({"kind": "reply", "text": clip(txts[0], 160)})
                        elif it == "FileChange":
                            for fp in (item.get("changes") or {}):
                                events.append({"kind": "file", "text": f"Modifié · {os.path.basename(fp)}"})
                break
    elif target and kind == "claude":
        try:
            meta = json.loads((HOME / f".claude/sessions/{target['pid']}.json").read_text())
            tr = claude_transcript(meta.get("sessionId") or "")
            if tr:
                for line in tail_lines(tr, size=140 * 1024):
                    kt = line.get("type")
                    if kt in ("user", "assistant") and not line.get("isSidechain"):
                        msg = line.get("message") or {}
                        content = msg.get("content")
                        if kt == "user" and isinstance(content, str) and not content.startswith("<"):
                            events.append({"kind": "user", "text": clip(content, 140)})
                        elif kt == "assistant" and isinstance(content, list):
                            for b in content:
                                if not isinstance(b, dict):
                                    continue
                                if b.get("type") == "tool_use":
                                    events.append({"kind": "tool", "text": tool_label(b.get("name"), b.get("input"))})
                                elif b.get("type") == "text" and (b.get("text") or "").strip():
                                    events.append({"kind": "reply", "text": clip(b["text"], 160)})
        except (OSError, ValueError):
            pass
    elif target and kind == "copilot":
        sroot = HOME / ".copilot/session-state"
        if sroot.is_dir():
            for d in sorted(sroot.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:6]:
                ws = parse_simple_yaml(d / "workspace.yaml")
                if ws.get("cwd") == cwd or agent_id.endswith(d.name[:8]):
                    for line in tail_lines(d / "events.jsonl", size=140 * 1024):
                        t = line.get("type")
                        dat = line.get("data") or {}
                        if t == "user.message" and dat.get("content"):
                            events.append({"kind": "user", "text": clip(dat["content"], 140)})
                        elif t == "tool.execution_start":
                            args = dat.get("arguments")
                            if isinstance(args, str):
                                try:
                                    args = json.loads(args)
                                except ValueError:
                                    args = {"patch": args} if "Begin Patch" in args else {"command": args}
                            events.append({"kind": "tool", "text": tool_label(dat.get("toolName"), args if isinstance(args, dict) else {})})
                        elif t == "assistant.message" and (dat.get("content") or "").strip():
                            events.append({"kind": "reply", "text": clip(dat["content"], 160)})
                    break
    elif target and kind == "opencode":
        ocdb = HOME / ".local/share/opencode/opencode.db"
        if ocdb.is_file():
            try:
                con = sqlite3.connect(f"file:{ocdb}?mode=ro", uri=True, timeout=0.4)
                prefix = agent_id.split(":", 1)[-1]
                row = con.execute("SELECT id FROM session_v2 WHERE id LIKE ? ORDER BY time_updated DESC LIMIT 1", (f"{prefix}%",)).fetchone()
                if row:
                    parts = con.execute("SELECT type, data FROM session_part WHERE session_id = ? ORDER BY time_updated DESC LIMIT 18", (row[0],)).fetchall()
                    for ptype, raw in reversed(parts):
                        try:
                            pd = json.loads(raw)
                        except (ValueError, TypeError):
                            continue
                        if ptype == "tool":
                            st = pd.get("state") or {}
                            events.append({"kind": "tool", "text": tool_label(pd.get("name"), st.get("input"))})
                        elif ptype == "text" and (pd.get("text") or "").strip():
                            events.append({"kind": "reply", "text": clip(pd["text"], 160)})
                        elif ptype == "reasoning" and (pd.get("text") or "").strip():
                            events.append({"kind": "focus", "text": clip(pd["text"], 110)})
                con.close()
            except sqlite3.Error:
                pass

    return {
        "id": agent_id,
        "events": events[-14:],
        "steps": steps,
        "gitStatus": git_short_status(cwd),
    }


# ───────────────────────── hook PermissionRequest ─────────────────────────

def island_running():
    try:
        res = subprocess.run(["pgrep", "-f", "qs -c (caelestia|ano-shell)"], capture_output=True, timeout=2, check=False)
        return res.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def agent_pid():
    cur = os.getppid()
    for _ in range(12):
        p = read_proc(cur)
        if not p:
            break
        if agent_of(p) == "claude":
            return cur
        cur = p["ppid"]
    return os.getppid()


def perm_detail(tool, inp):
    inp = inp if isinstance(inp, dict) else {}
    if tool == "Bash":
        return inp.get("command") or ""
    if tool in ("Edit", "Write", "MultiEdit", "Read", "NotebookEdit"):
        return inp.get("file_path") or inp.get("notebook_path") or ""
    for k in ("url", "query", "pattern", "path", "prompt", "description"):
        if isinstance(inp.get(k), str):
            return inp[k]
    return clip(json.dumps(inp, ensure_ascii=False), 300)


def hook():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if data.get("hook_event_name") != "PermissionRequest" or not island_running():
        return
    PERMS.mkdir(parents=True, exist_ok=True)
    rid = uuid.uuid4().hex[:12]
    req, ans = PERMS / f"{rid}.json", PERMS / f"{rid}.answer"

    def cleanup(*_):
        req.unlink(missing_ok=True)
        ans.unlink(missing_ok=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGHUP, cleanup)
    tool = data.get("tool_name") or "Outil"
    cwd = data.get("cwd") or os.getcwd()
    info = {
        "id": rid,
        "hookPid": os.getpid(),
        "agentPid": agent_pid(),
        "session": data.get("session_id") or "",
        "project": os.path.basename(cwd.rstrip("/")) or "~",
        "tool": tool,
        "label": tool_label(tool, data.get("tool_input")).split(" · ")[0],
        "detail": clip(perm_detail(tool, data.get("tool_input")), 400),
        "ts": int(time.time() * 1000),
    }
    tmp = req.with_suffix(".tmp")
    tmp.write_text(json.dumps(info, ensure_ascii=False))
    tmp.rename(req)
    answer = ""
    try:
        end = time.time() + WAIT
        while time.time() < end:
            if ans.exists():
                answer = ans.read_text().strip()
                break
            time.sleep(0.15)
    finally:
        req.unlink(missing_ok=True)
        ans.unlink(missing_ok=True)
    if answer in ("allow", "deny"):
        decision = {"behavior": answer}
        if answer == "deny":
            decision["message"] = "Refusé depuis l'île par l'utilisateur."
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))


def answer(rid, decision):
    if not rid.isalnum() or decision not in ("allow", "deny", "terminal"):
        sys.exit(2)
    if (PERMS / f"{rid}.json").exists():
        (PERMS / f"{rid}.answer").write_text(decision)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "watch":
        watch()
    elif cmd == "hook":
        hook()
    elif cmd == "answer" and len(sys.argv) == 4:
        answer(sys.argv[2], sys.argv[3])
    elif cmd == "stop" and len(sys.argv) == 3:
        stop_agent(sys.argv[2], force=False)
    elif cmd == "kill" and len(sys.argv) == 3:
        stop_agent(sys.argv[2], force=True)
    elif cmd == "launch" and len(sys.argv) == 3:
        launch_agent(sys.argv[2])
    elif cmd == "dispatch" and len(sys.argv) >= 4:
        dispatch_agent(sys.argv[2], sys.argv[3], " ".join(sys.argv[4:]))
    elif cmd == "send" and len(sys.argv) >= 4:
        print(json.dumps(send_to_agent(sys.argv[2], " ".join(sys.argv[3:])), ensure_ascii=False))
    elif cmd == "commander" and len(sys.argv) >= 3:
        cwd_arg = ""
        args = sys.argv[2:]
        if len(args) >= 2 and args[0] == "--cwd":
            cwd_arg = args[1]
            args = args[2:]
        print(json.dumps(commander(" ".join(args), default_cwd=cwd_arg), ensure_ascii=False))
    elif cmd == "history":
        print(json.dumps(load_chat_history(), ensure_ascii=False))
    elif cmd == "history-clear":
        clear_chat_history()
        print("[]")
    elif cmd == "terminal" and len(sys.argv) >= 2:
        open_terminal(sys.argv[2] if len(sys.argv) > 2 else "")
    elif cmd == "projects":
        print(json.dumps(list_projects(), ensure_ascii=False))
    elif cmd == "detail" and len(sys.argv) == 3:
        print(json.dumps(agent_detail(sys.argv[2]), ensure_ascii=False))
    elif cmd == "once":
        print(json.dumps(snapshot({}), ensure_ascii=False, indent=2))
    else:
        print(__doc__)
        sys.exit(2)
