HOME = Path.home()
PERMS = HOME / ".local/state/caelestia/agent-perms"
CHAT_HISTORY = HOME / ".local/state/caelestia/agentos-chat.json"
ANO_DIR = HOME / "OUTILS/ANO-GPT"
WAIT = 110  # secondes d'attente d'une réponse de l'île (timeout du hook : 120)
TAIL = 96 * 1024
RECENT_WINDOW = 1800  # 30 min pour les sessions DB récemment terminées


# ───────────────────────── utilitaires ─────────────────────────

def clip(text, n):
    text = " ".join(str(text or "").split())
    return text if len(text) <= n else text[: max(1, n - 1)] + "…"


def parse_iso_ts(val):
    if not val:
        return 0.0
    if isinstance(val, (int, float)):
        return val / 1000.0 if val > 1e12 else float(val)
    s = str(val).strip()
    if not s or s.startswith("0001-"):
        return 0.0
    try:
        # Gère les nanosecondes Go (ex. 2026-11-27 15:45:35.390683932+00:00) et le suffixe Z
        s = s.replace(" ", "T")
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        s = re.sub(r"(\.\d{6})\d+", r"\1", s)
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.timestamp()
    except ValueError:
        return 0.0


def tail_lines(path, size=TAIL):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            end = f.tell()
            f.seek(max(0, end - size))
            data = f.read()
    except OSError:
        return []
    lines = data.split(b"\n")
    if end > size:
        lines = lines[1:]
    out = []
    for raw in lines:
        if not raw.strip():
            continue
        try:
            out.append(json.loads(raw))
        except ValueError:
            pass
    return out


def first_line(path):
    try:
        with open(path, "rb") as f:
            return json.loads(f.readline())
    except (OSError, ValueError):
        return None


def file_sig(path):
    """Signature rapide (mtime, size) incluant le fichier -wal pour SQLite."""
    sig = []
    for p in (path, Path(str(path) + "-wal")):
        try:
            st = p.stat()
            sig.append((st.st_mtime_ns, st.st_size))
        except OSError:
            sig.append((0, 0))
    return tuple(sig)


def pretty_model(raw):
    if not raw:
        return ""
    s = str(raw).strip()
    if s.startswith("<") or s == "auto":
        return ""
    if "/" in s:
        s = s.rsplit("/", 1)[-1]
    s = re.sub(r"-free$", "", s)
    s = re.sub(r"-\d{8}$", "", s)
    s = re.sub(r"-(preview|latest|exp)$", "", s)
    # Noms connus joliment formatés
    low = s.lower()
    if low.startswith("gemini-"):
        parts = [p.capitalize() if not p[0].isdigit() else p for p in s.split("-")]
        return clip(" ".join(parts), 26)
    if low.startswith("claude-"):
        parts = s.split("-")
        # ex. claude-sonnet-4-5 ou claude-opus-4-6
        out = ["Claude"]
        for p in parts[1:]:
            if p.isdigit() and out and out[-1][0].isdigit():
                out[-1] = f"{out[-1]}.{p}"
            else:
                out.append(p.capitalize())
        return clip(" ".join(out), 26)
    if low.startswith("gpt-"):
        parts = s.split("-")
        head = f"GPT-{parts[1]}" if len(parts) > 1 else "GPT"
        rest = [p.capitalize() if not p[0].isdigit() else p for p in parts[2:]]
        return clip(" ".join([head] + rest), 26)
    if low.startswith("deepseek-"):
        parts = s.split("-")
        rest = [p.capitalize() if not (p[0].isdigit() or p.startswith("v")) else p for p in parts[1:]]
        return clip(" ".join(["DeepSeek"] + rest), 26)
    return clip(s, 26)


def tool_label(name, inp=None):
    inp = inp if isinstance(inp, dict) else {}
    raw = str(name or "Outil")
    clean = raw.replace("mcp__", "").split("__")[-1]
    low = clean.lower()
    labels = {
        "bash": "Commande", "shell": "Commande", "run_command": "Commande",
        "command_execution": "Commande", "commandexecution": "Commande", "exec": "Commande",
        "edit": "Modifie", "edit_file": "Modifie", "multiedit": "Modifie",
        "replace_file_content": "Modifie", "multi_replace_file_content": "Modifie",
        "apply_patch": "Patch", "patch": "Patch", "filechange": "Modifie",
        "write": "Écrit", "write_file": "Écrit", "write_to_file": "Écrit", "create": "Crée",
        "notebookedit": "Notebook",
        "read": "Lit", "read_file": "Lit", "view": "Lit", "view_file": "Lit",
        "view_file_outline": "Plan", "view_code_item": "Code",
        "grep": "Cherche", "grep_search": "Cherche", "glob": "Fichiers",
        "find_by_name": "Fichiers", "list_dir": "Dossier",
        "webfetch": "Web", "read_url_content": "Web",
        "websearch": "Recherche web", "search_web": "Recherche web",
        "agent": "Sous-agent", "task": "Sous-agent", "invoke_subagent": "Sous-agent",
        "send_message": "Message agent", "run_workflow": "Workflow",
        "update_focus": "Phase", "update_steps": "Étapes",
        "ask_question": "Question", "ask_user": "Question",
    }
    detail = None
    for k in ("description", "toolSummary", "focus", "file_path", "Path", "TargetFile",
              "path", "command", "CommandLine", "pattern", "Query", "query", "url", "prompt", "Role"):
        v = inp.get(k)
        if isinstance(v, str) and v.strip():
            detail = v.strip().strip('"')
            if k in ("file_path", "Path", "TargetFile", "path"):
                detail = os.path.basename(detail.rstrip("/")) or detail
            break
    if not detail and low == "apply_patch" and isinstance(inp.get("patch"), str):
        m = re.search(r"\*\*\* (?:Update|Add|Delete) File:\s*(.+)", inp["patch"])
        if m:
            detail = os.path.basename(m.group(1).strip())
    label = labels.get(low, clean)
    return f"{label} · {clip(detail, 70)}" if detail else label


_git_cache = {}  # cwd -> (ts, branch)


def git_branch(cwd):
    if not cwd or cwd == str(HOME):
        return ""
    now = time.time()
    hit = _git_cache.get(cwd)
    if hit and now - hit[0] < 15:
        return hit[1]
    branch = ""
    cur = Path(cwd)
    for _ in range(6):
        g = cur / ".git"
        if g.exists():
            try:
                head = (g / "HEAD") if g.is_dir() else Path(g.read_text().split(":", 1)[1].strip()) / "HEAD"
                if not head.is_absolute():
                    head = (cur / head).resolve()
                txt = head.read_text(errors="replace").strip()
                if txt.startswith("ref:"):
                    branch = txt.rsplit("/", 1)[-1]
                elif txt:
                    branch = txt[:7]
            except OSError:
                pass
            break
        if cur.parent == cur or cur == HOME:
            break
        cur = cur.parent
    _git_cache[cwd] = (now, branch)
    return branch


def norm_project(cwd, fallback="~"):
    if not cwd:
        return fallback
    p = cwd.rstrip("/")
    if p == str(HOME):
        return "~"
    return os.path.basename(p) or fallback


# ───────────────────────── processus & fenêtres ─────────────────────────

def read_proc(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    rp = stat.rfind(")")
    comm = stat[stat.find("(") + 1 : rp]
    rest = stat[rp + 2 :].split()
    if len(rest) < 20:
        return None
    return {
        "pid": pid,
        "ppid": int(rest[1]),
        "comm": comm,
        "utime": int(rest[11]),
        "stime": int(rest[12]),
        "start": int(rest[19]),
    }


BACKGROUND = {
    "app-server", "mcp-server", "mcp", "login", "logout", "update", "completion",
    "doctor", "daemon", "serve", "auth", "version", "--version", "-v", "help", "--help",
}
AGENT_COMMS = {
    "claude", "codex", "copilot", "opencode", "agy", "antigravity",
    "gemini", "aider", "node", "bun", "python", "python3", "mainthread",
}


def read_proc_meta(pid):
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    try:
        argv = [a.decode(errors="replace") for a in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0") if a]
    except OSError:
        argv = []
    return exe, argv


def agent_of(p):
    comm = p["comm"].lower()
    if comm not in AGENT_COMMS and not (comm and comm[0].isdigit()):
        return None
    exe, argv = read_proc_meta(p["pid"])
    argv0 = argv[0] if argv else ""
    base_exe = os.path.basename(exe).lower()
    base_argv0 = os.path.basename(argv0).lower()
    names = {comm, base_exe, base_argv0}

    # Ignorer les sous-processus Electron (renderer, gpu, zygote, utility, sidecars)
    if "antigravity" in names:
        joined = " ".join(argv[1:4])
        if "--type=" in joined or "--import=" in joined or "sidecar" in joined or "language_server" in joined:
            return None
        return "antigravity"

    # Ignorer démons / outils de fond (codex app-server, opencode serve, serveurs MCP…)
    if BACKGROUND & set(argv[1:3]):
        return None

    if "claude" in names or "/claude/versions/" in exe:
        return "claude"
    if "codex" in names:
        return "codex"
    if "copilot" in names or "/copilot" in exe.lower():
        return "copilot"
    if "opencode" in names and "opencode-pty" not in comm:
        return "opencode"
    if "agy" in names:
        return "agy"
    if "aider" in names or (comm in ("python", "python3") and any("aider" in a.lower() for a in argv[1:3])):
        return "aider"
    if "gemini" in names or (
        comm in ("node", "bun")
        and any(a.endswith("/gemini") or "gemini-cli" in a for a in argv[1:3])
    ):
        return "gemini"
    return None


BOOT = 0.0
try:
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("btime"):
                BOOT = float(line.split()[1])
except OSError:
    pass
HZ = os.sysconf("SC_CLK_TCK")


def scan():
    procs = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            p = read_proc(int(d))
            if p:
                procs[p["pid"]] = p
    agents = {pid: k for pid, p in procs.items() if (k := agent_of(p))}
    roots = []
    for pid, kind in agents.items():
        cur, root = procs[pid]["ppid"], True
        for _ in range(32):
            if cur <= 1:
                break
            if agents.get(cur) == kind:
                root = False
                break
            cur = procs.get(cur, {}).get("ppid", 0)
        if root:
            roots.append((pid, kind))
    return procs, roots


_win_cache = (0.0, {}, {})  # (ts, by_pid, by_class)


def windows():
    global _win_cache
    if time.time() - _win_cache[0] < 3:
        return _win_cache[1], _win_cache[2]
    by_pid, by_class = {}, {}
    try:
        res = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, timeout=2, check=False)
        for c in json.loads(res.stdout or b"[]"):
            addr = (c.get("address") or "").removeprefix("0x")
            if not addr:
                continue
            pid = c.get("pid")
            if pid:
                by_pid[pid] = addr
            cls = (c.get("class") or "").lower()
            if cls and cls not in by_class:
                by_class[cls] = addr
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    _win_cache = (time.time(), by_pid, by_class)
    return by_pid, by_class


def window_of(pid, procs, fallback_class=""):
    by_pid, by_class = windows()
    cur = pid
    for _ in range(24):
        if cur in by_pid:
            return by_pid[cur]
        p = procs.get(cur)
        if not p or p["ppid"] <= 1:
            break
        cur = p["ppid"]
    if fallback_class:
        return by_class.get(fallback_class.lower(), "")
    return ""


def proc_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


# ───────────────────────── 1. Claude Code ─────────────────────────

def claude_transcript(sid):
    base = HOME / ".claude/projects"
    if not base.is_dir():
        return None
    for d in base.iterdir():
        f = d / f"{sid}.jsonl"
        if f.is_file():
            return f
    return None


_claude_transcripts = {}
_claude_cache = {}


def claude_summary(sid):
    s = {"title": "", "tool": "", "reply": "", "prompt": "", "files": [], "model": "", "tokens": 0, "subagents": 0}
    if not sid:
        return s
    path = _claude_transcripts.get(sid)
    if not path or not path.is_file():
        path = claude_transcript(sid)
        _claude_transcripts[sid] = path
    if not path:
        return s
    sig = file_sig(path)
    hit = _claude_cache.get(sid)
    if hit and hit[0] == sig:
        return hit[1]
    custom = None
    active_subagents = set()
    for line in tail_lines(path):
        kind = line.get("type")
        if kind in ("ai-title", "custom-title", "summary"):
            t = line.get("customTitle") or line.get("aiTitle") or line.get("summary")
            if t:
                if kind == "custom-title":
                    custom = clip(t, 60)
                else:
                    s["title"] = clip(t, 60)
        elif kind in ("user", "assistant") and not line.get("isSidechain"):
            msg = line.get("message") or {}
            content = msg.get("content")
            if kind == "user":
                if line.get("isMeta"):
                    continue
                if isinstance(content, str) and not content.startswith("<"):
                    s["prompt"] = clip(content, 120)
                elif isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_result":
                            s["tool"] = ""
                            active_subagents.discard(b.get("tool_use_id"))
                    if not any(b.get("type") == "tool_result" for b in content if isinstance(b, dict)):
                        texts = [b.get("text") for b in content if isinstance(b, dict) and isinstance(b.get("text"), str)]
                        texts = [t for t in texts if not t.startswith("<")]
                        if texts:
                            s["prompt"] = clip(texts[0], 120)
                continue
            if isinstance(msg.get("model"), str) and not msg["model"].startswith("<"):
                s["model"] = msg["model"]
            usage = msg.get("usage")
            if isinstance(usage, dict):
                tok = (usage.get("input_tokens") or 0) + (usage.get("output_tokens") or 0) + (usage.get("cache_read_input_tokens") or 0)
                if tok > 0:
                    s["tokens"] = max(s["tokens"], tok)
            for b in content if isinstance(content, list) else []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and (b.get("text") or "").strip():
                    s["reply"] = clip(b["text"], 160)
                    s["tool"] = ""
                elif b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    tname = b.get("name") or "Outil"
                    s["tool"] = tool_label(tname, inp)
                    if tname in ("Agent", "Task") and b.get("id"):
                        active_subagents.add(b["id"])
                    f = inp.get("file_path") or inp.get("notebook_path")
                    if tname in ("Edit", "Write", "MultiEdit", "NotebookEdit") and f and f not in s["files"]:
                        s["files"].append(f)
    if custom:
        s["title"] = custom
    s["subagents"] = len(active_subagents)
    _claude_cache[sid] = (sig, s)
    return s


# ───────────────────────── 2. OpenAI Codex ─────────────────────────

def codex_titles():
    titles = {}
    try:
        with open(HOME / ".codex/session_index.jsonl") as f:
            for line in f:
                try:
                    v = json.loads(line)
                    titles[v["id"]] = v["thread_name"]
                except (ValueError, KeyError):
                    pass
    except OSError:
        pass
    return titles


def codex_files():
    root = HOME / ".codex/sessions"
    if not root.is_dir():
        return []
    days = sorted(root.glob("*/*/*"), reverse=True)[:4]
    out = []
    for d in days:
        for f in d.glob("rollout-*.jsonl"):
            try:
                out.append((f, f.stat().st_mtime))
            except OSError:
                pass
    return out


_codex_busy_cache = {}
_codex_summary_cache = {}


def codex_busy(path):
    """Début/fin de tâche hors de la fin lue (gros prompt système) : chercher dans tout le fichier."""
    try:
        size = path.stat().st_size
    except OSError:
        return None
    hit = _codex_busy_cache.get(path)
    if hit and hit[0] == size:
        return hit[1]
    try:
        data = path.read_bytes()
    except OSError:
        return None
    start = data.rfind(b'"type":"task_started"')
    end = max(data.rfind(b'"type":"task_complete"'), data.rfind(b'"type":"turn_aborted"'))
    busy = None if start < 0 and end < 0 else start > end
    _codex_busy_cache[path] = (size, busy)
    return busy


def codex_summary(path, titles):
    sig = file_sig(path)
    hit = _codex_summary_cache.get(path)
    if hit and hit[0] == sig:
        return hit[1]
    meta = (first_line(path) or {}).get("payload") or {}
    s = {
        "title": clip(titles.get(meta.get("id"), ""), 60),
        "tool": "", "reply": "", "prompt": "",
        "files": [], "model": "", "busy": None, "tokens": 0,
    }
    for line in tail_lines(path):
        p = line.get("payload") or {}
        ltype = line.get("type")
        if ltype == "turn_context":
            s["model"] = p.get("model") or s["model"]
        elif ltype == "response_item":
            ptype = p.get("type")
            if ptype == "function_call":
                fname = p.get("name") or "Outil"
                try:
                    args = json.loads(p.get("arguments") or "{}")
                except ValueError:
                    args = {}
                s["tool"] = tool_label(fname, args)
        elif ltype == "event_msg":
            t = p.get("type")
            if t == "task_started":
                s["busy"] = True
            elif t in ("task_complete", "turn_aborted"):
                s["busy"], s["tool"] = False, ""
                if p.get("last_agent_message"):
                    s["reply"] = clip(p["last_agent_message"], 160)
            elif t == "token_count":
                info = p.get("info") or {}
                tu = info.get("total_token_usage") or info.get("last_token_usage") or {}
                tok = tu.get("total_tokens") or ((tu.get("input_tokens") or 0) + (tu.get("output_tokens") or 0))
                if tok:
                    s["tokens"] = max(s["tokens"], int(tok))
            elif t == "item_completed":
                item = p.get("item") or {}
                it = item.get("type")
                if it == "CommandExecution":
                    cmd = item.get("command")
                    cmd = cmd[-1] if isinstance(cmd, list) and cmd else cmd
                    s["tool"] = f"Commande · {clip(cmd, 70)}"
                elif it == "FileChange":
                    for f in (item.get("changes") or {}):
                        if f not in s["files"]:
                            s["files"].append(f)
                        s["tool"] = f"Modifie · {os.path.basename(f)}"
                elif it == "AgentMessage":
                    txt = [c.get("text") for c in item.get("content") or [] if isinstance(c, dict) and c.get("text")]
                    if txt:
                        s["reply"] = clip(txt[0], 160)
                elif it == "UserMessage":
                    txt = [c.get("text") for c in item.get("content") or [] if isinstance(c, dict) and c.get("text")]
                    txt = [t for t in txt if not t.startswith("<")]
                    if txt:
                        s["prompt"] = clip(txt[0], 120)
    _codex_summary_cache[path] = (sig, s)
    return s


# ───────────────────────── 3. GitHub Copilot CLI ─────────────────────────

_copilot_cache = {}


def parse_simple_yaml(path):
    out = {}
    try:
        for line in path.read_text(errors="replace").splitlines():
            if ":" in line and not line.startswith(" "):
                k, v = line.split(":", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def copilot_open_sessions():
    p = HOME / ".copilot/open-sessions-state.json"
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return {}


def copilot_session_summary(sdir):
    ev = sdir / "events.jsonl"
    ws_path = sdir / "workspace.yaml"
    sig = (file_sig(ev), file_sig(ws_path))
    hit = _copilot_cache.get(sdir.name)
    if hit and hit[0] == sig:
        return hit[1]

    ws = parse_simple_yaml(ws_path) if ws_path.is_file() else {}
    s = {
        "sid": sdir.name,
        "cwd": ws.get("cwd") or "",
        "branch": ws.get("branch") or "",
        "title": clip(ws.get("name") or "", 60),
        "tool": "", "reply": "", "prompt": "",
        "files": [], "model": "", "tokens": 0,
        "status": "idle", "wait_detail": "",
        "updated": ev.stat().st_mtime if ev.is_file() else 0.0,
        "started": parse_iso_ts(ws.get("created_at")),
    }
    if not ev.is_file():
        _copilot_cache[sdir.name] = (sig, s)
        return s

    pending_perm = {}
    in_turn = False
    running_tools = {}
    for line in tail_lines(ev, size=128 * 1024):
        t = line.get("type")
        d = line.get("data") or {}
        if t == "session.start":
            if not s["started"]:
                s["started"] = parse_iso_ts(d.get("startTime"))
            ctx = d.get("context") or {}
            if not s["cwd"] and ctx.get("cwd"):
                s["cwd"] = ctx["cwd"]
        elif t == "session.model_change":
            m = d.get("newModel")
            if m and m != "auto":
                s["model"] = m
        elif t == "user.message":
            if d.get("content"):
                s["prompt"] = clip(d["content"], 120)
        elif t == "assistant.turn_start" or t == "model.turn_started":
            in_turn = True
        elif t in ("assistant.turn_end", "model.turn_ended", "session.shutdown"):
            in_turn = False
            running_tools.clear()
            pending_perm.clear()
            s["tool"] = ""
        elif t == "session.error":
            in_turn = False
            running_tools.clear()
        elif t == "assistant.message":
            if d.get("model"):
                s["model"] = d["model"]
            if (d.get("content") or "").strip():
                s["reply"] = clip(d["content"], 160)
        elif t == "tool.execution_start":
            cid = d.get("toolCallId") or "t"
            tname = d.get("toolName") or "Outil"
            args = d.get("arguments")
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except ValueError:
                    args = {"patch": args} if "Begin Patch" in args else {"command": args}
            lbl = tool_label(tname, args if isinstance(args, dict) else {})
            running_tools[cid] = lbl
            s["tool"] = lbl
            in_turn = True
            # Compter fichiers touchés
            if isinstance(args, dict):
                f = args.get("file_path") or args.get("path")
                if tname in ("edit", "create", "write", "write_file", "edit_file") and f and f not in s["files"]:
                    s["files"].append(f)
                elif tname == "apply_patch" and isinstance(args.get("patch"), str):
                    for m in re.finditer(r"\*\*\* (?:Update|Add|Delete) File:\s*(.+)", args["patch"]):
                        fp = m.group(1).strip()
                        if fp not in s["files"]:
                            s["files"].append(fp)
        elif t == "tool.execution_complete":
            cid = d.get("toolCallId")
            running_tools.pop(cid, None)
            if d.get("model"):
                s["model"] = d["model"]
            if not running_tools:
                s["tool"] = ""
        elif t == "permission.requested":
            rid = d.get("requestId") or "p"
            pr = d.get("permissionRequest") or {}
            detail = pr.get("fullCommandText") or pr.get("path") or pr.get("kind") or "Permission"
            pending_perm[rid] = clip(detail, 80)
        elif t == "permission.completed":
            pending_perm.pop(d.get("requestId"), None)
        elif t in ("session.usage_checkpoint", "session.shutdown"):
            td = d.get("tokenDetails") or {}
            if td:
                tok = sum((v.get("tokenCount") or 0) for v in td.values() if isinstance(v, dict))
                if tok:
                    s["tokens"] = max(s["tokens"], int(tok))

    if pending_perm:
        s["status"] = "waiting"
        s["wait_detail"] = next(iter(pending_perm.values()))
    elif in_turn or running_tools:
        s["status"] = "working"
    else:
        s["status"] = "idle"
    _copilot_cache[sdir.name] = (sig, s)
    return s


def collect_copilot(procs, copilot_pids):
    sroot = HOME / ".copilot/session-state"
    open_state = copilot_open_sessions()
    sessions = []
    if sroot.is_dir():
        dirs = sorted(
            [d for d in sroot.iterdir() if d.is_dir()],
            key=lambda x: x.stat().st_mtime,
            reverse=True,
        )[:8]
        for d in dirs:
            s = copilot_session_summary(d)
            st = open_state.get(d.name)
            if isinstance(st, dict):
                if st.get("working"):
                    if s["status"] != "waiting":
                        s["status"] = "working"
                elif s["status"] == "working" and time.time() - s["updated"] > 15:
                    s["status"] = "idle"
            sessions.append(s)

    out = []
    used_sids = set()
    now = time.time()

    # 1. Processus Copilot CLI vivants
    for pid in copilot_pids:
        p = procs[pid]
        cwd = proc_cwd(pid)
        started = BOOT + p["start"] / HZ
        match = None
        for s in sessions:
            if s["sid"] in used_sids:
                continue
            if s["cwd"] and s["cwd"] == cwd:
                match = s
                break
        if not match and len(copilot_pids) == 1 and sessions:
            # Repli sur la session la plus récente ouverte
            for s in sessions:
                if s["sid"] not in used_sids and (s["sid"] in open_state or now - s["updated"] < 3600):
                    match = s
                    break
        if match:
            used_sids.add(match["sid"])
            status = match["status"]
            # Si le processus est vivant et le fichier events.jsonl vient de bouger (<6 s), il travaille
            if status == "idle" and now - match["updated"] < 6:
                status = "working"
            out.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": "copilot",
                "surface": "cli",
                "status": status,
                "started": int(started * 1000),
                "updated": match["updated"],
                "cwd": match["cwd"] or cwd,
                "branch": match["branch"] or git_branch(match["cwd"] or cwd),
                "title": match["title"] or match["prompt"],
                "focus": "",
                "tool": match["wait_detail"] if status == "waiting" else (match["tool"] if status == "working" else ""),
                "reply": match["reply"],
                "files": len(match["files"]),
                "tokens": match["tokens"],
                "model": pretty_model(match["model"]),
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": window_of(pid, procs),
                "canStop": True,
                "alive": True,
            })
        else:
            out.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": "copilot",
                "surface": "cli",
                "status": "idle",
                "started": int(started * 1000),
                "updated": started,
                "cwd": cwd,
                "branch": git_branch(cwd),
                "title": "",
                "focus": "",
                "tool": "",
                "reply": "",
                "files": 0,
                "tokens": 0,
                "model": "",
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": window_of(pid, procs),
                "canStop": True,
                "alive": True,
            })

    # 2. Sessions Copilot récemment terminées ou actives sans PID trouvé (ex. sous-shell/IDE)
    for s in sessions:
        if s["sid"] in used_sids:
            continue
        age = now - s["updated"]
        st = open_state.get(s["sid"]) or {}
        if st.get("working") and age < 120:
            status = s["status"] if s["status"] != "idle" else "working"
        elif age < RECENT_WINDOW and not copilot_pids:
            status = "idle"
        else:
            continue
        out.append({
            "id": f"cop:{s['sid'][:8]}",
            "pid": 0,
            "kind": "copilot",
            "surface": "cli",
            "status": status,
            "started": int((s["started"] or s["updated"]) * 1000),
            "updated": s["updated"],
            "cwd": s["cwd"],
            "branch": s["branch"] or git_branch(s["cwd"]),
            "title": s["title"] or s["prompt"],
            "focus": "",
            "tool": s["wait_detail"] if status == "waiting" else (s["tool"] if status == "working" else ""),
            "reply": s["reply"],
            "files": len(s["files"]),
            "tokens": s["tokens"],
            "model": pretty_model(s["model"]),
            "subagents": 0,
            "stepDone": 0,
            "stepTotal": 0,
            "window": "",
            "canStop": False,
            "alive": False,
        })
    return out


# ───────────────────────── 4. OpenCode ─────────────────────────

_opencode_cache = (None, [])


def opencode_db_sessions():
    global _opencode_cache
    db = HOME / ".local/share/opencode/opencode.db"
    if not db.is_file():
        return []
    sig = file_sig(db)
    if _opencode_cache[0] == sig:
        return _opencode_cache[1]

    out = []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=0.4)
        con.row_factory = sqlite3.Row
        cur = con.cursor()
        # Permissions en attente par project_id
        perm_projects = set()
        try:
            for r in cur.execute("SELECT project_id FROM permission"):
                perm_projects.add(r[0])
        except sqlite3.Error:
            pass

        rows = cur.execute(
            """
            SELECT id, project_id, parent_id, slug, directory, title,
                   summary_files, tokens_input, tokens_output, tokens_reasoning,
                   agent, model, time_created, time_updated, time_busy, time_idle,
                   idle_outcome, time_archived
            FROM session_v2
            WHERE time_archived IS NULL
            ORDER BY time_updated DESC
            LIMIT 12
            """
        ).fetchall()

        # Compter sous-agents actifs par parent_id
        sub_active = {}
        now_ms = int(time.time() * 1000)
        for r in rows:
            pid_parent = r["parent_id"]
            tb, ti = r["time_busy"] or 0, r["time_idle"] or 0
            if pid_parent and tb > ti and now_ms - (r["time_updated"] or 0) < 1800_000:
                sub_active[pid_parent] = sub_active.get(pid_parent, 0) + 1

        for r in rows:
            if r["parent_id"]:
                continue
            sid = r["id"]
            tb, ti = r["time_busy"] or 0, r["time_idle"] or 0
            tu = r["time_updated"] or r["time_created"] or 0
            age_s = (now_ms - tu) / 1000.0
            is_busy = tb > ti and age_s < 1800
            is_waiting = r["project_id"] in perm_projects and is_busy
            if not is_busy and age_s > RECENT_WINDOW:
                continue

            model_raw = ""
            if r["model"]:
                try:
                    mj = json.loads(r["model"])
                    model_raw = mj.get("id") or ""
                except ValueError:
                    model_raw = str(r["model"])

            # Dernières parts (outil, réponse, fichiers)
            tool_txt, reply_txt, prompt_txt = "", "", ""
            files_set = set()
            try:
                parts = cur.execute(
                    "SELECT type, data FROM session_part WHERE session_id = ? ORDER BY time_updated DESC LIMIT 20",
                    (sid,),
                ).fetchall()
                for pt in parts:
                    try:
                        pd = json.loads(pt["data"])
                    except (ValueError, TypeError):
                        continue
                    ptype = pt["type"]
                    if ptype == "tool":
                        st = pd.get("state") or {}
                        inp = st.get("input") or {}
                        tname = pd.get("name") or "Outil"
                        if not tool_txt and (is_busy or st.get("status") in ("running", "pending")):
                            tool_txt = tool_label(tname, inp)
                        fp = inp.get("filePath") or inp.get("file_path") or inp.get("path")
                        if tname in ("edit", "write", "patch", "apply_patch") and isinstance(fp, str):
                            files_set.add(fp)
                    elif ptype == "text" and not reply_txt:
                        txt = (pd.get("text") or "").strip()
                        if txt:
                            reply_txt = clip(txt, 160)
                    elif ptype == "reasoning" and not tool_txt and is_busy:
                        tool_txt = "Réfléchit…"
                if not r["title"]:
                    um = cur.execute(
                        "SELECT data FROM session_message WHERE session_id = ? AND type = 'user' ORDER BY seq DESC LIMIT 1",
                        (sid,),
                    ).fetchone()
                    if um:
                        try:
                            prompt_txt = clip(json.loads(um[0]).get("text") or "", 120)
                        except (ValueError, TypeError):
                            pass
            except sqlite3.Error:
                pass

            tokens = (r["tokens_input"] or 0) + (r["tokens_output"] or 0) + (r["tokens_reasoning"] or 0)
            files_count = r["summary_files"] or len(files_set)
            status = "waiting" if is_waiting else ("working" if is_busy else "idle")
            out.append({
                "sid": sid,
                "cwd": r["directory"] or "",
                "title": clip(r["title"] or prompt_txt or r["slug"] or "", 60),
                "status": status,
                "tool": tool_txt if status == "working" else "",
                "reply": reply_txt,
                "model": pretty_model(model_raw),
                "files": int(files_count),
                "tokens": int(tokens),
                "subagents": sub_active.get(sid, 0),
                "started": r["time_created"] or tu,
                "updated": tu / 1000.0,
            })
        con.close()
    except sqlite3.Error:
        pass
    _opencode_cache = (sig, out)
    return out


def collect_opencode(procs, oc_pids):
    db_sessions = opencode_db_sessions()
    out = []
    used_sids = set()

    # Associer les TUI opencode vivants à leur session DB
