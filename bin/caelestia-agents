                "required": ["query"],
            },
        },
        {
            "name": "ano_tool_call",
            "description": "Appel universel de tout outil ANO-GPT supplémentaire non listé directement ci-dessus.",
            "parameters": {
                "type": "OBJECT",
                "properties": {
                    "tool_name": {"type": "STRING", "description": "Nom exact de l'outil ANO-GPT"},
                    "params_json": {"type": "STRING", "description": "Paramètres encodés en objet JSON (ex. '{\"action\": \"list\"}')"},
                },
                "required": ["tool_name"],
            },
        },
    ]


def _select_tool_declarations(prompt, hist):
    """Sélectionne les outils natifs + noyau ANO-GPT + paquets ANO-GPT pertinents pour la demande."""
    decls = _native_tool_declarations()
    native_names = {d["name"] for d in decls}
    ano_cache = _load_ano_declarations_cache()
    if not ano_cache:
        return decls

    folded = _fold_text(prompt + " " + " ".join(t.get("text") or "" for t in hist[-4:]))
    chosen = list(ANO_CORE_TOOLS)
    for pattern, tools in ANO_PACKS:
        if re.search(pattern, folded):
            for t in tools:
                if t not in chosen:
                    chosen.append(t)

    for name in chosen:
        if name in ano_cache and name not in native_names:
            decls.append(ano_cache[name])
    return decls


def load_chat_history():
    try:
        arr = json.loads(CHAT_HISTORY.read_text(encoding="utf-8"))
        return arr if isinstance(arr, list) else []
    except (OSError, ValueError):
        return []


def save_chat_history(hist):
    try:
        CHAT_HISTORY.parent.mkdir(parents=True, exist_ok=True)
        tmp = CHAT_HISTORY.with_suffix(".tmp")
        tmp.write_text(json.dumps(hist[-24:], ensure_ascii=False, indent=2), encoding="utf-8")
        tmp.replace(CHAT_HISTORY)
    except OSError:
        pass


def clear_chat_history():
    CHAT_HISTORY.unlink(missing_ok=True)


def call_gemini_tools(api_key, system_prompt, contents, tool_decls):
    """Appel REST Gemini avec vrai Function Calling natif (repli de modèles + tolérance coupures réseau)."""
    import http.client

    models = ("gemini-2.5-flash", "gemini-flash-latest", "gemini-3.1-flash-lite")
    payload = {
        "systemInstruction": {"parts": [{"text": system_prompt}]},
        "contents": contents,
        "tools": [{"functionDeclarations": tool_decls}],
        "generationConfig": {"temperature": 0.15},
    }
    raw_body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    last_err = "Gemini indisponible"
    for model in models:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        for attempt in range(2):
            req = urllib.request.Request(
                url,
                data=raw_body,
                headers={"Content-Type": "application/json", "Connection": "close"},
            )
            try:
                with urllib.request.urlopen(req, timeout=24) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                cand = data["candidates"][0]
                content = cand.get("content") or {"role": "model", "parts": []}
                return content, None
            except urllib.error.HTTPError as exc:
                try:
                    body = exc.read().decode("utf-8", errors="ignore")[:220]
                except OSError:
                    body = ""
                last_err = f"HTTP {exc.code}: {body or exc.reason}"
                if exc.code in (429, 500, 502, 503, 504) and attempt == 0:
                    time.sleep(0.6)
                    continue
                break
            except (urllib.error.URLError, http.client.HTTPException, OSError, KeyError, IndexError, ValueError, TimeoutError) as exc:
                last_err = str(exc)[:180]
                if attempt == 0:
                    time.sleep(0.5)
                    continue
                break
    return None, last_err


def _execute_commander_call(fname, args, ctx_state):
    """Exécute un functionCall de Katana AI et renvoie (ok, output_str, badge_type, badge_label)."""
    args = args if isinstance(args, dict) else {}
    agents_by_id = ctx_state["agents_by_id"]
    default_cwd = ctx_state["default_cwd"]

    if fname == "hypr_workspace":
        ok, out = tool_hypr_workspace(args.get("action") or "switch", args.get("workspace") or "")
        return ok, out, "hypr_workspace", f"Bureau · {clip(out, 55)}"

    if fname == "hypr_windows":
        ok, out = tool_hypr_windows(
            args.get("action") or "list",
            args.get("target") or "",
            args.get("workspace") or "",
            bool(args.get("follow", False)),
        )
        return ok, out, "hypr_windows", f"Fenêtres · {clip(out, 55)}"

    if fname == "shell_control":
        ok, out = tool_shell_control(args.get("action") or "", args.get("value") or "", args.get("extra") or "")
        return ok, out, "shell_control", f"Shell · {clip(out, 55)}"

    if fname == "system_control":
        ok, out = tool_system_control(args.get("action") or "state", args.get("value") or "")
        return ok, out, "system_control", f"Système · {clip(out, 55)}"

    if fname == "run_shell":
        ok, out = tool_run_shell(args.get("command") or "", args.get("cwd") or default_cwd)
        return ok, out, "run_shell", f"Shell · {clip(args.get('command') or '', 32)} ({clip(out, 36)})"

    if fname == "agent_dispatch":
        k = str(args.get("kind") or "claude").lower()
        c = str(args.get("cwd") or default_cwd or str(HOME))
        pr = clean_launch_prompt(str(args.get("prompt") or ""))
        dispatch_agent(k, c, pr)
        lbl = f"Lancé {k.upper()} · {norm_project(c)}" + (f" ({clip(pr, 36)})" if pr else "")
        return True, lbl, "dispatch", lbl

    if fname == "agent_send":
        aid = str(args.get("agent_id") or "")
        msg = str(args.get("message") or "")
        res = send_to_agent(aid, msg)
        ok = bool(res.get("ok"))
        detail = res.get("detail", "")
        return ok, f"Message vers {aid} : {detail}", "send", f"Message → {aid} ({clip(detail, 45)})"

    if fname == "agent_close":
        aid = str(args.get("agent_id") or "")
        ag = agents_by_id.get(aid)
        if not ag:
            return False, f"Agent introuvable ({aid}).", "close_agent", f"Agent introuvable ({aid})"
        ok = close_agent_window(ag)
        lbl = f"Fermé · {ag['kind']} ({ag['project']})"
        return ok, lbl if ok else f"Impossible de fermer {aid}.", "close_agent", lbl

    if fname == "agent_stop":
        aid = str(args.get("agent_id") or "")
        force = bool(args.get("force", False))
        ag = agents_by_id.get(aid)
        if not ag or not ag.get("pid"):
            return False, f"Agent sans PID arrêtable ({aid}).", "stop", f"Agent sans PID ({aid})"
        stop_agent(str(ag["pid"]), force=force)
        lbl = f"{'Tué' if force else 'Stoppé'} · {ag['kind']} ({ag['project']})"
        return True, lbl, "kill" if force else "stop", lbl

    if fname == "agent_focus":
        aid = str(args.get("agent_id") or "")
        ag = agents_by_id.get(aid)
        if not ag or not ag.get("window"):
            return False, f"Fenêtre d'agent introuvable ({aid}).", "focus", f"Fenêtre introuvable ({aid})"
        addr = ag["window"] if ag["window"].startswith("0x") else f"0x{ag['window']}"
        ok, _ = _hypr_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})', f"focuswindow address:{addr}")
        lbl = f"Focus · {ag['kind']} ({ag['project']})"
        return ok, lbl if ok else f"Échec focus {aid}.", "focus", lbl

    if fname == "agent_swarm":
        kinds = args.get("kinds") if isinstance(args.get("kinds"), list) else []
        c = str(args.get("cwd") or default_cwd or str(HOME))
        pr = clean_launch_prompt(str(args.get("prompt") or ""))
        for k in kinds[:6]:
            dispatch_agent(str(k).lower(), c, pr)
        ok = bool(kinds)
        lbl = f"Escouade ({', '.join(kinds)}) · {norm_project(c)}"
        return ok, lbl if ok else "Aucun moteur précisé.", "swarm", lbl

    if fname == "agent_permission":
        pid_perm = str(args.get("perm_id") or "")
        dec = "allow" if str(args.get("decision") or "allow") == "allow" else "deny"
        answer(pid_perm, dec)
        lbl = f"Permission {'autorisée' if dec == 'allow' else 'refusée'}"
        return True, lbl, "permission", lbl

    if fname == "agent_detail":
        aid = str(args.get("agent_id") or "")
        det = agent_detail(aid)
        summary = {
            "id": det.get("id"),
            "steps": det.get("steps", [])[:8],
            "git": det.get("gitStatus", [])[:8],
            "events": det.get("events", [])[-6:],
        }
        return True, json.dumps(summary, ensure_ascii=False), "detail", f"Inspecté · {aid}"

    if fname == "memory_save":
        ok, detail = ano_memory_save(args.get("key") or "note", args.get("value") or "", args.get("category") or "notes")
        return ok, detail, "memory_save", detail

    if fname == "memory_search":
        res_txt = ano_memory_search(args.get("query") or "")
        return True, res_txt, "memory_search", f"Mémoire · {clip(args.get('query') or '', 32)}"

    if fname == "ano_tool_call":
        tname = str(args.get("tool_name") or "").strip()
        raw_p = args.get("params_json") or "{}"
        try:
            tparams = json.loads(raw_p) if isinstance(raw_p, str) else (raw_p if isinstance(raw_p, dict) else {})
        except ValueError:
            tparams = {}
        ok, detail = call_ano_action(tname, tparams)
        return ok, detail, f"ano:{tname}", f"ANO · {tname} ({clip(detail, 52)})"

    if fname in ANO_TOOLS or fname in ANO_RELAYED:
        ok, detail = call_ano_action(fname, args)
        return ok, detail, f"ano:{fname}", f"ANO · {fname} ({clip(detail, 52)})"

    return False, f"Outil inconnu : {fname}", fname, f"Outil inconnu ({fname})"


def commander(prompt, default_cwd=""):
    """Commandant IA (Katana AI) : Function Calling natif multi-étapes, flotte agents, Hyprland, Shell et tout ANO-GPT."""
    prompt = (prompt or "").strip()
    if not prompt:
        return {"ok": False, "reply": "Écris une instruction pour le Commandant IA.", "executed": []}

    api_key = load_gemini_key()
    if not api_key:
        return {
            "ok": False,
            "reply": "Clé Gemini introuvable (configure GEMINI_API_KEY ou ~/.config/caelestia-write/config.json).",
            "executed": [],
        }

    snap = snapshot({})
    projs = list_projects()
    hist = load_chat_history()
    ano_mem = load_ano_long_term_summary()
    active_ws = _hypr_json("activeworkspace") or {}
    clients = _hypr_json("clients") or []

    ctx = {
        "default_cwd": default_cwd,
        "active_workspace": active_ws.get("id"),
        "windows": [
            {"addr": c.get("address"), "class": c.get("class"), "title": clip(c.get("title") or "", 40), "ws": (c.get("workspace") or {}).get("id")}
            for c in clients[:18]
        ],
        "agents": [
            {
                "id": a["id"], "pid": a["pid"], "kind": a["kind"], "status": a["status"],
                "project": a["project"], "cwd": a["cwd"], "title": a["title"],
                "tool": a["tool"], "model": a["model"], "files": a["files"], "window": a["window"],
            }
            for a in snap["agents"]
        ],
        "perms": [{"id": p.get("id"), "project": p.get("project"), "label": p.get("label"), "detail": p.get("detail")} for p in snap["perms"]],
        "projects": [{"name": p["name"], "cwd": p["cwd"], "branch": p["branch"]} for p in projs[:12]],
    }

    has_ano = ANO_DIR.is_dir()
    extra_ano_line = (
        f"3) Toutes les actions et la mémoire partagée d'ANO-GPT (apps, réglages, musique, YouTube, navigateur, fichiers, web, météo, rappels, mails, agenda, GitHub, téléphone, vision écran…).\n"
        f"Liste complète des outils ANO-GPT accessibles aussi via `ano_tool_call` : {', '.join(sorted(set(ANO_TOOLS) | set(ANO_RELAYED)))}.\n\n"
        if has_ano
        else "3) Contrôle système complet autonome via `system_control` (état PC, volume, luminosité, Wi-Fi, Bluetooth, média, apps, météo, notifications) et `run_shell`.\n\n"
    )
    system = (
        "Tu es Katana AI, le Commandant IA omnipotent d'Agent OS sur Arch Linux / Hyprland.\n"
        "Tu as le contrôle COMPLET de :\n"
        "1) Tous les agents IA (agy, antigravity, claude, codex, copilot, opencode, gemini, aider) : lancer, parler en direct, inspecter, focus, stopper, fermer, escouade, permissions.\n"
        "2) Tout Hyprland et le shell Caelestia / Ano Shell : changer de bureau (`hypr_workspace`), gérer les fenêtres (`hypr_windows`), piloter les panneaux/réglages/verre/minuteur/focus (`shell_control`), réglages rapides (`system_control`), exécuter toute commande sûre (`run_shell`).\n"
        f"{extra_ano_line}"
        f"MÉMOIRE LONG TERME :\n{ano_mem or '(aucune entrée)'}\n\n"
        "RÈGLES IMPÉRATIVES :\n"
        "- AGIS VRAIMENT via les outils mis à ta disposition. Ne prétends JAMAIS avoir fait une action sans l'avoir exécutée et vérifiée.\n"
        "- Pour changer de bureau (« va sur le bureau 2 », « bureau suivant »), appelle TOUJOURS `hypr_workspace(action='switch', workspace='2')`.\n"
        "- Pour déplacer/fermer/focus une fenêtre, appelle `hypr_windows`. Pour organiser tous les bureaux, `hypr_windows(action='organize')` ou `hypr_orchestrator`.\n"
        "- Pour connaître l'état réel du PC (volume, batterie, Wi-Fi, Bluetooth, audio, luminosité, RAM), appelle `system_state` ou `system_control(action='state')`.\n"
        "- Si un outil échoue (`ok: false`), analyse l'erreur et essaie immédiatement une approche alternative fiable (`hypr_workspace`, `hypr_windows`, `system_control`, `run_shell` ou le bon outil ANO-GPT) avant de répondre.\n"
        "- Simple lancement d'agent sans tâche (« ouvre codex ») → `agent_dispatch` avec `prompt=''` (CHAÎNE VIDE).\n"
        "- Utilise l'historique pour résoudre les pronoms (« ferme-le », « renvoie-le sur le bureau 2 »).\n"
        "- Réponds en français, court, clair et 100 % factuel d'après les résultats réels des outils."
    )

    contents = []
    for turn in hist[-12:]:
        role = "user" if turn.get("role") == "user" else "model"
        txt = turn.get("text") or ""
        if role == "model" and turn.get("executed"):
            acts_txt = "; ".join(f"{'OK' if e.get('ok') else 'ERR'}: {e.get('label')}" for e in turn["executed"])
            txt = f"{txt}\n[Actions exécutées : {acts_txt}]"
        if txt:
            contents.append({"role": role, "parts": [{"text": txt}]})

    user_turn_txt = f"État en direct :\n{json.dumps(ctx, ensure_ascii=False)}\n\nMessage de l'utilisateur :\n{prompt}"
    contents.append({"role": "user", "parts": [{"text": user_turn_txt}]})

    tool_decls = _select_tool_declarations(prompt, hist)
    ctx_state = {"agents_by_id": {a["id"]: a for a in snap["agents"]}, "default_cwd": default_cwd}
    executed = []
    reply = ""
    deadline = time.monotonic() + 75.0

    for _round in range(5):
        if time.monotonic() > deadline:
            reply = reply or "Délai maximal atteint après les actions exécutées."
            break
        model_content, err = call_gemini_tools(api_key, system, contents, tool_decls)
        if not model_content:
            if executed:
                reply = f"Actions exécutées, mais synthèse interrompue ({err})."
                break
            return {"ok": False, "reply": f"Erreur Commandant IA : {err}", "executed": executed}

        parts = model_content.get("parts") or []
        fcalls = [p["functionCall"] for p in parts if isinstance(p, dict) and "functionCall" in p]
        text_parts = [str(p.get("text") or "").strip() for p in parts if isinstance(p, dict) and p.get("text") and not p.get("thought")]
        if text_parts:
            reply = "\n".join(text_parts)

        if not fcalls:
            break

        # Conserver le tour exact du modèle (y compris thoughtSignature pour Gemini 2.5/3.x)
        contents.append(model_content)
        resp_parts = []
        for fc in fcalls[:8]:
            fname = str(fc.get("name") or "")
            fargs = fc.get("args") if isinstance(fc.get("args"), dict) else {}
            try:
                ok, out, btype, blabel = _execute_commander_call(fname, fargs, ctx_state)
            except SystemExit:
                ok, out, btype, blabel = False, f"Échec {fname}", fname, f"Échec {fname}"
            except Exception as exc:  # noqa: BLE001
                ok, out, btype, blabel = False, clip(str(exc), 220), fname, f"Erreur {fname}"
            executed.append({"type": btype, "ok": bool(ok), "label": blabel})
            resp_parts.append({
                "functionResponse": {
                    "name": fname,
                    "response": {"ok": bool(ok), "result": clip(out, 1200)},
                }
            })
        contents.append({"role": "user", "parts": resp_parts})

    if not reply:
        if executed:
            ok_n = sum(1 for e in executed if e.get("ok"))
            reply = f"{ok_n}/{len(executed)} action(s) exécutée(s)."
        else:
            reply = "Aucune action nécessaire."

    hist.append({"role": "user", "text": prompt, "executed": [], "ts": int(time.time() * 1000)})
    hist.append({"role": "ai", "text": reply, "executed": executed, "ts": int(time.time() * 1000)})
    save_chat_history(hist)

    return {"ok": True, "reply": reply, "executed": executed}


def launch_agent(kind):
    dispatch_agent(kind, "", "")


def list_projects():
    """Découvre automatiquement les projets récents (agents actifs, bases de sessions et dossiers git)."""
    seen = {}

    def add(path, source, active=False):
        if not path:
            return
        p = str(path).rstrip("/")
        if not p or p == str(HOME) or not os.path.isdir(p):
            return
        cur = seen.get(p)
        if cur:
            cur["active"] = cur["active"] or active
            return
        seen[p] = {
            "cwd": p,
            "name": os.path.basename(p) or p,
            "branch": git_branch(p),
            "source": source,
            "active": active,
        }

    # 1. Agents actifs / récents
    snap = snapshot({})
    for a in snap["agents"]:
        add(a.get("cwd"), a.get("kind") or "agent", active=a.get("status") != "idle")

    # 2. Projets OpenCode
    ocdb = HOME / ".local/share/opencode/opencode.db"
    if ocdb.is_file():
        try:
            con = sqlite3.connect(f"file:{ocdb}?mode=ro", uri=True, timeout=0.3)
            for (d,) in con.execute("SELECT DISTINCT directory FROM session_v2 WHERE directory IS NOT NULL ORDER BY time_updated DESC LIMIT 10"):
                add(d, "opencode")
            con.close()
        except sqlite3.Error:
            pass

    # 3. Projets Antigravity
    agdb = HOME / ".gemini/antigravity/conversation_summaries.db"
    if agdb.is_file():
        try:
            con = sqlite3.connect(f"file:{agdb}?mode=ro", uri=True, timeout=0.3)
            for (u,) in con.execute("SELECT workspace_uris FROM conversation_summaries WHERE workspace_uris != '' ORDER BY last_modified_time DESC LIMIT 15"):
                add(ag_decode_workspace(u), "antigravity")
            con.close()
        except sqlite3.Error:
            pass

    # 4. Projets Copilot
    copdb = HOME / ".copilot/session-store.db"
    if copdb.is_file():
        try:
            con = sqlite3.connect(f"file:{copdb}?mode=ro", uri=True, timeout=0.3)
            for (d,) in con.execute("SELECT DISTINCT cwd FROM sessions WHERE cwd IS NOT NULL ORDER BY updated_at DESC LIMIT 10"):
                add(d, "copilot")
            con.close()
        except sqlite3.Error:
            pass

    # 5. Dossiers de développement courants
    for base in (HOME / "development", HOME / "OUTILS", HOME / "Documents/MES_PROJETS", HOME / "Documents/MES_PROJETS/FLUTTER PROJETS", HOME / "Documents/MES_PROJETS/MES_APPLIS"):
        if not base.is_dir():
            continue
        try:
            entries = sorted(base.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:10]
            for e in entries:
                if e.is_dir() and not e.name.startswith(".") and ((e / ".git").exists() or (e / "package.json").exists() or (e / "pubspec.yaml").exists() or (e / "pyproject.toml").exists()):
                    add(str(e), "disk")
        except OSError:
            pass

    res = sorted(seen.values(), key=lambda x: (not x["active"], x["source"] == "disk", x["name"].lower()))
    return res[:18]


def git_short_status(cwd):
    if not cwd or not os.path.isdir(cwd):
        return []
    try:
        res = subprocess.run(
            ["git", "-C", cwd, "status", "--short", "--untracked-files=normal"],
            capture_output=True, text=True, timeout=1.2, check=False,
        )
        if res.returncode != 0:
            return []
        lines = [ln for ln in res.stdout.splitlines() if ln.strip()][:12]
        return lines
    except (OSError, subprocess.TimeoutExpired):
        return []


def agent_detail(agent_id):
    """Retourne la timeline détaillée, les étapes et le statut git d'un agent pour l'inspecteur Agent OS."""
    snap = snapshot({})
    target = next((a for a in snap["agents"] if a["id"] == agent_id), None)
    events = []
    steps = []
    cwd = target["cwd"] if target else ""
    kind = target["kind"] if target else ""

    if target and kind in ("antigravity", "agy"):
        prefix = agent_id.split(":", 1)[-1]
        brain = HOME / ".gemini/antigravity/brain"
        if brain.is_dir():
            for d in brain.iterdir():
                if d.is_dir() and d.name.startswith(prefix):
                    tr = d / ".system_generated/logs/transcript.jsonl"
                    for line in tail_lines(tr, size=160 * 1024):
                        ltype = line.get("type")
                        if ltype == "USER_INPUT":
                            txt = line.get("content") or ""
                            m = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", txt, re.DOTALL)
                            if m:
                                txt = m.group(1)
                            events.append({"kind": "user", "text": clip(txt, 140)})
                        elif ltype == "PLANNER_RESPONSE":
                            for tc in line.get("tool_calls") or []:
                                if not isinstance(tc, dict):
                                    continue
                                tn = tc.get("name") or ""
                                args = tc.get("args") if isinstance(tc.get("args"), dict) else {}
                                if tn == "update_steps":
                                    rs = args.get("steps")
                                    if isinstance(rs, str):
                                        try:
                                            rs = json.loads(rs)
                                        except ValueError:
                                            rs = None
                                    if isinstance(rs, list):
                                        steps = [{"title": clip(x.get("title", ""), 60), "status": x.get("status", "pending")} for x in rs if isinstance(x, dict)]
                                elif tn == "update_focus":
                                    fv = str(args.get("focus") or "").strip().strip('"')
                                    if fv:
                                        events.append({"kind": "focus", "text": clip(fv, 110)})
                                else:
                                    events.append({"kind": "tool", "text": tool_label(tn, args)})
                            if (line.get("content") or "").strip():
                                events.append({"kind": "reply", "text": clip(line["content"], 160)})
                    break
    elif target and kind == "codex":
        for f, _ in sorted(codex_files(), key=lambda x: x[1], reverse=True):
            m = (first_line(f) or {}).get("payload") or {}
            if m.get("cwd") == cwd:
                for line in tail_lines(f, size=140 * 1024):
                    p = line.get("payload") or {}
                    lt = line.get("type")
                    if lt == "response_item" and p.get("type") == "function_call":
                        try:
                            args = json.loads(p.get("arguments") or "{}")
                        except ValueError:
                            args = {}
                        events.append({"kind": "tool", "text": tool_label(p.get("name") or "Outil", args)})
                    elif lt == "event_msg" and p.get("type") == "item_completed":
                        item = p.get("item") or {}
                        it = item.get("type")
                        if it == "AgentMessage":
                            txts = [c.get("text") for c in item.get("content") or [] if isinstance(c, dict) and c.get("text")]
                            if txts:
                                events.append({"kind": "reply", "text": clip(txts[0], 160)})
                        elif it == "FileChange":
                            for fp in (item.get("changes") or {}):
                                events.append({"kind": "file", "text": f"Modifié · {os.path.basename(fp)}"})
                break
    elif target and kind == "claude":
        try:
            meta = json.loads((HOME / f".claude/sessions/{target['pid']}.json").read_text())
            tr = claude_transcript(meta.get("sessionId") or "")
            if tr:
                for line in tail_lines(tr, size=140 * 1024):
                    kt = line.get("type")
                    if kt in ("user", "assistant") and not line.get("isSidechain"):
                        msg = line.get("message") or {}
                        content = msg.get("content")
                        if kt == "user" and isinstance(content, str) and not content.startswith("<"):
                            events.append({"kind": "user", "text": clip(content, 140)})
                        elif kt == "assistant" and isinstance(content, list):
                            for b in content:
                                if not isinstance(b, dict):
                                    continue
                                if b.get("type") == "tool_use":
                                    events.append({"kind": "tool", "text": tool_label(b.get("name"), b.get("input"))})
                                elif b.get("type") == "text" and (b.get("text") or "").strip():
                                    events.append({"kind": "reply", "text": clip(b["text"], 160)})
        except (OSError, ValueError):
            pass
    elif target and kind == "copilot":
        sroot = HOME / ".copilot/session-state"
        if sroot.is_dir():
            for d in sorted(sroot.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:6]:
                ws = parse_simple_yaml(d / "workspace.yaml")
                if ws.get("cwd") == cwd or agent_id.endswith(d.name[:8]):
                    for line in tail_lines(d / "events.jsonl", size=140 * 1024):
                        t = line.get("type")
                        dat = line.get("data") or {}
                        if t == "user.message" and dat.get("content"):
                            events.append({"kind": "user", "text": clip(dat["content"], 140)})
                        elif t == "tool.execution_start":
                            args = dat.get("arguments")
                            if isinstance(args, str):
                                try:
                                    args = json.loads(args)
                                except ValueError:
                                    args = {"patch": args} if "Begin Patch" in args else {"command": args}
                            events.append({"kind": "tool", "text": tool_label(dat.get("toolName"), args if isinstance(args, dict) else {})})
                        elif t == "assistant.message" and (dat.get("content") or "").strip():
                            events.append({"kind": "reply", "text": clip(dat["content"], 160)})
                    break
    elif target and kind == "opencode":
        ocdb = HOME / ".local/share/opencode/opencode.db"
        if ocdb.is_file():
            try:
                con = sqlite3.connect(f"file:{ocdb}?mode=ro", uri=True, timeout=0.4)
                prefix = agent_id.split(":", 1)[-1]
                row = con.execute("SELECT id FROM session_v2 WHERE id LIKE ? ORDER BY time_updated DESC LIMIT 1", (f"{prefix}%",)).fetchone()
                if row:
                    parts = con.execute("SELECT type, data FROM session_part WHERE session_id = ? ORDER BY time_updated DESC LIMIT 18", (row[0],)).fetchall()
                    for ptype, raw in reversed(parts):
                        try:
                            pd = json.loads(raw)
                        except (ValueError, TypeError):
                            continue
                        if ptype == "tool":
                            st = pd.get("state") or {}
                            events.append({"kind": "tool", "text": tool_label(pd.get("name"), st.get("input"))})
                        elif ptype == "text" and (pd.get("text") or "").strip():
                            events.append({"kind": "reply", "text": clip(pd["text"], 160)})
                        elif ptype == "reasoning" and (pd.get("text") or "").strip():
                            events.append({"kind": "focus", "text": clip(pd["text"], 110)})
                con.close()
            except sqlite3.Error:
                pass

    return {
        "id": agent_id,
        "events": events[-14:],
        "steps": steps,
        "gitStatus": git_short_status(cwd),
    }


# ───────────────────────── hook PermissionRequest ─────────────────────────

def island_running():
    try:
        res = subprocess.run(["pgrep", "-f", "qs -c (caelestia|ano-shell)"], capture_output=True, timeout=2, check=False)
        return res.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def agent_pid():
    cur = os.getppid()
    for _ in range(12):
        p = read_proc(cur)
        if not p:
            break
        if agent_of(p) == "claude":
            return cur
        cur = p["ppid"]
    return os.getppid()


def perm_detail(tool, inp):
    inp = inp if isinstance(inp, dict) else {}
    if tool == "Bash":
        return inp.get("command") or ""
    if tool in ("Edit", "Write", "MultiEdit", "Read", "NotebookEdit"):
        return inp.get("file_path") or inp.get("notebook_path") or ""
    for k in ("url", "query", "pattern", "path", "prompt", "description"):
        if isinstance(inp.get(k), str):
            return inp[k]
    return clip(json.dumps(inp, ensure_ascii=False), 300)


def hook():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if data.get("hook_event_name") != "PermissionRequest" or not island_running():
        return
    PERMS.mkdir(parents=True, exist_ok=True)
    rid = uuid.uuid4().hex[:12]
    req, ans = PERMS / f"{rid}.json", PERMS / f"{rid}.answer"

    def cleanup(*_):
        req.unlink(missing_ok=True)
        ans.unlink(missing_ok=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGHUP, cleanup)
    tool = data.get("tool_name") or "Outil"
    cwd = data.get("cwd") or os.getcwd()
    info = {
        "id": rid,
        "hookPid": os.getpid(),
        "agentPid": agent_pid(),
        "session": data.get("session_id") or "",
        "project": os.path.basename(cwd.rstrip("/")) or "~",
        "tool": tool,
        "label": tool_label(tool, data.get("tool_input")).split(" · ")[0],
        "detail": clip(perm_detail(tool, data.get("tool_input")), 400),
        "ts": int(time.time() * 1000),
    }
    tmp = req.with_suffix(".tmp")
    tmp.write_text(json.dumps(info, ensure_ascii=False))
    tmp.rename(req)
    answer = ""
    try:
        end = time.time() + WAIT
        while time.time() < end:
            if ans.exists():
                answer = ans.read_text().strip()
                break
            time.sleep(0.15)
    finally:
        req.unlink(missing_ok=True)
        ans.unlink(missing_ok=True)
    if answer in ("allow", "deny"):
        decision = {"behavior": answer}
        if answer == "deny":
            decision["message"] = "Refusé depuis l'île par l'utilisateur."
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))


def answer(rid, decision):
    if not rid.isalnum() or decision not in ("allow", "deny", "terminal"):
        sys.exit(2)
    if (PERMS / f"{rid}.json").exists():
        (PERMS / f"{rid}.answer").write_text(decision)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "watch":
        watch()
    elif cmd == "hook":
        hook()
    elif cmd == "answer" and len(sys.argv) == 4:
        answer(sys.argv[2], sys.argv[3])
    elif cmd == "stop" and len(sys.argv) == 3:
        stop_agent(sys.argv[2], force=False)
    elif cmd == "kill" and len(sys.argv) == 3:
        stop_agent(sys.argv[2], force=True)
    elif cmd == "launch" and len(sys.argv) == 3:
        launch_agent(sys.argv[2])
    elif cmd == "dispatch" and len(sys.argv) >= 4:
        dispatch_agent(sys.argv[2], sys.argv[3], " ".join(sys.argv[4:]))
    elif cmd == "send" and len(sys.argv) >= 4:
        print(json.dumps(send_to_agent(sys.argv[2], " ".join(sys.argv[3:])), ensure_ascii=False))
    elif cmd == "commander" and len(sys.argv) >= 3:
        cwd_arg = ""
        args = sys.argv[2:]
        if len(args) >= 2 and args[0] == "--cwd":
            cwd_arg = args[1]
            args = args[2:]
        print(json.dumps(commander(" ".join(args), default_cwd=cwd_arg), ensure_ascii=False))
    elif cmd == "history":
        print(json.dumps(load_chat_history(), ensure_ascii=False))
    elif cmd == "history-clear":
        clear_chat_history()
        print("[]")
    elif cmd == "terminal" and len(sys.argv) >= 2:
        open_terminal(sys.argv[2] if len(sys.argv) > 2 else "")
    elif cmd == "projects":
        print(json.dumps(list_projects(), ensure_ascii=False))
    elif cmd == "detail" and len(sys.argv) == 3:
        print(json.dumps(agent_detail(sys.argv[2]), ensure_ascii=False))
    elif cmd == "once":
        print(json.dumps(snapshot({}), ensure_ascii=False, indent=2))
    else:
        print(__doc__)
        sys.exit(2)
