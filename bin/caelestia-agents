                "branch": git_branch(match["cwd"] or cwd),
                "title": match["title"],
                "focus": "",
                "tool": match["tool"],
                "reply": match["reply"],
                "files": match["files"],
                "tokens": match["tokens"],
                "model": match["model"],
                "subagents": match["subagents"],
                "stepDone": 0,
                "stepTotal": 0,
                "window": win,
                "canStop": True,
                "alive": True,
            })
        else:
            out.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": "opencode",
                "surface": "cli",
                "status": "idle",
                "started": int(started * 1000),
                "updated": started,
                "cwd": cwd,
                "branch": git_branch(cwd),
                "title": "",
                "focus": "",
                "tool": "",
                "reply": "",
                "files": 0,
                "tokens": 0,
                "model": "",
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": win,
                "canStop": True,
                "alive": True,
            })

    # Sessions OpenCode actives ou récentes pilotées via opencode serve (ou récemment fermées)
    for s in db_sessions:
        if s["sid"] in used_sids:
            continue
        out.append({
            "id": f"oc:{s['sid'][:10]}",
            "pid": 0,
            "kind": "opencode",
            "surface": "cli",
            "status": s["status"],
            "started": int(s["started"]),
            "updated": s["updated"],
            "cwd": s["cwd"],
            "branch": git_branch(s["cwd"]),
            "title": s["title"],
            "focus": "",
            "tool": s["tool"],
            "reply": s["reply"],
            "files": s["files"],
            "tokens": s["tokens"],
            "model": s["model"],
            "subagents": s["subagents"],
            "stepDone": 0,
            "stepTotal": 0,
            "window": "",
            "canStop": False,
            "alive": s["status"] != "idle",
        })
    return out


# ───────────────────────── 5. Antigravity App & AGY CLI ─────────────────────────

_ag_db_cache = (None, [])
_ag_tr_cache = {}


def ag_transcript_summary(conv_id):
    tr = HOME / f".gemini/antigravity/brain/{conv_id}/.system_generated/logs/transcript.jsonl"
    s = {
        "model": "", "tool": "", "focus": "", "reply": "", "prompt": "",
        "files": [], "tokens": 0, "stepDone": 0, "stepTotal": 0,
    }
    if not tr.is_file():
        return s
    sig = file_sig(tr)
    hit = _ag_tr_cache.get(conv_id)
    if hit and hit[0] == sig:
        return hit[1]

    for line in tail_lines(tr, size=128 * 1024):
        ltype = line.get("type")
        if ltype == "USER_INPUT":
            txt = line.get("content") or ""
            m = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", txt, re.DOTALL)
            if m:
                txt = m.group(1)
            s["prompt"] = clip(txt, 120)
        elif ltype == "PLANNER_RESPONSE":
            if line.get("model"):
                s["model"] = line["model"]
            tok = (line.get("input_tokens") or 0) + (line.get("cache_read_tokens") or 0) + (line.get("output_tokens") or 0)
            if tok:
                s["tokens"] = max(s["tokens"], int(tok))
            if (line.get("content") or "").strip():
                s["reply"] = clip(line["content"], 160)
                s["tool"] = ""
            tcalls = line.get("tool_calls") or []
            for tc in tcalls:
                if not isinstance(tc, dict):
                    continue
                tname = tc.get("name") or ""
                args = tc.get("args") or {}
                if not isinstance(args, dict):
                    args = {}
                if tname == "update_focus":
                    fv = args.get("focus")
                    if isinstance(fv, str):
                        s["focus"] = clip(fv.strip().strip('"'), 70)
                elif tname == "update_steps":
                    raw_steps = args.get("steps")
                    if isinstance(raw_steps, str):
                        try:
                            raw_steps = json.loads(raw_steps)
                        except ValueError:
                            raw_steps = None
                    if isinstance(raw_steps, list) and raw_steps:
                        s["stepTotal"] = len(raw_steps)
                        s["stepDone"] = sum(1 for st in raw_steps if isinstance(st, dict) and st.get("status") == "done")
                else:
                    s["tool"] = tool_label(tname, args)
                    if tname in ("edit_file", "write_file", "replace_file_content", "multi_replace_file_content", "write_to_file"):
                        fp = args.get("Path") or args.get("TargetFile") or args.get("file_path")
                        if isinstance(fp, str):
                            fp = fp.strip().strip('"')
                            if fp and fp not in s["files"]:
                                s["files"].append(fp)
    _ag_tr_cache[conv_id] = (sig, s)
    return s


def ag_decode_workspace(uris_raw):
    if not uris_raw:
        return ""
    try:
        arr = json.loads(uris_raw)
        if isinstance(arr, list) and arr:
            u = str(arr[0])
            if u.startswith("file://"):
                return urllib.parse.unquote(u[7:])
            return u
    except ValueError:
        pass
    return ""


def ag_db_conversations():
    global _ag_db_cache
    db = HOME / ".gemini/antigravity/conversation_summaries.db"
    if not db.is_file():
        return []
    sig = file_sig(db)
    if _ag_db_cache[0] == sig:
        return _ag_db_cache[1]

    rows_out = []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=0.4)
        con.row_factory = sqlite3.Row
        rows = con.execute(
            """
            SELECT conversation_id, title, preview, step_count, last_modified_time,
                   workspace_uris, status, source, parent_conversation_id,
                   nesting_depth, not_fully_idle, killed, last_user_input_time
            FROM conversation_summaries
            WHERE killed = 0
            ORDER BY last_modified_time DESC
            LIMIT 25
            """
        ).fetchall()
        con.close()

        # Compter les sous-agents en cours pour chaque parent
        sub_running = {}
        for r in rows:
            parent = r["parent_conversation_id"]
            if parent and "RUNNING" in (r["status"] or ""):
                sub_running[parent] = sub_running.get(parent, 0) + 1

        now = time.time()
        for r in rows:
            if (r["nesting_depth"] or 0) > 0 or r["parent_conversation_id"]:
                continue
            mod_ts = parse_iso_ts(r["last_modified_time"])
            age = now - mod_ts if mod_ts else 999999
            raw_st = (r["status"] or "").upper()
            is_running = "RUNNING" in raw_st
            is_waiting = any(k in raw_st for k in ("WAIT", "APPROV", "CONFIRM", "INPUT"))
            if not is_running and not is_waiting and age > RECENT_WINDOW:
                continue
            # Sécurité contre une conversation figée "RUNNING" d'un vieux crash (>30 min sans modif)
            if is_running and age > 1800:
                is_running = False
                if age > RECENT_WINDOW:
                    continue
            cid = r["conversation_id"]
            is_cli = "CLI" in (r["source"] or "").upper()
            rows_out.append({
                "cid": cid,
                "is_cli": is_cli,
                "title": clip(r["title"] or r["preview"] or "", 60),
                "cwd": ag_decode_workspace(r["workspace_uris"]),
                "status": "waiting" if is_waiting else ("working" if is_running else "idle"),
                "updated": mod_ts or now,
                "started": parse_iso_ts(r["last_user_input_time"]) or mod_ts or now,
                "subagents": sub_running.get(cid, 0),
                "steps": int(r["step_count"] or 0),
            })
    except sqlite3.Error:
        pass
    _ag_db_cache = (sig, rows_out)
    return rows_out


def collect_antigravity(procs, app_pids, agy_pids):
    convs = ag_db_conversations()
    app_running = bool(app_pids) or any(
        p["comm"] == "language_server" for p in procs.values()
    )
    app_win = window_of(app_pids[0], procs, fallback_class="antigravity") if app_pids else window_of(0, procs, fallback_class="antigravity")
    out = []
    used_cids = set()

    # 1. Processus agy CLI vivants
    for pid in agy_pids:
        p = procs[pid]
        cwd = proc_cwd(pid)
        started = BOOT + p["start"] / HZ
        win = window_of(pid, procs)
        match = None
        for c in convs:
            if c["cid"] in used_cids:
                continue
            if c["is_cli"] and (not c["cwd"] or c["cwd"] == cwd):
                match = c
                break
        if match:
            used_cids.add(match["cid"])
            tr = ag_transcript_summary(match["cid"])
            out.append({
                "id": f"agy:{match['cid'][:8]}",
                "pid": pid,
                "kind": "agy",
                "surface": "cli",
                "status": match["status"],
                "started": int(started * 1000),
                "updated": match["updated"],
                "cwd": match["cwd"] or cwd,
                "branch": git_branch(match["cwd"] or cwd),
                "title": match["title"] or tr["prompt"],
                "focus": tr["focus"] if match["status"] == "working" else "",
                "tool": (tr["focus"] or tr["tool"]) if match["status"] == "working" else "",
                "reply": tr["reply"],
                "files": len(tr["files"]),
                "tokens": tr["tokens"],
                "model": pretty_model(tr["model"]),
                "subagents": match["subagents"],
                "stepDone": tr["stepDone"],
                "stepTotal": tr["stepTotal"],
                "window": win,
                "canStop": True,
                "alive": True,
            })
        else:
            out.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": "agy",
                "surface": "cli",
                "status": "idle",
                "started": int(started * 1000),
                "updated": started,
                "cwd": cwd,
                "branch": git_branch(cwd),
                "title": "",
                "focus": "",
                "tool": "",
                "reply": "",
                "files": 0,
                "tokens": 0,
                "model": "",
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": win,
                "canStop": True,
                "alive": True,
            })

    # 2. Conversations Antigravity App (Hub/IDE) et sessions CLI récentes
    for c in convs:
        if c["cid"] in used_cids:
            continue
        if not c["is_cli"] and not app_running and c["status"] == "idle":
            continue
        tr = ag_transcript_summary(c["cid"])
        kind = "agy" if c["is_cli"] else "antigravity"
        cwd = c["cwd"]
        out.append({
            "id": f"ag:{c['cid'][:8]}",
            "pid": app_pids[0] if (not c["is_cli"] and app_pids) else 0,
            "kind": kind,
            "surface": "cli" if c["is_cli"] else "app",
            "status": c["status"],
            "started": int(c["started"] * 1000),
            "updated": c["updated"],
            "cwd": cwd,
            "branch": git_branch(cwd),
            "title": c["title"] or tr["prompt"],
            "focus": tr["focus"] if c["status"] == "working" else "",
            "tool": (tr["focus"] or tr["tool"]) if c["status"] == "working" else "",
            "reply": tr["reply"],
            "files": len(tr["files"]),
            "tokens": tr["tokens"],
            "model": pretty_model(tr["model"]),
            "subagents": c["subagents"],
            "stepDone": tr["stepDone"],
            "stepTotal": tr["stepTotal"],
            "window": "" if c["is_cli"] else app_win,
            "canStop": False,
            "alive": (not c["is_cli"] and app_running) or c["status"] != "idle",
        })
    return out


# ───────────────────────── 6. Demandes de permission ─────────────────────────

def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def pending_perms():
    out = []
    if not PERMS.is_dir():
        return out
    for f in sorted(PERMS.glob("*.json")):
        try:
            p = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if (PERMS / f"{p.get('id')}.answer").exists():
            continue
        if not pid_alive(p.get("hookPid")):
            f.unlink(missing_ok=True)
            continue
        out.append(p)
    return out


# ───────────────────────── snapshot & watch ─────────────────────────

_cpu_prev = {}  # pid -> (ts, ticks)


def cpu_active(p):
    """Heuristique CPU légère pour les agents sans transcript structuré (gemini/aider)."""
    pid = p["pid"]
    ticks = p["utime"] + p["stime"]
    now = time.time()
    prev = _cpu_prev.get(pid)
    _cpu_prev[pid] = (now, ticks)
    if not prev or now - prev[0] <= 0.1:
        return False
    rate = (ticks - prev[1]) / max(0.2, now - prev[0])
    return rate > 8.0


def snapshot(state):
    procs, roots = scan()
    perms = pending_perms()
    perm_pids = {p.get("agentPid") for p in perms}

    by_kind = {}
    for pid, kind in roots:
        by_kind.setdefault(kind, []).append(pid)

    raw_agents = []

    # 1. Claude Code
    for pid in by_kind.get("claude", []):
        p = procs[pid]
        started = BOOT + p["start"] / HZ
        cwd = proc_cwd(pid)
        try:
            meta = json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
        except (OSError, ValueError):
            meta = {}
        cwd = meta.get("cwd") or cwd
        raw = meta.get("status")
        status = "working" if raw == "busy" else "idle" if raw in ("idle", None) else "waiting"
        if pid in perm_pids:
            status = "waiting"
        s = claude_summary(meta.get("sessionId") or "")
        name = meta.get("name") or ""
        raw_agents.append({
            "id": f"pid:{pid}",
            "pid": pid,
            "kind": "claude",
            "surface": "cli",
            "status": status,
            "started": int(started * 1000),
            "statusUpdatedAt": meta.get("statusUpdatedAt") or 0,
            "cwd": cwd,
            "branch": git_branch(cwd),
            "title": s["title"] or s["prompt"] or name,
            "focus": "",
            "tool": s["tool"] if status == "working" else "",
            "reply": s["reply"],
            "files": len(s["files"]),
            "tokens": s["tokens"],
            "model": pretty_model(s["model"]),
            "subagents": s["subagents"],
            "stepDone": 0,
            "stepTotal": 0,
            "window": window_of(pid, procs),
            "canStop": True,
            "alive": True,
        })

    # 2. Codex
    codex_pids = by_kind.get("codex", [])
    if codex_pids:
        titles = codex_titles()
        cfiles = codex_files()
        for pid in codex_pids:
            p = procs[pid]
            started = BOOT + p["start"] / HZ
            cwd = proc_cwd(pid)
            best = None
            for f, mt in cfiles:
                if mt < started - 5:
                    continue
                m = (first_line(f) or {}).get("payload") or {}
                if m.get("cwd") == cwd and (best is None or mt > best[1]):
                    best = (f, mt)
            s = codex_summary(best[0], titles) if best else {
                "title": "", "tool": "", "reply": "", "prompt": "",
                "files": [], "model": "", "busy": None, "tokens": 0,
            }
            if s.get("busy") is None and best:
                s["busy"] = codex_busy(best[0])
            status = "idle"
            if s.get("busy") is not None:
                status = "working" if s["busy"] else "idle"
            elif best and time.time() - best[1] < 8:
                status = "working"
            raw_agents.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": "codex",
                "surface": "cli",
                "status": status,
                "started": int(started * 1000),
                "cwd": cwd,
                "branch": git_branch(cwd),
                "title": s["title"] or s["prompt"],
                "focus": "",
                "tool": s["tool"] if status == "working" else "",
                "reply": s["reply"],
                "files": len(s["files"]),
                "tokens": s["tokens"],
                "model": pretty_model(s["model"]),
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": window_of(pid, procs),
                "canStop": True,
                "alive": True,
            })

    # 3. GitHub Copilot CLI
    raw_agents.extend(collect_copilot(procs, by_kind.get("copilot", [])))

    # 4. OpenCode (CLI + serve)
    raw_agents.extend(collect_opencode(procs, by_kind.get("opencode", [])))

    # 5. Antigravity App & AGY CLI
    raw_agents.extend(collect_antigravity(procs, by_kind.get("antigravity", []), by_kind.get("agy", [])))

    # 6. Gemini CLI & Aider
    for kind in ("gemini", "aider"):
        for pid in by_kind.get(kind, []):
            p = procs[pid]
            started = BOOT + p["start"] / HZ
            cwd = proc_cwd(pid)
            status = "working" if cpu_active(p) else "idle"
            raw_agents.append({
                "id": f"pid:{pid}",
                "pid": pid,
                "kind": kind,
                "surface": "cli",
                "status": status,
                "started": int(started * 1000),
                "cwd": cwd,
                "branch": git_branch(cwd),
                "title": "",
                "focus": "",
                "tool": "Exécution…" if status == "working" else "",
                "reply": "",
                "files": 0,
                "tokens": 0,
                "model": "",
                "subagents": 0,
                "stepDone": 0,
                "stepTotal": 0,
                "window": window_of(pid, procs),
                "canStop": True,
                "alive": True,
            })

    # Normalisation des timestamps `since` et nettoyage de l'état
    now = time.time()
    agents = []
    seen_ids = set()
    for a in raw_agents:
        aid = a["id"]
        if aid in seen_ids:
            continue
        seen_ids.add(aid)
        status = a["status"]
        prev = state.get(aid)
        if prev and prev["status"] == status:
            since = prev["since"]
        elif not prev and a.get("statusUpdatedAt") and status != "waiting":
            since = a["statusUpdatedAt"] / 1000.0
        elif not prev and status == "idle" and a.get("updated"):
            since = a["updated"]
        elif not prev and status == "working" and a.get("started"):
            # Pour une conversation déjà en cours au démarrage du watcher
            st_s = a["started"] / 1000.0
            since = st_s if (now - st_s) < 7200 else now
        else:
            since = now
        state[aid] = {"status": status, "since": since}
        cwd = a.get("cwd") or ""
        fallback_proj = "Antigravity" if a["kind"] == "antigravity" else "~"
        agents.append({
            "id": aid,
            "pid": a.get("pid") or 0,
            "kind": a["kind"],
            "surface": a.get("surface") or "cli",
            "status": status,
            "since": int(since * 1000),
            "started": int(a.get("started") or int(now * 1000)),
            "project": norm_project(cwd, fallback_proj),
            "cwd": cwd,
            "branch": a.get("branch") or "",
            "title": a.get("title") or "",
            "focus": a.get("focus") or "",
            "tool": a.get("tool") or "",
            "reply": a.get("reply") or "",
            "files": int(a.get("files") or 0),
            "tokens": int(a.get("tokens") or 0),
            "model": a.get("model") or "",
            "subagents": int(a.get("subagents") or 0),
            "stepDone": int(a.get("stepDone") or 0),
            "stepTotal": int(a.get("stepTotal") or 0),
            "window": a.get("window") or "",
            "canStop": bool(a.get("canStop")),
            "alive": bool(a.get("alive")),
        })

    for aid in list(state):
        if aid not in seen_ids:
            del state[aid]

    agents.sort(key=lambda a: (
        {"waiting": 0, "working": 1}.get(a["status"], 2),
        -a["since"] if a["status"] == "idle" else -a["started"],
    ))
    return {"agents": agents, "perms": perms}


def watch():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    state, last = {}, None
    while True:
        try:
            snap = snapshot(state)
        except Exception as e:  # noqa: BLE001 — une sonde ratée ne doit pas tuer l'île
            print(f"caelestia-agents: {e}", file=sys.stderr)
            time.sleep(2)
            continue
        line = json.dumps(snap, ensure_ascii=False, separators=(",", ":"))
        if line != last:
            print(line, flush=True)
            last = line
        busy = any(a["status"] != "idle" for a in snap["agents"]) or snap["perms"]
        has_agents = bool(snap["agents"])
        time.sleep(0.5 if snap["perms"] else 1.5 if busy else 3.0 if has_agents else 4.0)


# ───────────────────────── actions Agent OS ─────────────────────────

def stop_agent(pid_str, force=False):
    try:
        pid = int(pid_str)
    except ValueError:
        sys.exit(2)
    if pid <= 1:
        sys.exit(2)
    p = read_proc(pid)
    if not p or not agent_of(p):
        sys.exit(1)
    try:
        os.kill(pid, signal.SIGTERM if force else signal.SIGINT)
    except OSError:
        sys.exit(1)


def open_terminal(cwd):
    target = cwd if cwd and os.path.isdir(cwd) else str(HOME)
    term = shutil.which("kitty") or shutil.which("foot") or shutil.which("alacritty")
    if not term:
        sys.exit(1)
    if os.path.basename(term) == "kitty":
        cmd = [term, "--directory", target]
    else:
        cmd = [term]
    subprocess.Popen(cmd, cwd=target, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def clean_launch_prompt(prompt):
    """Évite d'envoyer un faux prompt du genre 'Démarrer l'agent Codex.' lors d'un simple lancement."""
    p = (prompt or "").strip()
    if not p:
        return ""
    low = p.lower().strip(" .!?:;«»\"'")
    words = low.split()
    meta_starts = ("démarr", "demarr", "lanc", "ouvr", "start", "open", "run", "lancement", "démarrage", "initialis")
    if len(words) <= 6 and any(low.startswith(m) for m in meta_starts):
        return ""
    return p


def dispatch_agent(kind, cwd="", prompt=""):
    target = cwd if cwd and os.path.isdir(cwd) else str(HOME)
    prompt = clean_launch_prompt(prompt)
    if kind == "antigravity":
        bin_path = shutil.which("antigravity") or "/opt/Antigravity/antigravity"
        args = [bin_path, target] if cwd and os.path.isdir(cwd) else [bin_path]
        subprocess.Popen(args, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    cmds = {
        "claude": "claude",
        "codex": "codex",
        "copilot": "copilot",
        "opencode": "opencode",
        "agy": "agy",
        "gemini": "gemini",
        "aider": "aider",
    }
    exe = cmds.get(kind)
    if not exe:
        sys.exit(2)
    if prompt:
        q = shlex.quote(prompt)
        if kind in ("agy", "copilot"):
            run_str = f"{exe} -i {q}"
        elif kind == "opencode":
            run_str = f"{exe} --prompt {q} {shlex.quote(target)}"
        elif kind == "aider":
            run_str = f"{exe} --message {q}"
        else:
            run_str = f"{exe} {q}"
    else:
        run_str = f"{exe} {shlex.quote(target)}" if kind == "opencode" else exe
    term = shutil.which("kitty") or shutil.which("foot") or shutil.which("alacritty")
    if not term:
        sys.exit(1)
    shell = shutil.which("fish") or os.environ.get("SHELL", "/bin/sh")
    proj = norm_project(target)
    if os.path.basename(term) == "kitty":
        cmd = [term, "--directory", target, "--title", f"{kind.capitalize()} · {proj}", shell, "-ic", run_str]
    else:
        cmd = [term, "-e", shell, "-ic", run_str]
    subprocess.Popen(cmd, cwd=target, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def find_kitty_ancestor(pid, procs):
    cur = pid
    for _ in range(24):
        p = procs.get(cur)
        if not p:
            break
        if p["comm"].lower() == "kitty":
            return cur
        if p["ppid"] <= 1:
            break
        cur = p["ppid"]
    return 0


def find_kitty_window_id(kitty_pid, agent_pid, procs):
    """Trouve l'id de fenêtre Kitty qui héberge agent_pid (ou son shell parent)."""
    sock = f"unix:@kitty-{kitty_pid}"
    try:
        res = subprocess.run(
            ["kitten", "@", "--to", sock, "ls"],
            capture_output=True, text=True, timeout=2, check=False,
        )
        if res.returncode != 0:
            return sock, None
        data = json.loads(res.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return sock, None

    # Construire l'ensemble des ancêtres de agent_pid
    ancestors = set()
    cur = agent_pid
    for _ in range(16):
        ancestors.add(cur)
        p = procs.get(cur)
        if not p or p["ppid"] <= 1:
            break
        cur = p["ppid"]

    fallback_id = None
    for os_w in data:
        for tab in os_w.get("tabs") or []:
            for win in tab.get("windows") or []:
                wid = win.get("id")
                if fallback_id is None:
                    fallback_id = wid
                if win.get("pid") in ancestors:
                    return sock, wid
                for fg in win.get("foreground_processes") or []:
                    if fg.get("pid") in ancestors:
                        return sock, wid
    return sock, fallback_id


def send_via_kitty(kitty_pid, agent_pid, procs, message):
    sock, wid = find_kitty_window_id(kitty_pid, agent_pid, procs)
    if wid is None:
        return False, "Fenêtre Kitty introuvable"
    try:
        r1 = subprocess.run(
            ["kitten", "@", "--to", sock, "send-text", "--match", f"id:{wid}", "--", message],
            capture_output=True, text=True, timeout=2, check=False,
        )
        if r1.returncode != 0:
            return False, (r1.stderr or "Erreur kitty send-text").strip()[:120]
        time.sleep(0.08)
        subprocess.run(
            ["kitten", "@", "--to", sock, "send-text", "--match", f"id:{wid}", "\r"],
            capture_output=True, timeout=2, check=False,
        )
        return True, f"Envoyé en direct au terminal (Kitty #{wid})"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)


def resolve_full_session_id(agent_id, kind):
    prefix = agent_id.split(":", 1)[-1]
    if kind in ("agy", "antigravity"):
        brain = HOME / ".gemini/antigravity/brain"
        if brain.is_dir():
            for d in brain.iterdir():
                if d.is_dir() and d.name.startswith(prefix):
                    return d.name
    elif kind == "opencode":
        ocdb = HOME / ".local/share/opencode/opencode.db"
        if ocdb.is_file():
            try:
                con = sqlite3.connect(f"file:{ocdb}?mode=ro", uri=True, timeout=0.3)
                row = con.execute("SELECT id FROM session_v2 WHERE id LIKE ? ORDER BY time_updated DESC LIMIT 1", (f"{prefix}%",)).fetchone()
                con.close()
                if row:
                    return row[0]
            except sqlite3.Error:
                pass
    elif kind == "copilot":
        sroot = HOME / ".copilot/session-state"
        if sroot.is_dir():
            for d in sroot.iterdir():
                if d.is_dir() and d.name.startswith(prefix):
                    return d.name
    return ""


def send_to_agent(agent_id, message):
    """Envoie un ordre/message directement à un agent en cours (via Kitty remote ou reprise de session)."""
    msg = (message or "").strip()
    if not msg:
        return {"ok": False, "method": "none", "detail": "Message vide"}

    procs, _ = scan()
    snap = snapshot({})
    target = next((a for a in snap["agents"] if a["id"] == agent_id), None)
    if not target:
        return {"ok": False, "method": "none", "detail": f"Agent introuvable ({agent_id})"}

    kind = target["kind"]
    pid = int(target.get("pid") or 0)
    cwd = target.get("cwd") or str(HOME)

    # 1. Agent CLI vivant dans Kitty : injection directe sans voler le focus
    if pid > 1 and kind != "antigravity":
        kpid = find_kitty_ancestor(pid, procs)
        if kpid:
            ok, detail = send_via_kitty(kpid, pid, procs, msg)
            if ok:
                return {"ok": True, "method": "kitty", "detail": detail}

    # 2. Reprise interactive de session pour AGY / OpenCode / Copilot / Claude / Codex
    if kind in ("agy", "opencode", "copilot", "claude", "codex"):
        full_sid = resolve_full_session_id(agent_id, kind)
        term = shutil.which("kitty") or shutil.which("foot") or shutil.which("alacritty")
        shell = shutil.which("fish") or os.environ.get("SHELL", "/bin/sh")
        q = shlex.quote(msg)
        if kind == "agy":
            run_str = f"agy --conversation {shlex.quote(full_sid)} -i {q}" if full_sid else f"agy -i {q}"
        elif kind == "opencode":
            run_str = f"opencode --session {shlex.quote(full_sid)} --prompt {q} {shlex.quote(cwd)}" if full_sid else f"opencode --prompt {q} {shlex.quote(cwd)}"
        elif kind == "copilot":
            run_str = f"copilot --resume={shlex.quote(full_sid)} -i {q}" if full_sid else f"copilot -i {q}"
        elif kind == "codex":
            run_str = f"codex resume --last {q}"
        else:
            run_str = f"claude -c {q}"
        if term:
            proj = norm_project(cwd)
            cmd = [term, "--directory", cwd, "--title", f"{kind.capitalize()} · {proj}", shell, "-ic", run_str] if os.path.basename(term) == "kitty" else [term, "-e", shell, "-ic", run_str]
            subprocess.Popen(cmd, cwd=cwd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return {"ok": True, "method": "resume", "detail": f"Session {kind} reprise avec ton message"}

    # 3. Antigravity App (fenêtre GUI Electron) : ouvre AGY CLI sur la même conversation ou copie + focus
    if kind == "antigravity":
        full_sid = resolve_full_session_id(agent_id, kind)
        if full_sid and shutil.which("agy") and shutil.which("kitty"):
            shell = shutil.which("fish") or os.environ.get("SHELL", "/bin/sh")
            run_str = f"agy --conversation {shlex.quote(full_sid)} -i {shlex.quote(msg)}"
            subprocess.Popen(
                [shutil.which("kitty"), "--directory", cwd, "--title", f"AGY · {norm_project(cwd)}", shell, "-ic", run_str],
                cwd=cwd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            return {"ok": True, "method": "agy-bridge", "detail": "Relié à la conversation Antigravity via AGY CLI"}
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"], input=msg, text=True, timeout=2, check=False)
            return {"ok": True, "method": "clipboard", "detail": "Copié dans le presse-papiers pour Antigravity App"}

    return {"ok": False, "method": "none", "detail": "Impossible d'envoyer à cet agent"}


def load_gemini_key():
    key = os.environ.get("GEMINI_API_KEY", "").strip()
    if key:
        return key
    for p, field in (
        (HOME / ".config/caelestia-write/config.json", "api_key"),
        (HOME / ".config/ano-shell/agentos.json", "api_key"),
        (HOME / "OUTILS/ANO-GPT/config/api_keys.json", "gemini_api_key"),
    ):
        if p.is_file():
            try:
                val = (json.loads(p.read_text()).get(field) or "").strip()
                if val:
                    return val
            except (OSError, ValueError):
                pass
    return ""


def close_agent_window(agent):
    """Ferme proprement un agent ET sa fenêtre terminal (compatible Hyprland Lua + standard)."""
    win = agent.get("window") or ""
    pid = int(agent.get("pid") or 0)
    closed = False
    if win:
        addr = win if win.startswith("0x") else f"0x{win}"
        r = subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.window.kill({{ window = "address:{addr}" }})'],
            capture_output=True, text=True, timeout=2, check=False,
        )
        if r.returncode == 0 and "invalid" not in (r.stdout + r.stderr).lower():
            closed = True
        else:
            r2 = subprocess.run(
                ["hyprctl", "dispatch", "closewindow", f"address:{addr}"],
                capture_output=True, timeout=2, check=False,
            )
            closed = r2.returncode == 0
    if pid > 1 and agent.get("kind") != "antigravity":
        try:
            os.kill(pid, signal.SIGTERM)
            closed = True
        except OSError:
            pass
    return closed


