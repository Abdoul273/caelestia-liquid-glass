#!/usr/bin/env bash
# Bureaux dynamiques façon macOS/GNOME : 3 bureaux de base, et on ne peut
# ouvrir qu'un seul bureau vide après le dernier bureau occupé.
#   caelestia-ws next|prev          aller au bureau suivant / précédent
#   caelestia-ws move-next|move-prev  y emmener la fenêtre active

BASE=3

active=$(hyprctl -j activeworkspace | jq '.id')
[[ $active =~ ^[0-9]+$ ]] || exit 0
last=$(hyprctl -j clients | jq '[.[] | .workspace.id | select(. > 0)] | max // 0')
limit=$(( last + 1 > BASE ? last + 1 : BASE ))

case $1 in
    next | move-next) target=$(( active + 1 )) ;;
    prev | move-prev) target=$(( active - 1 )) ;;
    *) echo "usage: caelestia-ws next|prev|move-next|move-prev" >&2; exit 1 ;;
esac

# Bureau actuel au-delà de la limite (fenêtres fermées) : on peut toujours revenir
(( target < 1 )) && exit 0
(( target > limit && target > active )) && exit 0

if [[ $1 == move-* ]]; then
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$target\" })" >/dev/null
else
    hyprctl dispatch "hl.dsp.focus({ workspace = \"$target\" })" >/dev/null
fi
