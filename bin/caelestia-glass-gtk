#!/usr/bin/env python3
"""Liquid glass des applis GTK, appliqué tout de suite.

  caelestia-glass-gtk nautilus   verre classique, Nautilus seulement (le compromis)
  caelestia-glass-gtk complet    toutes les applis GTK (Calculatrice, Éditeur, Loupe, Thunar…)
  caelestia-glass-gtk off        aucune appli GTK en verre
  caelestia-glass-gtk            régénère avec le choix enregistré (thème ou intensité changés)

Le choix et l'intensité sont dans ~/.config/caelestia/glass.json (clés « gtk » et « density »),
réglables dans Paramètres → Fond d'écran et style → Liquid glass. Les couleurs viennent du
gtk.css généré par Caelestia : le verre suit le thème clair/sombre et le fond d'écran.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config/caelestia/glass.json"
TEMPLATES = HOME / ".local/share/caelestia-liquid-glass/gtk-glass"
GTK4 = HOME / ".config/gtk-4.0"
GTK3 = HOME / ".config/gtk-3.0"
MODES = ("nautilus", "complet", "off")

# Modèle utilisé pour chaque version de GTK selon le mode
VARIANTS = {
    "nautilus": {GTK4: "nautilus-gtk4.css", GTK3: None},
    "complet": {GTK4: "complet-gtk4.css", GTK3: "complet-gtk3.css"},
    "off": {GTK4: None, GTK3: None},
}


def load_conf() -> dict:
    try:
        return json.loads(CONF.read_text())
    except Exception:
        return {}


def save_conf(data: dict) -> None:
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=4) + "\n")
    os.replace(tmp, CONF)


def theme_colours() -> dict[str, tuple[int, int, int]]:
    """Couleurs @define-color du gtk.css de Caelestia (GTK 4, sinon GTK 3)."""
    colours = {}
    for d in (GTK4, GTK3):
        try:
            text = (d / "gtk.css").read_text()
        except OSError:
            continue
        for name, hexa in re.findall(r"@define-color\s+(\w+)\s+#([0-9a-fA-F]{6})\s*;", text):
            colours.setdefault(name, tuple(int(hexa[i : i + 2], 16) for i in (0, 2, 4)))
    return colours


def luminance(rgb: tuple[int, int, int]) -> float:
    r, g, b = (c / 255 for c in rgb)
    return 0.299 * r + 0.587 * g + 0.114 * b


def strength(base: float, density: float) -> float:
    """Même formule que Glass.strength() du shell : 0.5 garde l'opacité d'origine."""
    if density <= 0.5:
        return base * (0.35 + 1.3 * density)
    return base + (0.95 - base) * (density - 0.5) * 2


def render(template: str, colours: dict, density: float) -> str:
    window = colours.get("window_bg_color", (12, 14, 18))
    light = luminance(window) > 0.5
    roles = {
        "bg": window,
        "pop": colours.get("popover_bg_color", window),
        "view": colours.get("view_bg_color", window),
        "shade": (255, 255, 255) if light else (0, 0, 0),
        "ink": (0, 0, 0) if light else (255, 255, 255),
    }

    def repl(m: re.Match) -> str:
        role, base = m.group(1), float(m.group(2))
        if role != "ink":
            # Le verre clair laisse plus passer le fond : un peu plus dense pour rester lisible
            if light:
                base = min(0.95, base + 0.12)
            base = strength(base, density)
            # Menus et boîtes de dialogue : jamais trop transparents, sinon illisibles
            if role == "pop":
                base = max(base, 0.72)
        r, g, b = roles[role]
        return f"rgba({r}, {g}, {b}, {max(0.0, min(1.0, base)):.3f})"

    return re.sub(r"\{\{(bg|pop|view|shade|ink):([0-9.]+)\}\}", repl, template)


def write_if_changed(path: Path, content: str) -> bool:
    try:
        if not path.is_symlink() and path.read_text() == content:
            return False
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        path.unlink()
    path.write_text(content)
    return True


PORTAL_THEME = "Caelestia-Glass-Portal"
PORTAL_THEME_CSS = HOME / f".local/share/themes/{PORTAL_THEME}/gtk-3.0/gtk.css"
PORTAL_DROPIN = HOME / ".config/systemd/user/xdg-desktop-portal-gtk.service.d/caelestia-glass.conf"
PORTAL_SERVICE = "xdg-desktop-portal-gtk.service"


def update_portal(mode: str, colours: dict, density: float) -> None:
    """Fenêtres « Ouvrir / Enregistrer » du portail GTK 3 : un thème rien qu'à lui.

    Leur fenêtre est un simple « dialog » GTK 3, comme ceux de Chrome : impossible de la
    cibler dans gtk.css sans toucher les autres applis. On donne donc au seul service du
    portail un thème (GTK_THEME) qui reprend adw-gtk3 et ajoute le verre.
    """
    light = luminance(colours.get("window_bg_color", (12, 14, 18))) > 0.5
    base = "adw-gtk3" if light else "adw-gtk3-dark"
    content = f'/* Généré par caelestia-glass-gtk ({mode}) — thème du portail GTK uniquement */\n'
    content += f'@import url("file:///usr/share/themes/{base}/gtk-3.0/gtk.css");\n'
    template = TEMPLATES / "portal-gtk3.css"
    if mode == "complet" and template.is_file():
        body = re.sub(r"\A\s*/\*.*?\*/\n?", "", template.read_text(), count=1, flags=re.S)
        content += render(body, colours, density)
    changed = write_if_changed(PORTAL_THEME_CSS, content)

    dropin = (
        "# Caelestia Liquid Glass : thème « verre » pour les fenêtres Ouvrir / Enregistrer\n"
        "# (supprimer ce fichier pour revenir au thème normal)\n"
        f"[Service]\nEnvironment=GTK_THEME={PORTAL_THEME}\n"
    )
    if write_if_changed(PORTAL_DROPIN, dropin):
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        changed = True

    if not changed:
        return
    # Le portail ne relit pas son thème : on le relance, sauf si une fenêtre est ouverte
    busy = False
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
        busy = any(c.get("class") == "xdg-desktop-portal-gtk" for c in json.loads(out or "[]"))
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    if not busy:
        subprocess.run(["systemctl", "--user", "try-restart", PORTAL_SERVICE], check=False)


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] not in MODES:
        print("Usage : caelestia-glass-gtk [nautilus|complet|off]", file=sys.stderr)
        return 1

    conf = load_conf()
    mode = args[0] if args else conf.get("gtk", "nautilus")
    if mode not in MODES:
        mode = "nautilus"
    if args and conf.get("gtk") != mode:
        conf["gtk"] = mode
        save_conf(conf)
    try:
        density = max(0.0, min(1.0, float(conf.get("density", 0.5))))
    except (TypeError, ValueError):
        density = 0.5

    colours = theme_colours()
    changed = False
    for gtk_dir, name in VARIANTS[mode].items():
        header = f"/* Généré par caelestia-glass-gtk ({mode}, intensité {round(density * 100)} %) — ne pas modifier :\n * choisir dans Paramètres → Fond d'écran et style → Liquid glass */\n"
        if name and (TEMPLATES / name).is_file():
            template = re.sub(r"\A\s*/\*.*?\*/\n?", "", (TEMPLATES / name).read_text(), count=1, flags=re.S)
            content = header + render(template, colours, density)
        else:
            content = header
        changed |= write_if_changed(gtk_dir / "liquid-glass.css", content)
        # Anciennes versions (fichiers par variante) : remplacés par ce fichier généré
        for old in gtk_dir.glob("liquid-glass-*.css"):
            old.unlink()

    update_portal(mode, colours, density)

    # Liseré de verre des fenêtres (hypr-user.lua lit glass.json)
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and args:
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Les applis GTK ouvertes relisent leur style quand le thème change : on le bascule
    # un instant puis on le remet
    if changed:
        key = "/org/gnome/desktop/interface/gtk-theme"
        try:
            theme = subprocess.run(["dconf", "read", key], capture_output=True, text=True).stdout.strip()
            theme = theme or "'adw-gtk3-dark'"
            subprocess.run(["dconf", "write", key, "'Adwaita'"], check=False)
            time.sleep(0.4)
            subprocess.run(["dconf", "write", key, theme], check=False)
        except FileNotFoundError:
            pass

    print(f"Liquid glass des applis GTK : {mode}, intensité {round(density * 100)} %")
    return 0


if __name__ == "__main__":
    sys.exit(main())
