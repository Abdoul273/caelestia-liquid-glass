#!/bin/sh
# Fond d'écran animé (vidéo ou GIF) : joué seulement sur secteur.
# Sur batterie, le shell l'arrête et affiche l'image fixe (une image tirée de la vidéo).
#   caelestia-animwall <fichier>   met ce fond animé
#   caelestia-animwall off         revient à l'image fixe seule
#   caelestia-animwall             affiche le fond animé actuel
#   caelestia-animwall frames <vidéos...>  crée les miniatures manquantes (utilisé par le shell)
set -e
state="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/wallpaper"
mkdir -p "$state"
frames="$HOME/.local/share/caelestia/animated-frames"
mkdir -p "$frames"

# Image tirée de la vidéo vers 1 s (ou la première si la vidéo est plus courte)
extract() {
    ffmpeg -loglevel error -y -ss 1 -i "$1" -frames:v 1 -q:v 2 "$2" 2>/dev/null \
        && [ -s "$2" ] || ffmpeg -loglevel error -y -i "$1" -frames:v 1 -q:v 2 "$2"
}

# Passe par le shell s'il tourne (il garde l'état en mémoire), sinon écrit le fichier
set_animated() {
    qs -c caelestia ipc call wallpaper setAnimated "$1" >/dev/null 2>&1 \
        || printf '%s\n' "$1" > "$state/animated.txt"
}

case "$1" in
    "")
        cat "$state/animated.txt" 2>/dev/null || echo "(aucun)"
        ;;
    frames)
        shift
        for v in "$@"; do
            out="$frames/$(basename "${v%.*}").jpg"
            [ -s "$out" ] || extract "$v" "$out" || true
        done
        ;;
    off)
        set_animated ""
        ;;
    *)
        file=$(realpath "$1")
        [ -f "$file" ] || { echo "Fichier introuvable : $1" >&2; exit 1; }
        # Image fixe pour la batterie (et pour les couleurs du thème)
        still="$frames/$(basename "${file%.*}").jpg"
        [ -s "$still" ] || extract "$file" "$still"
        caelestia wallpaper -f "$still"
        set_animated "$file"
        echo "Fond animé : $file (image sur batterie : $still)"
        ;;
esac
