# ---------------------------------------------------------------- calculatrice

class CalcError(Exception):
    pass


def _fact(n: float) -> float:
    if n < 0 or n != int(n) or n > 170:
        raise CalcError("factorielle invalide")
    return float(math.factorial(int(n)))


def _deg(fn):
    return lambda x: fn(math.radians(x))


def _adeg(fn):
    return lambda x: math.degrees(fn(x))


FUNCTIONS = {
    "sqrt": math.sqrt, "racine": math.sqrt, "cbrt": lambda x: math.copysign(abs(x) ** (1 / 3), x),
    # Trigonométrie en degrés, comme une calculatrice classique
    "sin": _deg(math.sin), "cos": _deg(math.cos), "tan": _deg(math.tan),
    "asin": _adeg(math.asin), "acos": _adeg(math.acos), "atan": _adeg(math.atan),
    "ln": math.log, "log": math.log10, "log2": math.log2, "exp": math.exp,
    "abs": abs, "round": round, "arrondi": round, "floor": math.floor, "ceil": math.ceil,
    "fact": _fact, "factorielle": _fact,
}
CONSTANTS = {"pi": math.pi, "π": math.pi, "e": math.e, "tau": math.tau, "phi": (1 + 5 ** 0.5) / 2, "ans": 0.0}
BINOPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
    ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow,
}
UNOPS = {ast.UAdd: operator.pos, ast.USub: operator.neg}


def normalise(expr: str) -> str:
    s = expr.strip().lower().replace("\u202f", "").replace("\u00a0", "")
    s = s.replace("×", "*").replace("÷", "/").replace("−", "-").replace("^", "**").replace("√", "sqrt")
    s = re.sub(r"(?<=\d)\s+(?=\d{3}\b)", "", s)          # 1 000 000 → 1000000
    s = re.sub(r"(?<=\d),(?=\d)", ".", s)                # virgule décimale
    s = re.sub(r"(?<=[\d)])\s*x\s*(?=[\d(])", "*", s)    # 3 x 4 → 3*4
    # « 50 + 20 % » = 60 et « 50 - 20 % » = 40, comme sur macOS
    m = re.fullmatch(r"(.+?)\s*([+-])\s*(\d+(?:\.\d+)?)\s*%\s*", s)
    if m and not m.group(1).rstrip().endswith(("*", "/", "+", "-", "(")):
        s = f"({m.group(1)})*(1{m.group(2)}{m.group(3)}/100)"
    s = re.sub(r"(\d+(?:\.\d+)?)\s*%\s*(?:de|of)\s*", r"(\1/100)*", s)  # 20% de 150
    s = re.sub(r"(\d+(?:\.\d+)?)\s*%", r"(\1/100)", s)   # 15% → 0.15
    s = re.sub(r"(\d+(?:\.\d+)?)\s*!", r"fact(\1)", s)   # 5! → fact(5)
    s = re.sub(r"(?<![a-z\d.])(\d+(?:\.\d+)?)\s*(?=[a-zπ(])", r"\1*", s)  # 2pi, 2(3+4) mais pas log2(
    s = re.sub(r"\)\s*(?=[\d(a-zπ])", ")*", s)           # (1+2)(3+4)
    return s


def _eval(node: ast.AST) -> float:
    if isinstance(node, ast.Expression):
        return _eval(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in BINOPS:
        left, right = _eval(node.left), _eval(node.right)
        if isinstance(node.op, ast.Pow) and abs(right) > 1000:
            raise CalcError("exposant trop grand")
        return BINOPS[type(node.op)](left, right)
    if isinstance(node, ast.UnaryOp) and type(node.op) in UNOPS:
        return UNOPS[type(node.op)](_eval(node.operand))
    if isinstance(node, ast.Name) and node.id in CONSTANTS:
        return CONSTANTS[node.id]
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in FUNCTIONS and len(node.args) == 1 and not node.keywords:
        return FUNCTIONS[node.func.id](_eval(node.args[0]))
    raise CalcError("expression non reconnue")


def calculate(expr: str) -> float | None:
    """Renvoie le résultat, ou None si le texte n'est pas un calcul."""
    s = normalise(expr)
    if not s or not re.search(r"\d|pi|π|\be\b|tau|phi", s):
        return None
    if not re.fullmatch(r"[\d\s.+\-*/%()a-zπ,]*", s):
        return None
    try:
        tree = ast.parse(s, mode="eval")
        value = _eval(tree)
    except (SyntaxError, CalcError, ValueError, ZeroDivisionError, OverflowError, TypeError):
        return None
    if isinstance(value, complex) or math.isnan(value) or math.isinf(value):
        return None
    return float(value)


def is_calculation(expr: str) -> bool:
    """Vrai si le texte ressemble à un calcul (et pas juste à un nombre seul)."""
    s = normalise(expr)
    return bool(re.search(r"[+\-*/%()]|\b(?:sqrt|sin|cos|tan|ln|log|exp|fact|racine)\b|!", s)) and calculate(expr) is not None


# ---------------------------------------------------------------- conversions d'unités

# unité → (grandeur, facteur vers l'unité de base)
UNITS = {}


def _units(dim: str, table: dict[str, float]) -> None:
    for names, factor in table.items():
        for name in names.split("|"):
            UNITS[name] = (dim, factor)


_units("longueur", {"mm": 0.001, "cm": 0.01, "m|metre|metres|mètre|mètres": 1, "km|kilometre|kilometres|kilomètre|kilomètres": 1000,
                    "in|pouce|pouces|inch|inches": 0.0254, "ft|pied|pieds|feet|foot": 0.3048, "yd|yard|yards": 0.9144,
                    "mi|mile|miles": 1609.344, "nmi|mille|milles": 1852})
_units("masse", {"mg": 0.001, "g|gramme|grammes": 1, "kg|kilo|kilos|kilogramme|kilogrammes": 1000, "t|tonne|tonnes": 1e6,
                 "lb|lbs|livre|livres|pound|pounds": 453.59237, "oz|once|onces|ounce|ounces": 28.349523125})
_units("données", {"o|octet|octets|b|byte|bytes": 1, "ko|kb": 1e3, "mo|mb": 1e6, "go|gb": 1e9, "to|tb": 1e12,
                   "kio|kib": 1024, "mio|mib": 1024 ** 2, "gio|gib": 1024 ** 3, "tio|tib": 1024 ** 4})
_units("durée", {"ms": 0.001, "s|sec|seconde|secondes": 1, "min|minute|minutes": 60, "h|heure|heures": 3600,
                 "j|jour|jours|d|day|days": 86400, "sem|semaine|semaines|week|weeks": 604800,
                 "an|ans|annee|annees|année|années|year|years": 31557600})
_units("vitesse", {"m/s": 1, "km/h|kmh": 1 / 3.6, "mph": 0.44704, "kn|noeud|noeuds|nœud|nœuds": 0.514444})
_units("volume", {"ml": 0.001, "cl": 0.01, "dl": 0.1, "l|litre|litres": 1, "gal|gallon|gallons": 3.785411784})
TEMPS = {"c": "c", "°c": "c", "celsius": "c", "f": "f", "°f": "f", "fahrenheit": "f", "k": "k", "kelvin": "k"}
UNIT_LABEL = {"c": "°C", "f": "°F", "k": "K"}
UNIT_DISPLAY = {"ko": "ko", "mo": "Mo", "go": "Go", "to": "To", "kb": "kB", "mb": "MB", "gb": "GB", "tb": "TB",
                "kio": "Kio", "mio": "Mio", "gio": "Gio", "tio": "Tio", "kib": "KiB", "mib": "MiB", "gib": "GiB",
                "tib": "TiB", "l": "L", "ml": "mL", "cl": "cL", "dl": "dL", "km/h": "km/h", "kmh": "km/h"}

_CONV = re.compile(r"^\s*(.+?)\s*(°?[a-zµœèé/]+)\s+(?:en|in|to|vers|=|->|→)\s+(°?[a-zµœèé/]+)\s*$", re.I)


def convert(text: str) -> str | None:
    """« 10 km en miles » → « 6,213712 mi », ou None si ce n'est pas une conversion."""
    m = _CONV.match(text.strip())
    if not m:
        return None
    amount = calculate(m.group(1))
    src, dst = m.group(2).lower(), m.group(3).lower()
    if amount is None:
        return None
    if src in TEMPS and dst in TEMPS:
        a, b = TEMPS[src], TEMPS[dst]
        kelvin = {"c": amount + 273.15, "f": (amount - 32) * 5 / 9 + 273.15, "k": amount}[a]
        value = {"c": kelvin - 273.15, "f": (kelvin - 273.15) * 9 / 5 + 32, "k": kelvin}[b]
        return f"{format_number(round(value, 6))} {UNIT_LABEL[b]}"
    if src in UNITS and dst in UNITS and UNITS[src][0] == UNITS[dst][0]:
        value = amount * UNITS[src][1] / UNITS[dst][1]
        return f"{format_number(round(value, 6))} {UNIT_DISPLAY.get(dst, m.group(3))}"
    return None


def format_number(value: float) -> str:
    """Format français : espaces pour les milliers, virgule décimale."""
    if abs(value) >= 1e15 or (value != 0 and abs(value) < 1e-9):
        mant, exp = f"{value:.10e}".split("e")
        mant = mant.rstrip("0").rstrip(".").replace(".", ",")
        return f"{mant} × 10^{int(exp)}"
    rounded = round(value, 10)
    if rounded == int(rounded):
        text = f"{int(rounded):,}".replace(",", " ")
    else:
        text = f"{rounded:,.10f}".rstrip("0").rstrip(".")
        whole, _, frac = text.partition(".")
        text = whole.replace(",", " ") + ("," + frac if frac else "")
    return text


# ---------------------------------------------------------------- recherche web

@dataclass
class WebResult:
    title: str
    url: str
    snippet: str
    icon: str = ""

    @property
    def icon_url(self) -> str:
        # Icône fournie par le moteur, sinon celle du site via le service d'icônes de Google
        return self.icon or "https://www.google.com/s2/favicons?" + urllib.parse.urlencode({"domain": self.domain, "sz": 64})

    @property
    def domain(self) -> str:
        host = urllib.parse.urlparse(self.url).netloc
        return host[4:] if host.startswith("www.") else host


@dataclass
class TopHit:
    title: str
    text: str
    url: str
    source: str


class _DDGParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.results: list[WebResult] = []
        self._field: str | None = None
        self._buf: list[str] = []
        self._current: dict[str, str] = {}
        self._in_ad = False
        self._depth = 0

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        cls = a.get("class") or ""
        if tag == "div" and "result" in cls.split():
            self._in_ad = "result--ad" in cls
        if tag == "a" and "result__a" in cls:
            self._flush()
            self._current = {"url": self._clean(a.get("href", ""))}
            self._field, self._buf = "title", []
        elif tag == "a" and "result__snippet" in cls:
            self._field, self._buf = "snippet", []

    def handle_endtag(self, tag):
        if tag == "a" and self._field:
            self._current[self._field] = html.unescape("".join(self._buf)).strip()
            self._field = None

    def handle_data(self, data):
        if self._field:
            self._buf.append(data)

    def close(self):
        super().close()
        self._flush()

    def _flush(self):
        c = self._current
        if c.get("url") and c.get("title") and not self._in_ad:
            self.results.append(WebResult(c["title"], c["url"], c.get("snippet", "")))
        self._current = {}

    @staticmethod
    def _clean(href: str) -> str:
        if href.startswith("//"):
            href = "https:" + href
        parsed = urllib.parse.urlparse(href)
        if parsed.netloc.endswith("duckduckgo.com") and parsed.path.startswith("/l/"):
            target = urllib.parse.parse_qs(parsed.query).get("uddg", [""])[0]
            return target or href
        return href


def _get(url: str) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept-Language": "fr-FR,fr;q=0.9,en;q=0.6"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read()


_TAG = re.compile(r"<[^>]+>")


def _text(fragment: str) -> str:
    return re.sub(r"\s+", " ", html.unescape(_TAG.sub("", fragment))).strip()


def search_brave(query: str) -> list[WebResult]:
    """Brave Search : index propre, résultats de qualité, avec icônes des sites."""
    page = _get("https://search.brave.com/search?" + urllib.parse.urlencode({"q": query, "source": "web"})).decode("utf-8", "replace")
    results = []
    for block in page.split('data-type="web"')[1:]:
        url = re.search(r'<a href="(https?://[^"]+)"', block)
        title = re.search(r'search-snippet-title[^"]*"[^>]*title="([^"]*)"', block)
        if not url or not title:
            continue
        snippet = re.search(r'class="content[^"]*"[^>]*>(.*?)</div>', block, re.S)
        icon = re.search(r'<img src="(https://imgs\.search\.brave\.com/[^"]+)"[^>]*class="favicon', block)
        results.append(WebResult(html.unescape(title.group(1)), html.unescape(url.group(1)),
                                 _text(snippet.group(1)) if snippet else "", icon.group(1) if icon else ""))
    return results


def _bing_url(href: str) -> str:
    href = html.unescape(href)
    parsed = urllib.parse.urlparse(href)
    if parsed.netloc.endswith("bing.com") and parsed.path.startswith("/ck/"):
        u = urllib.parse.parse_qs(parsed.query).get("u", [""])[0]
        if u.startswith("a1"):
            import base64
            try:
                return base64.urlsafe_b64decode(u[2:] + "=" * (-len(u[2:]) % 4)).decode()
            except ValueError:
                pass
    return href


def search_bing(query: str) -> list[WebResult]:
    page = _get("https://www.bing.com/search?" + urllib.parse.urlencode({"q": query, "setlang": "fr", "cc": "FR"})).decode("utf-8", "replace")
    results = []
    for block in page.split('<li class="b_algo')[1:]:
        link = re.search(r'<h2[^>]*>\s*<a[^>]+href="([^"]+)"[^>]*>(.*?)</a>', block, re.S)
        if not link:
            continue
        snippet = re.search(r'<p[^>]*>(.*?)</p>', block, re.S)
        results.append(WebResult(_text(link.group(2)), _bing_url(link.group(1)), _text(snippet.group(1)) if snippet else ""))
    return results


def search_ddg(query: str) -> list[WebResult]:
    url = "https://html.duckduckgo.com/html/?" + urllib.parse.urlencode({"q": query, "kl": "fr-fr"})
    parser = _DDGParser()
    parser.feed(_get(url).decode("utf-8", "replace"))
    parser.close()
    return [r for r in parser.results if "duckduckgo.com/y.js" not in r.url]


def search_brave_api(query: str) -> list[WebResult]:
    """API officielle Brave Search : fiable, rapide, sans blocage."""
    key = API_KEY_FILE.read_text().strip()
    url = "https://api.search.brave.com/res/v1/web/search?" + urllib.parse.urlencode(
        {"q": query, "count": 15, "search_lang": "fr", "country": "FR", "safesearch": "moderate"})
    req = urllib.request.Request(url, headers={"Accept": "application/json", "X-Subscription-Token": key, "User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        data = json.loads(resp.read())
    return [WebResult(_text(r.get("title", "")), r.get("url", ""), _text(r.get("description", "")),
                      (r.get("profile") or {}).get("img", ""))
            for r in data.get("web", {}).get("results", []) if r.get("url")]


def has_api_key() -> bool:
    try:
        return bool(API_KEY_FILE.read_text().strip())
    except OSError:
        return False


def suggestions(query: str) -> list[str]:
    """Suggestions Google instantanées pendant la saisie."""
    url = "https://suggestqueries.google.com/complete/search?" + urllib.parse.urlencode({"client": "firefox", "hl": "fr", "q": query})
    data = json.loads(_get(url).decode("utf-8", "replace"))
    return [x for x in data[1] if x.lower() != query.lower()][:5]


# Un moteur qui nous bloque (429, captcha) est mis en pause quelques minutes
_blocked_until: dict[str, float] = {}


def _engine_ok(engine) -> bool:
    import time
    return time.time() >= _blocked_until.get(engine.__name__, 0)


def _engine_failed(engine, exc: Exception) -> None:
    import time
    if isinstance(exc, urllib.error.HTTPError) and exc.code in (403, 429):
        _blocked_until[engine.__name__] = time.time() + 300


ENGINES = (search_brave, search_bing, search_ddg)
_cache: dict[str, list[WebResult]] = {}


def _norm_url(url: str) -> str:
    p = urllib.parse.urlparse(url)
    host = p.netloc.lower().removeprefix("www.")
    return host + p.path.rstrip("/")


def web_search(query: str) -> list[WebResult]:
    """Interroge plusieurs moteurs en parallèle et fusionne leurs résultats."""
    key = query.lower()
    if key in _cache:
        return _cache[key]
    buckets: dict[str, list[WebResult]] = {}
    errors = []

    engines = (search_brave_api,) if has_api_key() else tuple(e for e in ENGINES if _engine_ok(e)) or ENGINES

    def run(engine):
        try:
            buckets[engine.__name__] = engine(query)
        except Exception as exc:
            _engine_failed(engine, exc)
            errors.append(exc)

    threads = [threading.Thread(target=run, args=(e,), daemon=True) for e in engines]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=TIMEOUT + 1)
    merged: list[WebResult] = []
    seen: dict[str, WebResult] = {}
    # Entrelace les moteurs (Brave d'abord) pour garder les meilleurs de chacun
    lists = [buckets.get(e.__name__, []) for e in engines]
    for i in range(max((len(l) for l in lists), default=0)):
        for l in lists:
            if i < len(l):
                r = l[i]
                k = _norm_url(r.url)
                if k in seen:
                    if not seen[k].snippet and r.snippet:
                        seen[k].snippet = r.snippet
                    if not seen[k].icon and r.icon:
                        seen[k].icon = r.icon
                    continue
                seen[k] = r
                merged.append(r)
    if not merged and errors:
        raise errors[0]
    merged = merged[:MAX_RESULTS]
    if merged:
        _cache[key] = merged
    return merged


def fetch_icon(url: str) -> bytes | None:
    try:
        return _get(url)
    except Exception:
        return None


def top_hit(query: str) -> TopHit | None:
    """Résumé Wikipédia (en français) du sujet recherché, comme la carte de Spotlight."""
    try:
        api = "https://fr.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action": "query", "list": "search", "srsearch": query, "srlimit": 1, "format": "json"})
        hits = json.loads(_get(api)).get("query", {}).get("search", [])
        if not hits:
            return None
        title = hits[0]["title"]
        summary = json.loads(_get("https://fr.wikipedia.org/api/rest_v1/page/summary/" + urllib.parse.quote(title.replace(" ", "_"))))
        text = (summary.get("extract") or "").strip()
        if not text or summary.get("type") == "disambiguation":
            return None
        return TopHit(summary.get("title", title), text,
                      summary.get("content_urls", {}).get("desktop", {}).get("page", ""), "Wikipédia")
    except Exception:
        return None


CLOCK_RE = re.compile(r"^(minuteur|timer|chrono(?:mètre|metre)?|stopwatch|stop(?:per)?\s+(?:le\s+)?(?:minuteur|chrono(?:mètre|metre)?|timer))\b\s*(.*)$", re.I)


def clock_command(text: str) -> tuple[list[str], str] | None:
    """« minuteur 5 min », « timer 1h30 », « chrono », « stop minuteur » → commande de la Dynamic Island."""
    app = {"horloge": "timer", "alarme": "alarms", "alarmes": "alarms", "réveil": "alarms", "pomodoro": "pomodoro"}.get(text.strip().lower())
    if app:
        return [str(Path.home() / ".local/bin/caelestia-clock"), app], "Ouvrir l'Horloge"
    m = CLOCK_RE.match(text.strip())
    if not m:
        return None
    word, rest = m.group(1).lower(), m.group(2).strip()
    base = ["qs", "-c", "caelestia", "ipc", "call", "island"]
    if word.startswith("stop"):
        return base + ["stop"], "Arrêter le minuteur ou le chronomètre"
    if word.startswith("chrono") or word == "stopwatch":
        return base + ["stopwatch"], "Lancer le chronomètre dans l'île"
    if not re.search(r"\d", rest):
        return [str(Path.home() / ".local/bin/caelestia-clock"), "timer"], "Ouvrir l'Horloge (minuteur)"
    return base + ["timer", rest], f"Lancer un minuteur de {rest} dans l'île"


# ---------------------------------------------------------------- apps, actions, fichiers

import unicodedata


def fold(text: str) -> str:
    """Minuscules sans accents, pour comparer « parametres » et « Paramètres »."""
    return "".join(c for c in unicodedata.normalize("NFD", text.lower()) if unicodedata.category(c) != "Mn")


_APPS: list | None = None


def all_apps() -> list:
    global _APPS
    if _APPS is None:
        _APPS = [a for a in Gio.AppInfo.get_all() if a.should_show() and isinstance(a, Gio.DesktopAppInfo)]
    return _APPS


def score_text(q: str, name: str) -> int:
    n = fold(name)
    if not n:
        return 0
    if n == q:
        return 100
    if n.startswith(q):
        return 90
    words = re.split(r"[\s\-_.]+", n)
    if any(w.startswith(q) for w in words):
        return 80
    initials = "".join(w[0] for w in words if w)
    if len(q) >= 2 and initials.startswith(q):
        return 70
    if q in n:
        return 60
    return 0


def search_apps(query: str, limit: int = 5) -> list:
    q = fold(query.strip())
    if not q:
        return []
    scored = []
    for a in all_apps():
        best = score_text(q, a.get_display_name() or a.get_name() or "")
        if best < 60:
            extra = [a.get_generic_name() or "", *(a.get_keywords() or []), os.path.basename(a.get_executable() or "")]
            best = max(best, *(min(55, score_text(q, t)) for t in extra))
        if best >= 50:
            scored.append((best, a))
    scored.sort(key=lambda x: (-x[0], (x[1].get_display_name() or "").lower()))
    return [a for _, a in scored[:limit]]


HOME = str(Path.home())
BIN = HOME + "/.local/bin/"

# Actions du système : (titre, mots-clés, icône, commande)
ACTIONS = [
    ("Verrouiller l'écran", "verrouiller lock ecran", "󰌾", ["qs", "-c", "caelestia", "ipc", "call", "lock", "lock"]),
    ("Mettre en veille", "veille suspendre dormir sleep", "󰤄", ["systemctl", "suspend"]),
    ("Redémarrer", "redemarrer reboot restart", "󰜉", ["systemctl", "reboot"]),
    ("Éteindre", "eteindre shutdown arreter poweroff", "󰐥", ["systemctl", "poweroff"]),
    ("Se déconnecter", "deconnecter logout session", "󰍃", [BIN + "caelestia-logout"]),
    ("Paramètres de Caelestia", "parametres reglages settings nexus preferences", "󰒓", ["qs", "-c", "caelestia", "ipc", "call", "nexus", "open"]),
