#!/usr/bin/env python3
"""Assistant vocal façon Siri pour Caelestia (Super + Maj + Espace).

    caelestia-siri serve        serveur persistant piloté par le shell (JSON lignes)
    caelestia-siri phone-relay  (interne) serveur ANO Remote quand ANO-GPT est éteint
    caelestia-siri --file a.wav test : envoie un fichier comme s'il venait du micro

Même chaîne que ANO-GPT : Gemini Live audio natif (gemini-3.8-live → 3.1-flash-live
→ 2.5 native-audio, API v1alpha, voix de ANO), VAD serveur, reprise de session
(la conversation continue d'une ouverture à l'autre pendant 15 min) et
compression de contexte (pas de fin de session sur une longue conversation).

Micro coupé par défaut, comme « Écrire à Siri » : on écrit, ou on active le micro
pour UNE demande ({"mic":true}) ; il se recoupe après la réponse.
Option "micro_par_defaut": true dans config.json pour l'ancien comportement.

Entrée : {"open":true} {"close":true} {"interrupt":true} {"reset":true} {"text":"…"} {"mic":true|false|"toggle"}
Sortie : {"stage":"state","state":"connexion|ecoute|reflexion|parle|outil|erreur","detail"}
         {"stage":"level","v",who:"mic|voice"} {"stage":"user","text"} {"stage":"reply","text"}
         {"stage":"tool","label"} {"stage":"mic","on"} {"stage":"idle"} (le shell ferme)
"""

import asyncio
import datetime as dt
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import wave
from pathlib import Path

import numpy as np

HOME = Path.home()
ANO = HOME / "OUTILS/ANO-GPT"
CONFIG = HOME / ".config/caelestia-siri/config.json"
MIC_RATE, OUT_RATE = 16000, 24000
CHUNK_MS = 64
MIC_CHUNK = MIC_RATE * 2 * CHUNK_MS // 1000
HANDLE_TTL = 900  # au-delà, Gemini a oublié la session
SESSION_FILE = HOME / ".cache/caelestia-siri/session.json"  # survit aux redémarrages du moteur
IDLE_AFTER_REPLY = 8.0
IDLE_BEFORE_ANY = 14.0


def load_config() -> dict:
    ano = {}
    try:
        ano = json.loads((ANO / "config/api_keys.json").read_text())
    except (OSError, ValueError):
        pass
    cfg = {
        "name": "Siri",
        "api_key": os.environ.get("GEMINI_API_KEY", "") or ano.get("gemini_live_api_key") or ano.get("gemini_api_key", ""),
        "models": [m for m in (ano.get("live_model") or "models/gemini-3.8-live",
                               ano.get("live_model_fallback") or "models/gemini-3.1-flash-live-preview",
                               ano.get("live_model_emergency") or "models/gemini-2.5-flash-native-audio-latest") if m],
        "api_version": ano.get("gemini_live_api_version") or "v1alpha",
        "voice": ano.get("live_voice") or "Charon",
        "language": ano.get("conversation_language") or "fr-FR",
        "city": ano.get("user_city") or "",
        "micro_par_defaut": False,
    }
    try:
        cfg.update(json.loads(CONFIG.read_text()))
    except (OSError, ValueError):
        pass
    return cfg


CFG = load_config()

# Les actions d'ANO-GPT impriment beaucoup : stdout (fd 1) est redirigé vers stderr
# et le protocole JSON passe par une copie privée du vrai stdout.
OUT = os.fdopen(os.dup(1), "w", buffering=1)
os.dup2(2, 1)
sys.stdout = sys.stderr


_last_state = None


def emit(**msg) -> None:
    global _last_state
    if msg.get("stage") == "state":
        key = (msg.get("state"), msg.get("detail"))
        if key == _last_state:
            return
        _last_state = key
    OUT.write(json.dumps(msg, ensure_ascii=False) + "\n")
    OUT.flush()


def run(*cmd: str, timeout: float = 4) -> str:
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        if result.returncode:
            return f"erreur : code {result.returncode} : {(result.stderr or result.stdout).strip()[:300]}"
        return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"erreur : {exc}"


def qs_ipc(*args: str) -> str:
    return run("qs", "ipc", "-c", "caelestia", "call", *args)


def fold(s: str) -> str:
    s = s.casefold().replace("œ", "oe").replace("æ", "ae")
    return "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")


# ── Outils ────────────────────────────────────────────────────────────────────


def t_timer(duration: str, label: str = "") -> dict:
    if not re.fullmatch(r"(?:\s*\d+(?:[.,]\d+)?\s*(?:h|min|m|sec|s)?)+\s*", duration):
        return {"ok": False, "erreur": "Durée invalide : utilise 5m, 1h30m ou 45s."}
    seconds = sum(float(n.replace(",", ".")) * {"h": 3600, "m": 60, "min": 60,
                  "s": 1, "sec": 1, "": 60}[unit]
                  for n, unit in re.findall(r"(\d+(?:[.,]\d+)?)\s*(h|min|m|sec|s)?", duration))
    if seconds <= 0:
        return {"ok": False, "erreur": "La durée doit être positive."}
    started = time.time() * 1000
    result = qs_ipc("island", "timerFor", duration, label)
    if result.startswith("erreur :"):
        return {"ok": False, "erreur": result}
    # Le shell publie son état par écriture atomique, parfois après le retour IPC.
    for _ in range(8):
        try:
            state = json.loads((HOME / ".local/state/caelestia/island-clock.json").read_text())
            if (state.get("kind") == "timer" and state.get("label") == label
                    and state.get("total") == seconds and state.get("paused") == 0
                    and state.get("end", 0) >= started + seconds * 1000 - 100):
                return {"ok": True, "verifie": True, "duree": duration}
        except (OSError, ValueError, TypeError):
            pass
        time.sleep(0.05)
    return {"ok": False, "erreur": "Commande envoyée, mais le minuteur actif n'a pas pu être vérifié. Ne le relance pas automatiquement."}


def t_dnd(active: bool) -> dict:
    result = qs_ipc("notifs", "enableDnd" if active else "disableDnd")
    if result.startswith("erreur :"):
        return {"ok": False, "erreur": result}
    actual = qs_ipc("notifs", "isDndEnabled").lower()
    if actual != str(active).lower():
        return {"ok": False, "erreur": "État Ne pas déranger non confirmé.", "etat_lu": actual}
    return {"ok": True, "verifie": True, "actif": active}


def t_level(target: str, action: str = "lire", level: int | None = None) -> dict:
    """Réglages locaux bornés, sans interprétation supplémentaire par ANO."""
    if action not in {"lire", "regler", "augmenter", "diminuer", "couper", "retablir"}:
        return {"ok": False, "erreur": "Action inconnue."}
    if target == "luminosite" and action in {"couper", "retablir"}:
        return {"ok": False, "erreur": "Couper/rétablir concerne uniquement le son."}
    if level is not None and (isinstance(level, bool) or not isinstance(level, (int, float))
                              or not 0 <= level <= 100):
        return {"ok": False, "erreur": "Le niveau doit être un nombre entre 0 et 100."}
    if action == "regler" and level is None:
        return {"ok": False, "erreur": "Indique le niveau à régler."}
    cmd = ("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@") if target == "volume" else ("brightnessctl", "-m")

    def read():
        output = run(*cmd, timeout=2)
        if target == "volume":
            match = re.fullmatch(r"Volume:\s*(\d+(?:\.\d+)?)(?:\s+\[MUTED\])?", output)
            if match:
                return float(match[1]) * 100, "[MUTED]" in output
        else:
            fields = output.split(",")
            if len(fields) == 5 and fields[2].isdigit() and fields[4].isdigit() and int(fields[4]) > 0:
                return int(fields[2]) / int(fields[4]) * 100, False
        raise ValueError(f"État {target} illisible : {output[:200]}")

    before, muted = read()
    expected = before
    if action in {"couper", "retablir"}:
        muted = action == "couper"
        result = run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if muted else "0", timeout=2)
    elif action != "lire":
        delta = 10 if level is None else level
        expected = max(0, min(100, level if action == "regler" else before + delta * (1 if action == "augmenter" else -1)))
        result = (run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{expected}%", timeout=2)
                  if target == "volume" else run("brightnessctl", "set", f"{expected}%", timeout=2))
    else:
        return {"ok": True, "verifie": True, "niveau": round(before), "muet": muted}
    if result.startswith("erreur :"):
        return {"ok": False, "erreur": result}
    actual, actual_muted = read()
    verified = abs(actual - expected) <= 2 and (target != "volume" or actual_muted == muted)
    return {"ok": verified, "verifie": verified, "niveau": round(actual), "muet": actual_muted,
            "info": "État relu après la commande." if verified else "Le réglage demandé n'est pas confirmé : annonce seulement l'état lu."}


def t_volume(action: str = "lire", level: int | None = None) -> dict:
    return t_level("volume", action, level)


def t_brightness(action: str = "lire", level: int | None = None) -> dict:
    return t_level("luminosite", action, level)


def t_now() -> dict:
    now = dt.datetime.now()
    return {"maintenant": now.strftime("%A %d %B %Y, %H:%M")}


def t_location() -> dict:
    """Position la plus précise connue : GPS du téléphone (ANO-Remote) → dernier GPS → IP."""
    sys.path.insert(0, str(ANO))
    from core.geolocation import get_last_known_gps, get_user_location
    if RELAY is not None and RELAY.up and RELAY.connected and RELAY_LOOP is not None:
        try:  # demande un relevé GPS tout frais au téléphone
            asyncio.run_coroutine_threadsafe(RELAY.call("location", {}, timeout=10), RELAY_LOOP).result(timeout=12)
        except Exception:
            pass
    elif ano_running():
        try:
            from core.tool_bridge import call_app
            call_app("location", {"refresh": True}, timeout=12)
        except Exception:
            pass
    gps = get_last_known_gps()
    if gps:
        lat, lon = gps["lat"], gps["lon"]
        out = {"source": "GPS du téléphone (ANO-Remote)", "lat": lat, "lon": lon,
               "precision_m": gps.get("accuracy_m"), "carte": f"https://www.openstreetmap.org/?mlat={lat}&mlon={lon}#map=17/{lat}/{lon}"}
        age = gps["age_s"]
        if age > 20 * 60:
            out["attention"] = (f"relevé vieux de {age / 3600:.0f} h" if age < 172800 else f"relevé vieux de {age / 86400:.0f} jours") + \
                " : ouvrir ANO-Remote sur le téléphone avec ANO-GPT lancé pour une position à jour"
        out["releve_il_y_a"] = f"{age:.0f} s" if age < 120 else f"{age / 60:.0f} min" if age < 7200 else f"{age / 3600:.0f} h"
        try:
            import urllib.request
            req = urllib.request.Request(
                f"https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&accept-language=fr&lat={lat}&lon={lon}",
                headers={"User-Agent": "caelestia-siri"})
            with urllib.request.urlopen(req, timeout=8) as r:
                data = json.load(r)
            a = data.get("address") or {}
            pick = lambda *keys: next((a[k] for k in keys if a.get(k)), "")  # noqa: E731
            out.update({
                "quartier": pick("neighbourhood", "suburb", "quarter", "village", "hamlet", "city_district"),
                "rue": pick("road", "pedestrian", "footway"),
                "lieu_proche": pick("amenity", "shop", "building", "leisure"),
                "ville": pick("city", "town", "municipality"),
                "prefecture": a.get("county", ""), "region": a.get("state", ""), "pays": a.get("country", ""),
                "adresse_complete": data.get("display_name", ""),
            })
        except Exception:
            pass
        return out
    loc = get_user_location(force_refresh=True)
    return {"source": loc.get("source", "ip"), "ville": loc.get("city"), "pays": loc.get("country_name"),
            "info": "pas de GPS : position approximative"}


def t_screen(question: str) -> dict:
    from google import genai
    from google.genai import types
    path = Path(f"/tmp/caelestia-siri-{os.getpid()}.png")
    mon = run("sh", "-c", "hyprctl monitors -j | python3 -c 'import json,sys;print(next(m[\"name\"] for m in json.load(sys.stdin) if m[\"focused\"]))'")
    run("grim", *(["-o", mon] if mon and not mon.startswith("erreur") else []), str(path), timeout=6)
    if not path.exists():
        return {"erreur": "capture d'écran impossible"}
    try:
        client = genai.Client(api_key=CFG["api_key"])
        image = types.Part.from_bytes(data=path.read_bytes(), mime_type="image/png")
        prompt = ("Capture de l'écran de l'utilisateur (ignore le panneau de l'assistant au centre en haut). "
                  f"Réponds en français, de façon précise et concise : {question or 'Que vois-tu à l écran ?'}")
        last = ""
        # Comme ANO : on passe au modèle suivant quand l'un est saturé (503) ou limité (429)
        for model in CFG.get("vision_models") or ["gemini-flash-latest", "gemini-2.5-flash",
                                                  "gemini-flash-lite-latest", "gemini-pro-latest"]:
            try:
                res = client.models.generate_content(
                    model=model, contents=[image, prompt],
                    config=types.GenerateContentConfig(
                        automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=True)))
                if res.text:
                    return {"description": res.text[:4000]}
            except Exception as exc:
                last = str(exc)[:200]
        return {"erreur": f"vision indisponible : {last}"}
    finally:
        path.unlink(missing_ok=True)


# ── Actions d'ANO-GPT ─────────────────────────────────────────────────────────
# Siri utilise directement les actions d'ANO (mêmes déclarations, mêmes fonctions) :
# tout ce qu'ANO sait faire sur la machine, Siri le fait aussi, sans qu'ANO tourne.

ANO_TOOLS = {  # nom ANO → (module, fonction)
    "open_app": ("actions.open_app", "open_app"),
    "close_app": ("actions.close_app", "close_app"),
    "shell_exec": ("actions.shell_exec", "shell_exec"),
    "computer_settings": ("actions.computer_settings", "computer_settings"),
    "computer_control": ("actions.computer_control", "computer_control"),
    "browser_control": ("actions.browser_control", "browser_control"),
    "file_controller": ("actions.file_controller", "file_controller"),
    "hypr_orchestrator": ("actions.hypr_orchestrator", "hypr_orchestrator_control"),
    "devsecops": ("actions.devsecops", "devsecops_control"),
    "web_search": ("actions.web_search", "web_search"),
    "weather_report": ("actions.weather_report", "weather_action"),
    "system_status": ("actions.system_monitor", "get_system_status"),
    "system_state": ("actions.system_probe", "system_state"),
    "reminder": ("actions.reminder", "reminder"),
    "youtube_video": ("actions.youtube_video", "youtube_video"),
    "music_control": ("actions.music", "music_control"),
    "download_music": ("actions.download_music", "download_music"),
    "capture_control": ("actions.capture", "capture_control"),
    "find_nearby": ("actions.find_nearby", "find_nearby"),
    "email_control": ("actions.email", "email_control"),
    "calendar_control": ("actions.calendar", "calendar_control"),
    "contacts_control": ("actions.contacts", "contacts_control"),
    "github_control": ("actions.github", "github_control"),
    "cloud_integrations_control": ("actions.cloud_integrations", "cloud_integrations_control"),
    "send_message": ("actions.send_message", "send_message"),
    "prayer_control": ("actions.prayer", "prayer_control"),
}
# Téléphone (ANO-Remote) : seul le processus ANO-GPT détient la liaison avec le téléphone
ANO_RELAYED = {"phone_call", "phone_hangup", "phone_contacts", "phone_sms"}
ANO_DECLS: list = []
ANO_RUNTIME = None
ANO_MEMORY: dict = {}


class _Noop:
    """Remplace l'interface d'ANO (HUD) : toute méthode existe et ne fait rien."""

    def __call__(self, *a, **k):
        return None

    def __bool__(self):
        return False

    def __getattr__(self, name):
        return _Noop()


class AnoUI(_Noop):
    current_file = None

    def show_card(self, kind="", title="", body="", *a, **k):
        if kind == "result" and body:
            emit(stage="card", title=str(title), body=str(body)[:4000])

    def write_log(self, text="", *a, **k):
        print(text, file=sys.stderr)


def notify(title: str, body: str = "") -> None:
    subprocess.Popen(["notify-send", "-a", CFG["name"], title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_ano() -> None:
    """Charge les déclarations d'ANO (≈ 2 s) et branche sa barrière de confirmation."""
    global ANO_DECLS, ANO_RUNTIME
    if ANO_RUNTIME is not None or not (ANO / "core/tool_dispatcher.py").exists():
        return
    sys.path.insert(0, str(ANO))
    os.chdir(ANO)  # certaines actions lisent des chemins relatifs
    import warnings
    warnings.filterwarnings("ignore")
    from core import human_confirmation
    from core.action_runtime import ActionRuntime
    from core.tool_dispatcher import TOOL_DECLARATIONS

    def show(pending):
        # Comme le HUD d'ANO : un clic humain (bouton de la notification) valide l'action
        def wait():
            try:
                r = subprocess.run(["notify-send", "-u", "critical", "-a", CFG["name"], "--wait",
                                    "-A", "ok=Confirmer", "-A", "no=Annuler",
                                    f"Confirmer : {pending.title}", pending.detail],
                                   capture_output=True, text=True, timeout=95)
                human_confirmation.resolve(pending.token, r.stdout.strip() == "ok", source="siri")
            except Exception:
                human_confirmation.resolve(pending.token, False, source="siri")
        import threading
        threading.Thread(target=wait, daemon=True).start()
        emit(stage="tool", label=f"Confirme dans la notification : {pending.title}")

    human_confirmation.bind(show=show, notify=lambda m: notify(CFG["name"], m),
                            log=lambda m: print(m, file=sys.stderr))
    ANO_DECLS = [d for d in TOOL_DECLARATIONS if d["name"] in ANO_TOOLS or d["name"] in ANO_RELAYED]
    ANO_RUNTIME = ActionRuntime(ANO_DECLS)


def call_ano(name: str, args: dict) -> str:
    import importlib
    import inspect
    if name in ANO_RELAYED and RELAY is not None and RELAY.up and RELAY_LOOP is not None:
        fut = asyncio.run_coroutine_threadsafe(RELAY.call(name, args, timeout=60), RELAY_LOOP)
        result = fut.result(timeout=65)
        if not RELAY.connected and "indisponible" not in result.lower():
            result += " (Attention : ANO Remote ne semble pas connecté — ouvrir l'appli sur le téléphone.)"
        return result
    if name in ANO_RELAYED:
        from core.tool_bridge import AppUnavailable, call_app
        try:
            return call_app(name, args, timeout=50)
        except AppUnavailable:
            return "Le relais téléphone n'est pas prêt : réessaie dans quelques secondes."
    mod, fn_name = ANO_TOOLS[name]
    fn = getattr(importlib.import_module(mod), fn_name)
    try:
        params = ANO_RUNTIME.prepare(name, args)
    except Exception:
        params = dict(args)
    params = {k: v for k, v in params.items() if not k.startswith("_")}
    if name == "system_status":
        return str(fn())
    if name == "system_state":
        return str(fn(str(params.get("topic") or "all")))
    ui = AnoUI()
    offer = {"parameters": params, "player": ui, "ui": ui, "response": None,
             "session_memory": ANO_MEMORY, "speak": lambda *_: None}
    sig = inspect.signature(fn)
    takes_all = any(p.kind == p.VAR_KEYWORD for p in sig.parameters.values())
    kwargs = {k: v for k, v in offer.items() if takes_all or k in sig.parameters}
    if "parameters" not in sig.parameters and not takes_all:
        kwargs = {}
    result = fn(**kwargs)
    return str(result) if result is not None and result != "" else "Résultat absent : action non confirmée. Vérifie l'état réel avant d'annoncer une réussite."


# ── ANO Remote sans ANO-GPT ───────────────────────────────────────────────────
# Le téléphone se connecte au serveur d'ANO (dashboard, port 8000, appairage sur disque).
# Quand ANO-GPT est éteint, Siri fait tourner ce même serveur dans un sous-processus
# `caelestia-siri phone-relay` ; dès qu'ANO démarre, le relais s'arrête et lui rend le port.

def ano_running() -> bool:
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if b"ANO-GPT/main.py" in (d / "cmdline").read_bytes():
                    return True
            except OSError:
                pass
    return False


def port_free(port: int) -> bool:
    import socket
    with socket.socket() as sock:
        sock.settimeout(0.3)
        return sock.connect_ex(("127.0.0.1", port)) != 0


class PhoneRelay:
    """Côté Siri : lance / arrête le relais et lui passe les demandes (JSON lignes)."""

    def __init__(self, on_command):
        self.proc = None
        self.on_command = on_command
        self.waiters: dict[int, asyncio.Future] = {}
        self.next_id = 0
        self.connected = False

    @property
    def up(self) -> bool:
        return self.proc is not None and self.proc.returncode is None

    async def supervise(self):
        while True:
            try:
                ano = await asyncio.to_thread(ano_running)
                if ano and self.up:
                    print("ANO-GPT démarre : le relais téléphone lui rend la main", file=sys.stderr)
                    self.proc.terminate()
                    await self.proc.wait()
                elif not ano and not self.up and (ANO / "dashboard/server.py").exists() and port_free(8000):
                    self.proc = await asyncio.create_subprocess_exec(
                        sys.executable, str(Path(__file__).resolve()), "phone-relay",
                        stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE)
                    asyncio.create_task(self.read(self.proc))
            except Exception as exc:
                print(f"relais téléphone : {exc}", file=sys.stderr)
            await asyncio.sleep(2)

    async def read(self, proc):
        while True:
            line = await proc.stdout.readline()
            if not line:
                break
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if "id" in msg and msg["id"] in self.waiters:
                self.waiters.pop(msg["id"]).set_result(msg.get("result", ""))
            elif "phone" in msg:
                self.connected = bool(msg["phone"])
            elif msg.get("command"):
                await self.on_command(msg["command"])
        self.connected = False
        for fut in self.waiters.values():
            if not fut.done():
                fut.set_result("Le relais téléphone s'est arrêté.")
        self.waiters.clear()

    def send(self, msg: dict):
        if self.up:
            self.proc.stdin.write((json.dumps(msg, ensure_ascii=False) + "\n").encode())

    async def call(self, tool: str, args: dict, timeout: float = 45) -> str:
        if not self.up:
            raise ConnectionError("relais arrêté")
        self.next_id += 1
        fut = asyncio.get_running_loop().create_future()
        self.waiters[self.next_id] = fut
        self.send({"id": self.next_id, "tool": tool, "args": args})
        return await asyncio.wait_for(fut, timeout)


RELAY: PhoneRelay | None = None
RELAY_LOOP = None


async def phone_relay_main():
    """Sous-processus : le serveur ANO Remote d'ANO-GPT, sans le reste d'ANO."""
    sys.path.insert(0, str(ANO))
    os.chdir(ANO)
    import threading
    import warnings
    warnings.filterwarnings("ignore")
    from core import human_confirmation
    from core.tool_dispatcher import _render_phone_outcome
    from dashboard.server import DashboardServer

    loop = asyncio.get_running_loop()
    dash = DashboardServer()

    def out(**msg):
        OUT.write(json.dumps(msg, ensure_ascii=False) + "\n")
        OUT.flush()

    def show(pending):  # SMS : validé par un clic (notification) ou depuis le téléphone
        def wait():
            r = subprocess.run(["notify-send", "-u", "critical", "-a", CFG["name"], "--wait",
                                "-A", "ok=Confirmer", "-A", "no=Annuler",
                                f"Confirmer : {pending.title}", pending.detail],
                               capture_output=True, text=True, timeout=95)
            human_confirmation.resolve(pending.token, r.stdout.strip() == "ok", source="siri")
        threading.Thread(target=wait, daemon=True).start()

    human_confirmation.bind(show=show, notify=lambda m: notify(CFG["name"], m),
                            log=lambda m: print(m, file=sys.stderr))
    dash.set_confirmation_callback(lambda token, ok: human_confirmation.resolve(token, ok, source="AnoRemote"))
    dash.spawn(dash.serve(), "dashboard-serve")

    async def commands():  # messages tapés dans ANO Remote → Siri
        while True:
            text = await dash._command_queue.get()
            if text:
                out(command=text)

    async def presence():
        last = None
        while True:
            now = bool(dash._phone_clients)
            if now != last:
                out(phone=now)
                last = now
            await asyncio.sleep(1)

    def variants(q: str) -> list:
        """Android ne relie pas « soeur » et « sœur » : on essaie les écritures possibles."""
        q = re.sub(r"^(?:ma|mon|mes|la|le)\s+", "", q.strip(), flags=re.I)
        out = []
        for v in (q, q.replace("oe", "œ").replace("Oe", "Œ"), q.replace("œ", "oe").replace("Œ", "Oe"),
                  q.replace("ae", "æ"), q.replace("æ", "ae")):
            for w in (v, v[:1].upper() + v[1:], v.lower()):
                if w and w not in out:
                    out.append(w)
        return out

    async def search(q: str):
        """(requête qui marche, résultat Android) — la première écriture qui trouve quelque chose."""
        first = None
        for v in variants(q):
            res = await dash.request_phone_contacts(v)
            first = first or res
            if res.get("choices") or res.get("ok") and "aucun" not in str(res.get("message", "")).lower():
                return v, res
        return q, first or {}

    async def resolve(target: str, selection: int):
        """Nom → (requête Android, choix) : prend le contact dont le nom correspond exactement."""
        if selection or re.fullmatch(r"[+\d\s().-]{6,}", target):
            return target, selection, None
        query, res = await search(target)
        choices = [c for c in res.get("choices") or [] if isinstance(c, dict)]
        want = fold(re.sub(r"^(?:ma|mon|mes|la|le)\s+", "", target.strip(), flags=re.I))
        exact = [c for c in choices if fold(str(c.get("name", ""))) == want]
        if len(exact) == 1:
            return query, int(exact[0].get("index") or 0), exact[0]
        if len(choices) == 1:
            return query, int(choices[0].get("index") or 0), choices[0]
        return query, 0, None

    async def tool(name: str, a: dict) -> str:
        if name == "phone_call":
            target = str(a.get("target") or "").strip()
            if not target:
                return "Indiquez le nom ou le numéro à appeler."
            query, sel, picked = await resolve(target, int(a.get("selection") or 0))
            msg = _render_phone_outcome(await dash.request_phone_call(query, selection=sel),
                                        "Commande téléphonique traitée.")
            return (f"Contact choisi : {picked.get('name')} ({picked.get('number_hint')}). " if picked else "") + msg
        if name == "phone_hangup":
            return _render_phone_outcome(await dash.request_phone_hangup(), "Demande de raccrochage traitée.")
        if name == "phone_contacts":
            query, res = await search(str(a.get("query") or ""))
            return f"(recherche Android : « {query} ») " + _render_phone_outcome(
                res, "Recherche de contacts traitée.", choices_hint="Ce sont les contacts du téléphone.")
        if name == "phone_sms":
            target, body = str(a.get("target") or "").strip(), str(a.get("body") or "").strip()
            if not target or not body:
                return "Indiquez le destinataire et le texte du SMS."
            target, sel, picked = await resolve(target, int(a.get("selection") or 0))
            a = {**a, "selection": sel}

            def send() -> str:
                fut = asyncio.run_coroutine_threadsafe(
                    dash.request_phone_sms(target, body, int(a.get("selection") or 0)), loop)
                return _render_phone_outcome(fut.result(timeout=40), "Commande SMS traitée.")
            who = f"{picked.get('name')} ({picked.get('number_hint')})" if picked else target
            return human_confirmation.request("phone:sms", "Envoyer un SMS depuis le téléphone",
                                              f"Destinataire : {who}\n\n{body}", send)
        if name == "location":
            return "ok" if await dash.request_fresh_location(timeout=8.0) else "pas de réponse du téléphone"
        if name == "log":
            await dash.broadcast({"type": "log", "speaker": a.get("speaker", "jarvis"), "text": a.get("text", ""),
                                  "ts": dt.datetime.now().isoformat()})
            return "ok"
        return f"outil inconnu : {name}"

    async def handle(msg):
        try:
            result = await tool(msg.get("tool", ""), msg.get("args") or {})
        except Exception as exc:
            result = f"Échec : {str(exc)[:300]}"
        if "id" in msg:
            out(id=msg["id"], result=result)

    asyncio.create_task(commands())
    asyncio.create_task(presence())
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    while True:
        line = await reader.readline()
        if not line:
            os._exit(0)  # Siri parti : on libère le port
        try:
            asyncio.create_task(handle(json.loads(line)))
        except ValueError:
            pass


