#!/usr/bin/env python3
"""Assistant vocal façon Siri pour Caelestia (Super + Maj + Espace).

    caelestia-siri serve        serveur persistant piloté par le shell (JSON lignes)
    caelestia-siri --file a.wav test : envoie un fichier comme s'il venait du micro

Même chaîne que ANO-GPT : Gemini Live audio natif (gemini-3.8-live → 3.1-flash-live
→ 2.5 native-audio, API v1alpha, voix de ANO), VAD serveur, reprise de session
(la conversation continue d'une ouverture à l'autre pendant 15 min) et
compression de contexte (pas de fin de session sur une longue conversation).

Micro coupé par défaut, comme « Écrire à Siri » : on écrit, ou on active le micro
pour UNE demande ({"mic":true}) ; il se recoupe après la réponse.
Option "micro_par_defaut": true dans config.json pour l'ancien comportement.

Entrée : {"open":true} {"close":true} {"interrupt":true} {"text":"…"} {"mic":true|false|"toggle"}
Sortie : {"stage":"state","state":"connexion|ecoute|reflexion|parle|outil|erreur","detail"}
         {"stage":"level","v",who:"mic|voice"} {"stage":"user","text"} {"stage":"reply","text"}
         {"stage":"tool","label"} {"stage":"mic","on"} {"stage":"idle"} (le shell ferme)
"""

import asyncio
import datetime as dt
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import wave
from pathlib import Path

import numpy as np

HOME = Path.home()
ANO = HOME / "OUTILS/ANO-GPT"
CONFIG = HOME / ".config/caelestia-siri/config.json"
MIC_RATE, OUT_RATE = 16000, 24000
CHUNK_MS = 64
MIC_CHUNK = MIC_RATE * 2 * CHUNK_MS // 1000
HANDLE_TTL = 900  # au-delà, Gemini a oublié la session
IDLE_AFTER_REPLY = 8.0
IDLE_BEFORE_ANY = 14.0


def load_config() -> dict:
    ano = {}
    try:
        ano = json.loads((ANO / "config/api_keys.json").read_text())
    except (OSError, ValueError):
        pass
    cfg = {
        "name": "Siri",
        "api_key": os.environ.get("GEMINI_API_KEY", "") or ano.get("gemini_live_api_key") or ano.get("gemini_api_key", ""),
        "models": [m for m in (ano.get("live_model") or "models/gemini-3.8-live",
                               ano.get("live_model_fallback") or "models/gemini-3.1-flash-live-preview",
                               ano.get("live_model_emergency") or "models/gemini-2.5-flash-native-audio-latest") if m],
        "api_version": ano.get("gemini_live_api_version") or "v1alpha",
        "voice": ano.get("live_voice") or "Charon",
        "language": ano.get("conversation_language") or "fr-FR",
        "city": ano.get("user_city") or "",
        "micro_par_defaut": False,
    }
    try:
        cfg.update(json.loads(CONFIG.read_text()))
    except (OSError, ValueError):
        pass
    return cfg


CFG = load_config()


_last_state = None


def emit(**msg) -> None:
    global _last_state
    if msg.get("stage") == "state":
        key = (msg.get("state"), msg.get("detail"))
        if key == _last_state:
            return
        _last_state = key
    sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def run(*cmd: str, timeout: float = 4) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception as exc:
        return f"erreur : {exc}"


def qs_ipc(*args: str) -> str:
    return run("qs", "ipc", "-c", "caelestia", "call", *args)


def fold(s: str) -> str:
    return "".join(c for c in unicodedata.normalize("NFD", s.casefold()) if unicodedata.category(c) != "Mn")


# ── Outils ────────────────────────────────────────────────────────────────────

def t_open_app(name: str) -> dict:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    q = fold(name)
    best, score = None, 0
    for app in Gio.AppInfo.get_all():
        if not app.should_show():
            continue
        names = [app.get_display_name() or "", app.get_name() or "", app.get_id() or ""]
        names += list(getattr(app, "get_keywords", lambda: [])() or [])
        for n in names:
            f = fold(n).removesuffix(".desktop")
            s = 100 if f == q else 80 if f.startswith(q) else 60 if q in f.split() else 40 if q in f else 0
            if s > score:
                best, score = app, s
    if not best:
        return {"ok": False, "erreur": f"aucune application ne correspond à « {name} »"}
    subprocess.Popen(["gio", "launch", best.get_filename()], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {"ok": True, "application": best.get_display_name()}


def t_open_url(url: str) -> dict:
    if not re.match(r"^[a-z]+://", url):
        url = "https://" + url
    subprocess.Popen(["xdg-open", url], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {"ok": True}


def t_web_search(query: str) -> dict:
    sys.path.insert(0, str(ANO))
    from actions.web_search import web_search
    import contextlib
    import io
    with contextlib.redirect_stdout(io.StringIO()):  # ses journaux casseraient le JSON
        text = web_search({"query": query})
    return {"resultats": text[:6000]}


def t_timer(duration: str, label: str = "") -> dict:
    qs_ipc("island", "timerFor", duration, label)
    return {"ok": True, "duree": duration}


def t_media(action: str) -> dict:
    fn = {"lecture": "play", "pause": "pause", "basculer": "playPause", "suivant": "next",
          "precedent": "previous", "stop": "stop"}.get(action, "playPause")
    qs_ipc("mpris", fn)
    return {"ok": True}


def t_volume(level: str) -> dict:
    sink = "@DEFAULT_AUDIO_SINK@"
    if level in ("muet", "silence"):
        run("wpctl", "set-mute", sink, "1")
    elif level == "reactiver":
        run("wpctl", "set-mute", sink, "0")
    elif level in ("plus", "moins"):
        run("wpctl", "set-volume", "-l", "1.0", sink, "10%+" if level == "plus" else "10%-")
    else:
        n = max(0, min(100, int(re.sub(r"\D", "", level) or 50)))
        run("wpctl", "set-mute", sink, "0")
        run("wpctl", "set-volume", sink, f"{n}%")
    return {"ok": True, "volume": run("wpctl", "get-volume", sink)}


def t_brightness(level: int) -> dict:
    qs_ipc("brightness", "set", f"{max(1, min(100, int(level))) / 100:.2f}")
    return {"ok": True}


def t_dnd(active: bool) -> dict:
    qs_ipc("notifs", "enableDnd" if active else "disableDnd")
    return {"ok": True}


def t_now() -> dict:
    now = dt.datetime.now()
    return {"maintenant": now.strftime("%A %d %B %Y, %H:%M")}


# Fenêtre active au moment où l'assistant a été appelé (« ferme ça », « mets-la en plein écran »)
ACTIVE = {"address": ""}
DEICTIC = {"", "ca", "cela", "ceci", "celle-ci", "celui-ci", "cette", "cette fenetre", "cette application",
           "fenetre active", "active", "actuelle", "la fenetre", "l'application", "ici"}


def hypr_clients() -> list:
    try:
        return json.loads(run("hyprctl", "clients", "-j")) or []
    except ValueError:
        return []


def hypr(*args: str) -> str:
    return run("hyprctl", "dispatch", *args)


def find_windows(name: str) -> list:
    q = fold(name).strip()
    wins = [w for w in hypr_clients() if w.get("mapped", True) and w.get("address")]
    if q in DEICTIC:
        return [w for w in wins if w["address"] == ACTIVE["address"]]
    scored = []
    for w in wins:
        fields = [fold(w.get(k) or "") for k in ("class", "initialClass", "title", "initialTitle")]
        fields = [f.split(".")[-1] if k < 2 else f for k, f in enumerate(fields)]  # org.gnome.Nautilus → nautilus
        s = max((100 if f == q else 80 if f.startswith(q) else 60 if q in f else 0) for f in fields)
        if s:
            scored.append((s, w))
    if not scored:
        return []
    top = max(s for s, _ in scored)
    return [w for s, w in scored if s == top]


def label(w: dict) -> str:
    return f"{w.get('class') or '?'} — {(w.get('title') or '')[:60]}"


def t_close_app(name: str, everything: bool = True) -> dict:
    wins = find_windows(name)
    if not everything:
        wins = wins[:1]
    for w in wins:
        hypr("closewindow", f"address:{w['address']}")
    if wins:
        time.sleep(0.6)
        left = {w["address"] for w in hypr_clients()} & {w["address"] for w in wins}
        return {"ok": True, "fermees": [label(w) for w in wins],
                "info": "certaines demandent une confirmation dans l'application" if left else ""}
    # Pas de fenêtre : processus en arrière-plan (lecteur, démon…)
    q = re.sub(r"[^a-z0-9_.-]", "", fold(name))
    if q and run("pgrep", "-ix", q):
        run("pkill", "-ix", q)
        return {"ok": True, "processus_arrete": q}
    return {"ok": False, "erreur": f"aucune fenêtre ni processus « {name} » ouvert",
            "fenetres_ouvertes": [label(w) for w in hypr_clients()][:20]}


def t_window(action: str, target: str = "", workspace: int = 0) -> dict:
    a = fold(action)
    if a in ("lister", "liste"):
        return {"fenetres": [f"{label(w)} (bureau {w.get('workspace', {}).get('id')})" for w in hypr_clients()]}
    wins = find_windows(target)
    if not wins:
        return {"ok": False, "erreur": f"fenêtre « {target or 'active'} » introuvable"}
    addr = f"address:{wins[0]['address']}"
    if a in ("focus", "afficher", "aller"):
        hypr("focuswindow", addr)
    elif a in ("plein_ecran", "pleinecran"):
        hypr("focuswindow", addr)
        hypr("fullscreen", "0")
    elif a in ("agrandir", "maximiser"):
        hypr("focuswindow", addr)
        hypr("fullscreen", "1")
    elif a == "flottant":
        hypr("togglefloating", addr)
    elif a == "epingler":
        hypr("focuswindow", addr)
        hypr("pin", addr)
    elif a in ("deplacer_bureau", "deplacer"):
        hypr("movetoworkspacesilent", f"{workspace},{addr}")
    elif a in ("minimiser", "cacher"):
        hypr("movetoworkspacesilent", f"special:minimized,{addr}")
    elif a == "fermer":
        hypr("closewindow", addr)
    else:
        return {"ok": False, "erreur": f"action inconnue : {action}"}
    return {"ok": True, "fenetre": label(wins[0])}


def t_workspace(number: int) -> dict:
    hypr("workspace", str(int(number)))
    return {"ok": True}


BLOCKED = re.compile("|".join([
    r"\brm\s+-[a-z]*r[a-z]*\s+(?:-\S+\s+)*(?:/|/\*|~/?|\$HOME/?)(?:\s|$)", r"--no-preserve-root",
    r"\bmkfs", r"\bdd\s+.*of=/dev/", r":\(\)\s*\{", r"\bwipefs\b", r">\s*/dev/(?:sd|nvme)",
]), re.I)
RISKY = re.compile("|".join([
    r"\bsudo\b", r"\bdoas\b", r"\brm\s+-[a-z]*r", r"\bkillall\b", r"\bpkill\b",
    r"\bsystemctl\s+(?:stop|disable|mask|poweroff|reboot)", r"\b(?:shutdown|reboot|poweroff)\b",
    r"\bgit\s+(?:reset\s+--hard|push\s+.*--force|clean\s+-\w*f)", r"\bpacman\s+-R", r"\byay\s+-R",
    r"\bchmod\s+-R\b", r"\bchown\s+-R\b", r"\bdd\b", r"\bmv\s+.*\s/dev/null",
]), re.I)


def t_shell(command: str, confirmed: bool = False) -> dict:
    if BLOCKED.search(command):
        return {"ok": False, "erreur": "commande destructrice refusée"}
    if RISKY.search(command) and not confirmed:
        return {"ok": False, "confirmation_requise": True,
                "info": "commande sensible : demande à l'utilisateur s'il confirme, puis rappelle avec confirme=true"}
    if "sudo" in command and "-A" not in command and "-n" not in command:
        command = command.replace("sudo ", "sudo -n ", 1)  # pas de mot de passe à taper ici
    try:
        p = subprocess.run(["bash", "-lc", command], capture_output=True, text=True, timeout=45,
                           cwd=HOME, start_new_session=True, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return {"ok": False, "erreur": "délai de 45 s dépassé (pour une application graphique, utilise ouvrir_application)"}
    out = (p.stdout or "") + (("\n[stderr] " + p.stderr) if p.stderr.strip() else "")
    if len(out) > 5000:
        out = out[:2500] + "\n…\n" + out[-2500:]
    return {"code_retour": p.returncode, "sortie": out.strip() or "(aucune sortie)"}


def t_screen(question: str) -> dict:
    from google import genai
    from google.genai import types
    path = Path(f"/tmp/caelestia-siri-{os.getpid()}.png")
    mon = run("sh", "-c", "hyprctl monitors -j | python3 -c 'import json,sys;print(next(m[\"name\"] for m in json.load(sys.stdin) if m[\"focused\"]))'")
    run("grim", *(["-o", mon] if mon and not mon.startswith("erreur") else []), str(path), timeout=6)
    if not path.exists():
        return {"erreur": "capture d'écran impossible"}
    try:
        client = genai.Client(api_key=CFG["api_key"])
        res = client.models.generate_content(
            model=CFG.get("vision_model", "gemini-flash-latest"),
            contents=[types.Part.from_bytes(data=path.read_bytes(), mime_type="image/png"),
                      f"Capture de l'écran de l'utilisateur (ignore le panneau de l'assistant au centre en haut). "
                      f"Réponds en français, de façon précise et concise : {question or 'Que vois-tu à l écran ?'}"])
        return {"description": (res.text or "")[:4000]}
    finally:
        path.unlink(missing_ok=True)


def t_clipboard(action: str, text: str = "") -> dict:
    if fold(action) in ("ecrire", "copier"):
        subprocess.run(["wl-copy"], input=text, text=True, timeout=4)
        return {"ok": True}
    return {"contenu": run("wl-paste", "-n")[:4000]}


def t_files(action: str, path: str) -> dict:
    a = fold(action)
    p = Path(os.path.expanduser(path))
    if a == "chercher":
        found = run("fd", "-i", "-H", "--max-results", "25", "-E", ".git", "-E", "node_modules", "-E", ".cache",
                    path, str(HOME), timeout=10)
        return {"resultats": found.splitlines() or ["rien trouvé"]}
    if not p.is_absolute():
        p = HOME / p
    if a == "ouvrir":
        if not p.exists():
            return {"erreur": f"{p} n'existe pas"}
        subprocess.Popen(["xdg-open", str(p)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"ok": True}
    if a == "lister":
        items = sorted(p.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:60]
        return {"contenu": [x.name + ("/" if x.is_dir() else "") for x in items]}
    if a == "lire":
        return {"contenu": p.read_text(errors="replace")[:6000]}
    return {"erreur": f"action inconnue : {action}"}


def t_sysinfo() -> dict:
    load = os.getloadavg()[0]
    mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo") if ":" in l}
    disk = os.statvfs(str(HOME))
    bat = run("sh", "-c", "cat /sys/class/power_supply/BAT*/capacity /sys/class/power_supply/BAT*/status 2>/dev/null")
    return {
        "charge_cpu": f"{load:.1f} sur {os.cpu_count()} cœurs",
        "memoire": f"{(mem['MemTotal'] - mem['MemAvailable']) / 2**20:.1f} Go utilisés sur {mem['MemTotal'] / 2**20:.1f}",
        "disque_libre": f"{disk.f_bavail * disk.f_frsize / 2**30:.0f} Go",
        "batterie": bat.replace("\n", " ") or "pas de batterie",
        "wifi": run("sh", "-c", "nmcli -t -f active,ssid dev wifi | grep '^oui\\|^yes' | cut -d: -f2") or "non connecté",
        "allume_depuis": run("uptime", "-p"),
        "processus_gourmands": run("sh", "-c", "ps -eo comm,%cpu,%mem --sort=-%cpu | head -6"),
    }


def t_radio(device: str, active: bool) -> dict:
    if "blue" in fold(device):
        run("bluetoothctl", "power", "on" if active else "off")
    else:
        run("nmcli", "radio", "wifi", "on" if active else "off")
    return {"ok": True}


def t_reminder(message: str, delay: str = "", time_: str = "") -> dict:
    cmd = ["systemd-run", "--user", "--collect", f"--unit=siri-rappel-{int(time.time())}"]
    if time_:
        hh = re.sub(r"\s*h\s*", ":", time_.strip()).rstrip(":")
        cmd.append(f"--on-calendar={hh if ':' in hh else hh + ':00'}")
    else:
        d = re.sub(r"(\d+)\s*m(?:in)?\b", r"\1min", delay or "10min")
        cmd.append(f"--on-active={d}")
    cmd += ["notify-send", "-u", "critical", "-a", CFG["name"], "Rappel", message]
    out = run(*cmd)
    return {"ok": "Running" in out or not out.startswith("erreur"), "detail": out[:200]}


