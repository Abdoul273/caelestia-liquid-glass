class ShortcutsApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="io.caelestia.Shortcuts", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window: Gtk.ApplicationWindow | None = None
        self.cards: list[tuple[Gtk.Widget, list[tuple[Gtk.Widget, str]]]] = []

    def do_activate(self) -> None:
        if self.window is not None:
            self.window.close()
            return
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(str(CSS_FILE))
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except GLib.Error:
            pass
        self.build()
        self.window.present()
        self.search.grab_focus()

    def build(self) -> None:
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.add_css_class("caelestia-tool")  # exclu du verre GTK générique
        self.window.set_title("Raccourcis")
        self.window.set_default_size(1120, 760)
        self.window.connect("close-request", self.on_close)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.add_css_class("sc-root")
        self.window.set_child(root)

        header = Gtk.Box(spacing=14)
        header.add_css_class("sc-header")
        root.append(header)
        logo = Gtk.Label(label="󰌌")
        logo.add_css_class("sc-logo")
        header.append(logo)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title = Gtk.Label(label="Raccourcis clavier", xalign=0)
        title.add_css_class("sc-title")
        sub = Gtk.Label(label="Tout ce que tu peux faire au clavier et au pavé tactile", xalign=0)
        sub.add_css_class("sc-sub")
        titles.append(title)
        titles.append(sub)
        header.append(titles)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)
        self.search = Gtk.SearchEntry(placeholder_text="Chercher une action ou une touche…")
        self.search.add_css_class("sc-search")
        self.search.set_size_request(340, -1)
        self.search.connect("search-changed", self.on_search)
        header.append(self.search)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        root.append(scroll)
        # Deux colonnes en mosaïque : chaque carte va dans la colonne la moins remplie
        columns = Gtk.Box(spacing=14, homogeneous=True)
        columns.add_css_class("sc-columns")
        columns.set_valign(Gtk.Align.START)
        scroll.set_child(columns)
        cols = []
        for _ in range(2):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            col.set_valign(Gtk.Align.START)
            columns.append(col)
            cols.append([col, 0])
        for name, icon, items in SHORTCUTS:
            target = min(cols, key=lambda c: c[1])
            target[0].append(self.make_card(name, icon, items))
            target[1] += len(items) + 2

        self.empty = Gtk.Label(label="Aucun raccourci ne correspond à ta recherche.")
        self.empty.add_css_class("sc-empty")
        self.empty.set_visible(False)
        root.append(self.empty)

        footer = Gtk.Label(label="Échap : fermer  •  Super + H : ouvrir / fermer cette fenêtre")
        footer.add_css_class("sc-footer")
        root.append(footer)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.window.add_controller(keys)

    def make_card(self, name: str, icon: str, items) -> Gtk.Widget:
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.add_css_class("sc-card")
        head = Gtk.Box(spacing=10)
        ic = Gtk.Label(label=icon)
        ic.add_css_class("sc-card-icon")
        head.append(ic)
        t = Gtk.Label(label=name, xalign=0)
        t.add_css_class("sc-card-title")
        head.append(t)
        card.append(head)
        rows = []
        for keys, desc in items:
            row = Gtk.Box(spacing=12)
            row.add_css_class("sc-row")
            label = Gtk.Label(label=desc, xalign=0)
            label.add_css_class("sc-desc")
            label.set_hexpand(True)
            label.set_wrap(True)
            label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            label.set_max_width_chars(34)
            row.append(label)
            row.append(self.make_keys(keys))
            card.append(row)
            rows.append((row, f"{keys} {desc} {name}".lower()))
        self.cards.append((card, rows))
        return card

    @staticmethod
    def make_keys(keys: str) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_halign(Gtk.Align.END)
        box.set_valign(Gtk.Align.CENTER)
        for combo in keys.split(" | "):
            line = Gtk.Box(spacing=4)
            line.set_halign(Gtk.Align.END)
            parts = combo.split(" + ")
            for i, part in enumerate(parts):
                if i:
                    plus = Gtk.Label(label="+")
                    plus.add_css_class("sc-plus")
                    line.append(plus)
                cap = Gtk.Label(label=part.strip())
                cap.add_css_class("sc-key")
                line.append(cap)
            box.append(line)
        return box

    def on_search(self, *_args) -> None:
        q = self.search.get_text().strip().lower()
        words = q.split()
        any_visible = False
        for child, rows in self.cards:
            visible_rows = 0
            for row, text in rows:
                show = all(w in text for w in words)
                row.set_visible(show)
                visible_rows += show
            child.set_visible(visible_rows > 0)
            any_visible |= visible_rows > 0
        self.empty.set_visible(not any_visible)

    def on_key(self, _ctrl, keyval, _code, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.window.close()
            return True
        return False

    def on_close(self, *_args) -> bool:
        self.window = None
        return False


# ---------------------------------------------------------------- shell : liste JSON + touches simulées

KEYCODES = {
    "super": 125, "ctrl": 29, "maj": 42, "shift": 42, "alt": 56,
    "espace": 57, "tab": 15, "retour arrière": 14, "entrée": 28, "échap": 1,
    "←": 105, "→": 106, "↑": 103, "↓": 108, "page↑": 104, "page↓": 109,
    ",": 51, ".": 52, "`": 41, "−": 12, "-": 12, "=": 13, "\\": 43,
    "impr. écran": 99, "f12": 88,
}
KEYCODES.update({c: code for c, code in zip("qwertyuiop", range(16, 26))})
KEYCODES.update({c: code for c, code in zip("asdfghjkl", range(30, 39))})
KEYCODES.update({c: code for c, code in zip("zxcvbnm", range(44, 51))})
KEYCODES.update({str(d): 2 + (d - 1) % 10 for d in range(1, 10)})
KEYCODES["0"] = 11


def key_codes(keys: str) -> list[int] | None:
    """« Super + Maj + S » → codes evdev, ou None si ce n'est pas une combinaison simple."""
    first = keys.split("|")[0].strip()
    if any(w in first.lower() for w in ("…", "puis", "clic", "molette", "doigt", "touche", "souris", "glisser", "survol")):
        return None
    codes = []
    for part in [p.strip().lower() for p in first.split("+")]:
        if part in ("← → ↑ ↓",) or not part:
            return None
        if part not in KEYCODES:
            return None
        codes.append(KEYCODES[part])
    return codes or None


def dump_json() -> int:
    import json
    out = []
    for cat, icon, rows in SHORTCUTS:
        for keys, desc in rows:
            out.append({"cat": cat, "icon": icon, "keys": keys, "desc": desc,
                        "run": key_codes(keys) is not None and keys != "Super + H"})
    print(json.dumps(out, ensure_ascii=False))
    return 0


def press(keys: str) -> int:
    """Rejoue la combinaison avec ydotool, une fois le panneau refermé."""
    import subprocess
    import time
    codes = key_codes(keys)
    if not codes:
        return 1
    time.sleep(0.3)
    seq = [f"{c}:1" for c in codes] + [f"{c}:0" for c in reversed(codes)]
    subprocess.run(["ydotool", "key", *seq], check=False)
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--json":
        raise SystemExit(dump_json())
    if len(sys.argv) > 2 and sys.argv[1] == "--press":
        raise SystemExit(press(sys.argv[2]))
    raise SystemExit(ShortcutsApp().run([sys.argv[0]]))
