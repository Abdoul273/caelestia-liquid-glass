[Unit]
Description=Caelestia Liquid Glass : surveille les styles GTK et Qt générés par Caelestia

[Path]
PathChanged=%h/.config/gtk-4.0/gtk.css
PathChanged=%h/.config/gtk-3.0/gtk.css
PathChanged=%h/.config/qtengine/caelestia.colors
Unit=caelestia-glass-gtk.service

[Install]
WantedBy=default.target
