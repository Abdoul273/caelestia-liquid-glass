#!/usr/bin/env bash
# ============================================================================
#  Caelestia Liquid Glass — désinstallation
#  Retire tout ce que ./install a posé et restaure la sauvegarde la plus récente.
#  Les paquets installés sont conservés.
# ============================================================================
set -euo pipefail

DATA_DIR="$HOME/.local/share/caelestia-liquid-glass"

if [[ -t 1 ]]; then
    B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; OK=$'\e[38;5;114m'; WARN=$'\e[38;5;221m'; ERR=$'\e[38;5;203m'
else
    B=; D=; R=; OK=; WARN=; ERR=
fi

backup=$(ls -1d "$DATA_DIR"/backups/*/ 2>/dev/null | sort | tail -1 || true)
backup=${backup%/}
if [[ -z $backup || ! -f $backup/manifest ]]; then
    printf '%s✗ Aucune installation trouvée (%s).%s\n' "$ERR" "${DATA_DIR/#$HOME/~}/backups" "$R" >&2
    exit 1
fi

printf '\n%sDésinstaller Caelestia Liquid Glass ?%s\n' "$B" "$R"
printf '  Sauvegarde restaurée : %s%s%s\n' "$D" "${backup/#$HOME/~}" "$R"
read -r -p "  Continuer ? [o/N] " answer || true
[[ ${answer,,} == o* || ${answer,,} == y* ]] || { echo "  Annulé."; exit 0; }

systemctl --user disable --now bt-audio-autoswitch.service caelestia-glass-gtk.path caelestia-login-sync.path 2>/dev/null || true
if [[ -d /usr/share/plymouth/themes/liquid-glass ]]; then
    echo "  Retrait de l'écran de démarrage (mot de passe demandé)…"
    sudo "$(dirname "${BASH_SOURCE[0]}")/config/plymouth/install-boot-splash" --remove || true
fi
if [[ -d /usr/share/sddm/themes/liquid-glass ]]; then
    echo "  Retrait de l'écran de connexion (mot de passe demandé)…"
    sudo "$(dirname "${BASH_SOURCE[0]}")/config/sddm/install-login-screen" --remove || true
fi

# Retire les fichiers installés, puis remet ceux qui existaient avant
while read -r path; do
    [[ -n $path && $path == "$HOME"/* ]] || continue
    rm -rf "$path"
    rel=${path#"$HOME"/}
    if [[ -e $backup/$rel || -L $backup/$rel ]]; then
        mkdir -p "$(dirname "$path")"
        cp -a "$backup/$rel" "$path"
    fi
done < "$backup/manifest"

# Retire l'import du verre dans le style GTK
for v in gtk-3.0 gtk-4.0; do
    f="$HOME/.config/$v/gtk.css"
    [[ -f $f ]] && sed -i '/@import "liquid-glass.css";/d' "$f"
done

# Thème « verre » des fenêtres Ouvrir / Enregistrer (portail GTK)
rm -f "$HOME/.config/systemd/user/xdg-desktop-portal-gtk.service.d/caelestia-glass.conf"
rmdir "$HOME/.config/systemd/user/xdg-desktop-portal-gtk.service.d" 2>/dev/null || true
rm -rf "$HOME/.local/share/themes/Caelestia-Glass-Portal"

systemctl --user daemon-reload
systemctl --user try-restart xdg-desktop-portal-gtk.service 2>/dev/null || true
mv "$backup" "$backup.restauree"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null || true
    caelestia shell -k >/dev/null 2>&1 || true
    sleep 0.5
    setsid -f caelestia shell -d >/dev/null 2>&1 || true
fi

printf '\n%s✓ Désinstallé : ta configuration d'"'"'avant est restaurée.%s\n\n' "$OK" "$R"
